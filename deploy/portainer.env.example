# GHCR image (GitHub Actions on push, or: .\deploy\build-api-image.ps1 -Push)
SGS_API_IMAGE=ghcr.io/m455yn/sgsclient-api:latest

# Packages on disk (bind mount recommended on the VPS):
# SGS_GAMES_VOLUME=/opt/sgs/games

# SQL Server for SGS catalog (not the NPM MariaDB).
# Production host: db.m455yn.io (from Docker use that DNS name or host.docker.internal if SQL is on the VPS).
SGS_SQL_CONNECTION=Data Source=db.m455yn.io;Initial Catalog=SGS_SGSCLIENT_TEST;User ID=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

# Same SQL host, Realm of Five Winds catalog (old sgs-api ROFWConnection):
SGS_ROFW_SQL_CONNECTION=Data Source=db.m455yn.io;Initial Catalog=SZYRROGI_AUTOBATTLER;User ID=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

# Same SQL host, Reportingo catalog (old sgs-api ReportingoConnectionString):
SGS_REPORTINGO_SQL_CONNECTION=Data Source=db.m455yn.io;Initial Catalog=REPORTINGO;User ID=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

SGS_RETENTION_COUNT=3

# Required: the API refuses to start in Production without Azure AD.
SGS_AZUREAD_ENABLED=true
SGS_AZUREAD_CLIENT_ID=CHANGE_ME
SGS_AZUREAD_TENANT=CHANGE_ME

# Exact login email from client Settings (Admin panel + · admin badge):
SGS_ADMIN_EMAIL=m455yn@outlook.com

# Signs the short-lived achievement tokens handed to running games. 32+ random characters,
# e.g. `openssl rand -base64 48`. Left empty, a random key is used and tokens die on every restart.
SGS_ACHIEVEMENTS_SIGNING_KEY=
