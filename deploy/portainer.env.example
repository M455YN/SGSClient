# GHCR image (GitHub Actions on push, or: .\deploy\build-api-image.ps1 -Push)
SGS_API_IMAGE=ghcr.io/m455yn/sgsclient-api:latest

# Packages on disk (bind mount recommended on the VPS):
# SGS_GAMES_VOLUME=/opt/sgs/games

# SQL Server for SGS catalog (not the NPM MariaDB). Host SQL from Linux Docker:
SGS_SQL_CONNECTION=Data Source=host.docker.internal;Initial Catalog=SGS_SGSCLIENT_TEST;User ID=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

# Same SQL host, Realm of Five Winds catalog (old sgs-api ROFWConnection):
SGS_ROFW_SQL_CONNECTION=Data Source=host.docker.internal;Initial Catalog=SZYRROGI_AUTOBATTLER;User ID=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

# Same SQL host, Reportingo catalog (old sgs-api ReportingoConnectionString):
SGS_REPORTINGO_SQL_CONNECTION=Data Source=host.docker.internal;Initial Catalog=REPORTINGO;User ID=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

SGS_RETENTION_COUNT=3
SGS_AZUREAD_ENABLED=false

# Exact login email from client Settings (Admin panel + · admin badge):
SGS_ADMIN_EMAIL=m455yn@outlook.com
