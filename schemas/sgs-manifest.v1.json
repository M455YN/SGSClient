{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://szyrgamestudio.local/schemas/sgs-manifest.v1.json",
  "title": "SGS Game Package Manifest",
  "description": "Manifest required at the root of every uploaded game ZIP (sgs-manifest.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "game", "build"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Manifest format version. Currently only 1 is accepted."
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "symbol"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "symbol": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable slug used in URLs and storage paths. Lowercase kebab-case."
        },
        "kind": {
          "type": ["string", "null"],
          "enum": ["game", "dlc", null],
          "description": "Catalog kind. Use dlc with parentSymbol for downloadable content."
        },
        "parentSymbol": {
          "type": ["string", "null"],
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Base game symbol required when kind is dlc."
        },
        "description": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "hardwareRequirements": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "otherInformation": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "genre": {
          "type": ["string", "null"],
          "enum": [
            "action", "adventure", "rpg", "strategy", "simulation", "sports", "racing", "puzzle", "horror", "indie",
            "platformer", "shooter", "fps", "tps", "fighting", "stealth", "survival", "sandbox", "open-world",
            "roguelike", "roguelite", "metroidvania", "visual-novel", "card", "turn-based", "mmo", "moba",
            "battle-royale", "tower-defense", "idle", "casual", "party", "rhythm", "educational", "narrative",
            "walking-sim", "vr", "other", null
          ],
          "description": "Catalog genre slug."
        },
        "engine": {
          "type": ["string", "null"],
          "enum": [
            "unity", "unreal", "godot", "cryengine", "gamemaker", "construct", "rpgmaker", "renpy", "defold",
            "monogame", "fna", "stride", "bevy", "libgdx", "love2d", "phaser", "cocos", "solar2d",
            "clickteam-fusion", "source", "source2", "idtech", "frostbite", "creation-engine", "red-engine",
            "anvil", "snowdrop", "o3de", "raylib", "pygame", "sdl", "html5", "roblox", "custom", "other", null
          ],
          "description": "Game engine slug."
        },
        "studioName": {
          "type": ["string", "null"],
          "maxLength": 128,
          "description": "Developer / studio name shown on the store page."
        },
        "websiteUrl": {
          "type": ["string", "null"],
          "maxLength": 2048,
          "description": "http(s) studio or game website."
        },
        "discordUrl": {
          "type": ["string", "null"],
          "maxLength": 2048
        },
        "supportUrl": {
          "type": ["string", "null"],
          "maxLength": 2048
        },
        "releaseStatus": {
          "type": ["string", "null"],
          "enum": ["announced", "earlyAccess", "released", "demo", null],
          "description": "Lifecycle badge on the store page."
        },
        "releaseDate": {
          "type": ["string", "null"],
          "description": "ISO date (YYYY-MM-DD) or DateTimeOffset."
        },
        "ageRating": {
          "type": ["string", "null"],
          "enum": ["unrated", "pegi3", "pegi7", "pegi12", "pegi16", "pegi18", null]
        },
        "features": {
          "type": ["array", "null"],
          "maxItems": 16,
          "items": {
            "type": "string",
            "enum": ["singleplayer", "multiplayer", "coop", "controller", "cloud", "achievements", "modding", "vr"]
          },
          "description": "Store feature checkboxes (Singleplayer, Multiplayer, Co-op, Pad, Cloud, Achievements, Mods, VR)."
        },
        "languages": {
          "type": ["array", "null"],
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "description": "UI languages, e.g. Polski, English."
        },
        "tags": {
          "type": ["array", "null"],
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "description": "Free-form tags, e.g. roguelike, pixel art."
        },
        "media": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "Optional store media. Paths are relative inside the ZIP (forward slashes).",
          "properties": {
            "cover": {
              "type": ["string", "null"],
              "minLength": 1,
              "maxLength": 260,
              "description": "List thumbnail, portrait or square (.png, .jpg, .jpeg, .webp, .gif)."
            },
            "header": {
              "type": ["string", "null"],
              "minLength": 1,
              "maxLength": 260,
              "description": "Landscape Steam-style store header (.png, .jpg, .jpeg, .webp, .gif)."
            },
            "logo": {
              "type": ["string", "null"],
              "minLength": 1,
              "maxLength": 260,
              "description": "Square game logo, e.g. 512x512 (.png, .jpg, .jpeg, .webp, .gif)."
            },
            "intro": {
              "type": ["string", "null"],
              "minLength": 1,
              "maxLength": 260,
              "description": "Intro/trailer video (.mp4, .webm)."
            },
            "screenshots": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 260
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "platform", "executable"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "description": "SemVer-like version, e.g. 1.0.0 or 1.0.0-beta.1"
        },
        "platform": {
          "type": "string",
          "enum": ["windows", "linux", "macos"]
        },
        "architecture": {
          "type": ["string", "null"],
          "enum": ["x64", "x86", "arm64", null],
          "default": "x64"
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "description": "Relative path inside the ZIP to the launch file (forward slashes). Must exist after unpack."
        },
        "isDefault": {
          "type": "boolean",
          "default": true,
          "description": "Whether this build is the default for its platform."
        },
        "releaseNotes": {
          "type": ["string", "null"],
          "maxLength": 4000,
          "description": "Changelog for this version."
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional packing hints for the SGSClient packer. Server ignores unknown globs but enforces global limits.",
      "properties": {
        "include": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 260 }
        },
        "exclude": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 260 }
        }
      }
    }
  }
}
