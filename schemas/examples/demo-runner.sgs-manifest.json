  "achievements": [
    {
      "key": "first_run",
      "title": "Pierwszy bieg",
      "description": "Ukończ pierwszy poziom.",
      "points": 10,
      "translations": { "en": { "title": "First run", "description": "Finish the first level." } }
    },
    {
      "key": "marathon",
      "title": "Maratończyk",
      "description": "Przebiegnij łącznie 100 kilometrów.",
      "points": 50,
      "target": 100,
      "translations": { "en": { "title": "Marathon runner", "description": "Run 100 kilometres in total." } }
    },
    {
      "key": "secret_door",
      "title": "Ukryte przejście",
      "description": "Znajdź sekretne drzwi na poziomie 3.",
      "points": 25,
      "hidden": true
    }
  ],
  "package": {
    "include": [
      "bin/**",
      "data/**",
      "media/**",
      "sgs-manifest.json"
    ],
    "exclude": [
      "**/*.pdb",
      "**/*.obj",
      "**/obj/**",
      "**/.git/**",
      "**/node_modules/**"
    ]
