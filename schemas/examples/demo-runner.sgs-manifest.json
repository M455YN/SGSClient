{
  "schemaVersion": 1,
  "game": {
    "title": "Demo Runner",
    "symbol": "demo-runner",
    "description": "Sample catalog game for local development.",
    "hardwareRequirements": "RAM: 4 GB",
    "otherInformation": null,
    "genre": "action",
    "engine": "custom",
    "studioName": "SGS Demo Studio",
    "websiteUrl": "https://example.com",
    "discordUrl": "https://discord.gg/example",
    "supportUrl": "https://example.com/support",
    "releaseStatus": "released",
    "releaseDate": "2024-01-01",
    "ageRating": "pegi3",
    "features": ["singleplayer", "controller"],
    "languages": ["Polski", "English"],
    "tags": ["demo", "sample"],
    "media": {
      "cover": "media/cover.png",
      "header": "media/header.png",
      "intro": "media/intro.mp4",
      "screenshots": [
        "media/screen-01.png",
        "media/screen-02.png"
      ]
    }
  },
  "build": {
    "version": "0.1.0",
    "platform": "windows",
    "architecture": "x64",
    "executable": "bin/DemoRunner.exe",
