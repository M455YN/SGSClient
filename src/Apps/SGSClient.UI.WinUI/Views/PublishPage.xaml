<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.PublishPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel Margin="28,24,28,32" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Tr Key='Wybierz folder gry z sgs-manifest.json, popraw dane w formularzu i wyślij do sklepu. Zmiany zapiszą się też w manifeście.'}"
                   Opacity="0.65" TextWrapping="Wrap" />
        <TextBlock x:Name="AuthHintText" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:Tr Key='1. Folder gry'}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="FolderText" Opacity="0.8" TextWrapping="Wrap" />
          <Button x:Name="PickFolderButton" Content="{loc:Tr Key='Wybierz folder…'}" Click="PickFolder_Click"
                  Padding="14,8" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border x:Name="FormBorder" Padding="18" CornerRadius="10" Background="#1AFFFFFF"
              BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="Collapsed">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:Tr Key='2. Dane gry w sklepie'}" FontSize="18" FontWeight="SemiBold" />

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Typ treści'}" Opacity="0.55" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <RadioButton x:Name="KindGameRadio" Content="{loc:Tr Key='Gra'}" GroupName="ContentKind"
                           Checked="ContentKind_Changed" />
              <RadioButton x:Name="KindDlcRadio" Content="DLC" GroupName="ContentKind"
                           Checked="ContentKind_Changed" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="ParentSymbolPanel" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="{loc:Tr Key='Symbol gry bazowej'}" Opacity="0.55" FontSize="12" />
            <ComboBox x:Name="ParentSymbolCombo" IsEditable="True" HorizontalAlignment="Stretch"
                      PlaceholderText="{loc:Tr Key='np. demo-runner'}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Nazwa'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="GameTitleBox" PlaceholderText="{loc:Tr Key='np. Demo Runner'}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Symbol (małe litery i myślniki)'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="GameSymbolBox" PlaceholderText="{loc:Tr Key='np. demo-runner'}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Opis'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="GameDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="88" PlaceholderText="{loc:Tr Key='Krótki opis widoczny w sklepie'}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Wymagania sprzętowe'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="HardwareBox" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="56" PlaceholderText="{loc:Tr Key='opcjonalnie'}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Inne informacje'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="OtherInfoBox" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="56" PlaceholderText="{loc:Tr Key='opcjonalnie'}" />
          </StackPanel>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{loc:Tr Key='Gatunki'}" Opacity="0.55" FontSize="12" />
              <Expander Header="{x:Bind ViewModel.GameGenres.Summary, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="220">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.GameGenres.Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Expander>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{loc:Tr Key='Silniki'}" Opacity="0.55" FontSize="12" />
              <Expander Header="{x:Bind ViewModel.GameEngines.Summary, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="220">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.GameEngines.Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Expander>
            </StackPanel>
          </Grid>

          <TextBlock Text="{loc:Tr Key='Media (opcjonalne)'}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Text="{loc:Tr Key='Wybierz pliki z dysku — skopiujemy je do folderu media/ w grze. Możesz też zostawić puste.'}"
                     Opacity="0.5" FontSize="12" TextWrapping="Wrap" />

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Miniaturka'}" Opacity="0.55" FontSize="12" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="CoverBox" Grid.Column="0" PlaceholderText="media/cover.png" IsReadOnly="True" />
              <Button Grid.Column="1" Content="{loc:Tr Key='Wybierz…'}" Click="PickCover_Click" Padding="12,8" />
              <Button Grid.Column="2" Content="{loc:Tr Key='Wyczyść'}" Click="ClearCover_Click" Padding="12,8" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Okładka pozioma (920 × 430)'}" Opacity="0.55" FontSize="12" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="HeaderBox" Grid.Column="0" PlaceholderText="media/header.png" IsReadOnly="True" />
              <Button Grid.Column="1" Content="{loc:Tr Key='Wybierz…'}" Click="PickHeader_Click" Padding="12,8" />
              <Button Grid.Column="2" Content="{loc:Tr Key='Wyczyść'}" Click="ClearHeader_Click" Padding="12,8" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Logo (kwadratowe)'}" Opacity="0.55" FontSize="12" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="LogoBox" Grid.Column="0" PlaceholderText="media/logo.png" IsReadOnly="True" />
              <Button Grid.Column="1" Content="{loc:Tr Key='Wybierz…'}" Click="PickLogo_Click" Padding="12,8" />
              <Button Grid.Column="2" Content="{loc:Tr Key='Wyczyść'}" Click="ClearLogo_Click" Padding="12,8" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Intro / trailer" Opacity="0.55" FontSize="12" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="IntroBox" Grid.Column="0" PlaceholderText="media/intro.mp4" IsReadOnly="True" />
              <Button Grid.Column="1" Content="{loc:Tr Key='Wybierz…'}" Click="PickIntro_Click" Padding="12,8" />
              <Button Grid.Column="2" Content="{loc:Tr Key='Wyczyść'}" Click="ClearIntro_Click" Padding="12,8" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Screeny'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="ScreenshotsBox" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="72" IsReadOnly="True" PlaceholderText="{loc:Tr Key='Brak — kliknij Dodaj…'}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Tr Key='Dodaj…'}" Click="PickScreenshots_Click" Padding="12,8" />
              <Button Content="{loc:Tr Key='Wyczyść listę'}" Click="ClearScreenshots_Click" Padding="12,8" />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="Build" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{loc:Tr Key='Wersja'}" Opacity="0.55" FontSize="12" />
              <TextBox x:Name="VersionBox" PlaceholderText="1.0.0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{loc:Tr Key='Plik uruchomieniowy'}" Opacity="0.55" FontSize="12" />
              <TextBox x:Name="ExecutableBox" PlaceholderText="bin/Game.exe" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Opis zmian (changelog)'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="ReleaseNotesBox" PlaceholderText="{loc:Tr Key='Co nowego w tej wersji'}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
          </StackPanel>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{loc:Tr Key='Platforma'}" Opacity="0.55" FontSize="12" />
              <ComboBox x:Name="PlatformCombo" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{loc:Tr Key='Architektura'}" Opacity="0.55" FontSize="12" />
              <ComboBox x:Name="ArchitectureCombo" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>

          <Button x:Name="PrepareButton" Content="{loc:Tr Key='Przygotuj paczkę'}" Click="Prepare_Click"
                  Padding="14,8" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border x:Name="SummaryBorder" Padding="18" CornerRadius="10" Background="#1AFFFFFF"
              BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="Collapsed">
        <StackPanel Spacing="12">
          <TextBlock Text="{loc:Tr Key='3. Publikacja'}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="SummaryTitleText" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="SummaryMetaText" Opacity="0.7" TextWrapping="Wrap" />
          <Button x:Name="PublishButton" Content="{loc:Tr Key='Opublikuj w sklepie'}" Click="Publish_Click"
                  Padding="18,12" Background="#2E7D32" Foreground="White" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock Text="{loc:Tr Key='Wysyłanie…'}" Opacity="0.7" />
        <ProgressBar x:Name="UploadProgress" Minimum="0" Maximum="1" Height="8" />
      </StackPanel>

      <TextBlock x:Name="StatusText" Opacity="0.75" TextWrapping="Wrap" />
      <ItemsControl x:Name="IssuesList" />
    </StackPanel>
  </ScrollViewer>
</Page>
