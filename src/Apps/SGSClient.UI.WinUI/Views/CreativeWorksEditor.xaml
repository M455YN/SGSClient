<UserControl
    x:Class="SGSClient.UI.WinUI.Views.CreativeWorksEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    xmlns:vm="using:SGSClient.UI.ViewModels"
    xmlns:local="using:SGSClient.UI.WinUI.Views">

  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="BoolToVisInv" />

    <Style x:Key="WorksCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Resources>

  <Grid ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource WorksCard}" Padding="0" Margin="0,0,0,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <AutoSuggestBox Margin="12,12,12,8" QueryIcon="Find"
                        PlaceholderText="{loc:Tr Key='Szukaj po tytule lub autorze'}"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
        <ListView Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  SelectionMode="Single">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="8,6" />
              <Setter Property="MinHeight" Value="64" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:CreativeWorkRow">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <Grid>
                    <TextBlock Text="{x:Bind TileLabel}" FontWeight="SemiBold" FontSize="12" Opacity="0.55"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{x:Bind HasThumb, Converter={StaticResource BoolToVisInv}}" />
                    <Image Source="{Binding ThumbUrl}" Stretch="UniformToFill"
                           Visibility="{x:Bind HasThumb, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind MetaText}" Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" Margin="12,8,12,12" Text="{Binding StatusText}" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" Margin="0,0,0,16" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource WorksCard}" MaxWidth="820" HorizontalAlignment="Left">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Tytuł'}" Opacity="0.55" FontSize="12" />
            <TextBox Text="{Binding EditTitle, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Opis'}" Opacity="0.55" FontSize="12" />
            <TextBox Text="{Binding EditDescription, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Tagi (oddzielone przecinkami)'}" Opacity="0.55" FontSize="12" />
            <TextBox Text="{Binding EditTags, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Spacing="4" Visibility="{Binding HasCoverEditor, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{loc:Tr Key='Okładka'}" Opacity="0.55" FontSize="12" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding CoverPath, Mode=OneWay}" IsReadOnly="True" PlaceholderText="{loc:Tr Key='Bez zmiany okładki'}" />
              <Button Grid.Column="1" Content="{loc:Tr Key='Zmień okładkę…'}" Command="{Binding PickCoverCommand}" Padding="12,8" />
            </Grid>
          </StackPanel>

          <Grid ColumnSpacing="12" Visibility="{Binding IsStories, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Tr Key='Rozdziały'}" FontWeight="SemiBold" />
              <ListView ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter, Mode=TwoWay}"
                        MaxHeight="320" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Padding="4,6" />
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <Button Content="{loc:Tr Key='+ Dodaj rozdział'}" Command="{Binding AddChapterCommand}" HorizontalAlignment="Stretch" />
              <Button Content="{loc:Tr Key='Usuń rozdział'}" Command="{Binding RemoveChapterCommand}"
                      CommandParameter="{Binding SelectedChapter}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="{loc:Tr Key='Tytuł rozdziału'}" Opacity="0.55" FontSize="12" />
              <TextBox Text="{Binding SelectedChapter.Title, Mode=TwoWay}" />
              <TextBlock Text="{loc:Tr Key='Treść rozdziału'}" Opacity="0.55" FontSize="12" />
              <TextBox Text="{Binding SelectedChapter.Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Tr Key='Zapisz zmiany'}" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" Padding="18,8" />
            <Button Content="{loc:Tr Key='Usuń'}" Command="{Binding DeleteCommand}" Padding="18,8" />
            <ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#EF9A9A" TextWrapping="Wrap" Margin="0,0,0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <TextBlock Grid.Column="1" Text="{loc:Tr Key='Wybierz pozycję z listy'}" HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInv}}" />
  </Grid>
</UserControl>
