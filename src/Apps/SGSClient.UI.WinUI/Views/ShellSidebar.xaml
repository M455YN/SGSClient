<UserControl
    x:Class="SGSClient.UI.WinUI.Views.ShellSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SGSClient.UI.WinUI.ViewModels">

  <UserControl.Resources>
    <Style x:Key="NavButtonStyle" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="RootGrid" Width="280" Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="TopChrome" Grid.Row="0" Margin="4,8,4,4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Button x:Name="PaneToggleButton"
              Grid.Row="0"
              Click="PaneToggle_Click"
              Style="{StaticResource NavButtonStyle}"
              ToolTipService.ToolTip="Zwiń / rozwiń nawigację"
              HorizontalContentAlignment="Center"
              Margin="0,0,0,4">
        <FontIcon x:Name="PaneToggleIcon" Glyph="&#xE700;" FontSize="16" />
      </Button>

      <Button x:Name="ProfileButton"
              Grid.Row="1"
              Click="Profile_Click"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              VerticalContentAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              Padding="8,8"
              MinHeight="48"
              CornerRadius="4"
              ToolTipService.ToolTip="Profil">
        <Grid x:Name="ProfileContentGrid" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="AvatarColumn" Width="Auto" />
            <ColumnDefinition x:Name="DetailsColumn" Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="AvatarHost" Width="32" Height="32" CornerRadius="16"
                  HorizontalAlignment="Center"
                  Background="{ThemeResource AccentFillColorDefaultBrush}">
            <Grid>
              <FontIcon x:Name="ProfilePlaceholder" Glyph="&#xE77B;" FontSize="14"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
              <PersonPicture x:Name="AvatarPicture" Width="32" Height="32" Visibility="Collapsed" />
            </Grid>
          </Border>
          <StackPanel x:Name="ProfileDetails" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="ProfileNameText" FontWeight="SemiBold" FontSize="13"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ProfileStatusText" FontSize="11" Opacity="0.65"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Button>
    </Grid>

    <Grid Grid.Row="1" Margin="4,0,4,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel x:Name="NavPanel" Spacing="2">
        <Button x:Name="NavHome" Tag="Home" Click="Nav_Click" Style="{StaticResource NavButtonStyle}"
                ToolTipService.ToolTip="Home">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE80F;" FontSize="16" />
            <TextBlock x:Name="NavHomeLabel" Text="Home" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="NavGames" Tag="Games" Click="Nav_Click" Style="{StaticResource NavButtonStyle}"
                ToolTipService.ToolTip="Sklep">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE719;" FontSize="16" />
            <TextBlock x:Name="NavGamesLabel" Text="Sklep" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="NavLibrary" Tag="Library" Click="Nav_Click" Style="{StaticResource NavButtonStyle}"
                ToolTipService.ToolTip="Biblioteka">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE8F1;" FontSize="16" />
            <TextBlock x:Name="NavLibraryLabel" Text="Biblioteka" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="NavPublish" Tag="Publish" Click="Nav_Click" Style="{StaticResource NavButtonStyle}"
                Visibility="Collapsed" ToolTipService.ToolTip="Publikuj">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE898;" FontSize="16" />
            <TextBlock x:Name="NavPublishLabel" Text="Publikuj" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="NavStudio" Tag="Studio" Click="Nav_Click" Style="{StaticResource NavButtonStyle}"
                ToolTipService.ToolTip="Panel twórcy">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE7C3;" FontSize="16" />
            <TextBlock x:Name="NavStudioLabel" Text="Panel twórcy" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="NavAdmin" Tag="Admin" Click="Nav_Click" Style="{StaticResource NavButtonStyle}"
                Visibility="Collapsed" ToolTipService.ToolTip="Admin">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE7EF;" FontSize="16" />
            <TextBlock x:Name="NavAdminLabel" Text="Admin" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <Grid x:Name="InstalledSection" Grid.Row="1" Margin="4,8,4,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="InstalledHeaderText"
                   Margin="8,0,8,8"
                   FontSize="11"
                   FontWeight="SemiBold"
                   CharacterSpacing="40"
                   Opacity="0.55"
                   Text="0 ZAINSTALOWANYCH" />
        <ListView x:Name="InstalledList"
                  Grid.Row="1"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Installed_ItemClick"
                  Background="Transparent">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="4" />
              <Setter Property="MinHeight" Value="52" />
              <Setter Property="Margin" Value="0,1" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:SidebarInstalledGame">
              <Grid ColumnSpacing="10" Padding="4,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid>
                    <TextBlock Text="{x:Bind TileLabel}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="10" FontWeight="SemiBold" Opacity="0.7" />
                    <Image Width="36" Height="36" Stretch="UniformToFill"
                           Source="{x:Bind CoverImage}"
                           Visibility="{x:Bind HasCover}" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <TextBlock Text="{x:Bind StateText}" FontSize="11" Opacity="0.55"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center">
                  <Button FontFamily="Segoe Fluent Icons" Content="&#xE768;"
                          Tag="{x:Bind}" Click="Play_Click" Padding="8"
                          ToolTipService.ToolTip="Uruchom"
                          IsEnabled="{x:Bind CanLaunch}" />
                  <Button FontFamily="Segoe Fluent Icons" Content="&#xE712;"
                          Tag="{x:Bind}" Click="More_Click" Padding="8"
                          ToolTipService.ToolTip="Więcej">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuFlyoutItem Text="Szczegóły" Tag="{x:Bind}" Click="DetailsMenu_Click" />
                        <MenuFlyoutItem Text="Właściwości" Tag="{x:Bind}" Click="PropertiesMenu_Click" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>

    <Button x:Name="NavSettings" Tag="Settings" Click="Nav_Click"
            Grid.Row="2"
            Style="{StaticResource NavButtonStyle}"
            Margin="4,4,4,8"
            ToolTipService.ToolTip="Ustawienia">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xE713;" FontSize="16" />
        <TextBlock x:Name="NavSettingsLabel" Text="Ustawienia" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
