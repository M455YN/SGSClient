<UserControl xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.CreativeMusicSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="SearchBox" PlaceholderText="{loc:Tr Key='Szukaj utworów…'}" KeyDown="SearchBox_KeyDown" />
    <TextBlock x:Name="StatusText" Grid.Row="1" Opacity="0.75" TextWrapping="Wrap" />

    <ScrollViewer Grid.Row="2">
      <ItemsControl x:Name="ItemsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Padding="0,6" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="56" Height="56" CornerRadius="4" Background="#2A2A2A">
                <Grid>
                  <TextBlock Text="{Binding TileLabel}" FontWeight="Bold" FontSize="14" Opacity="0.4"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Loaded="Cover_Loaded" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Author}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Content="{loc:Tr Key='Graj'}" VerticalAlignment="Center" Click="Play_Click" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="3" Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="NowPlayingTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="NowPlayingAuthor" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" StepFrequency="1" VerticalAlignment="Center" ValueChanged="Seek_ValueChanged" />
          <TextBlock x:Name="TimeText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Text="0:00 / 0:00" />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="PlayPauseButton" Click="PlayPause_Click">
            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="14" />
          </Button>
          <Button Click="Next_Click" ToolTipService.ToolTip="{loc:Tr Key='Następny'}">
            <FontIcon Glyph="&#xE893;" FontSize="14" />
          </Button>
        </StackPanel>

        <Slider x:Name="VolumeSlider" Grid.Column="3" Minimum="0" Maximum="100" Value="100"
                VerticalAlignment="Center" ToolTipService.ToolTip="{loc:Tr Key='Głośność'}" ValueChanged="Volume_ValueChanged" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
