<UserControl xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.CreativeMusicSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SGSClient.UI.WinUI.Views">

  <Grid RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="SearchBox" PlaceholderText="{loc:Tr Key='Szukaj utworów…'}" KeyDown="SearchBox_KeyDown" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <ProgressRing x:Name="BusyRing" Width="20" Height="20" />
      <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                 VerticalAlignment="Center" />
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <ItemsControl x:Name="ItemsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Padding="0,6" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="56" Height="56" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                  <TextBlock Text="{Binding TileLabel}" Style="{StaticResource BodyStrongTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Loaded="Cover_Loaded" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Author}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Style="{StaticResource SubtleButtonStyle}" Click="Comments_Click"
                        AutomationProperties.Name="{loc:Tr Key='Komentarze'}" ToolTipService.ToolTip="{loc:Tr Key='Komentarze'}">
                  <FontIcon Glyph="&#xE90A;" FontSize="16" />
                </Button>
                <Button Click="Play_Click" AutomationProperties.Name="{loc:Tr Key='Graj'}"
                        ToolTipService.ToolTip="{loc:Tr Key='Graj'}">
                  <FontIcon Glyph="&#xE768;" FontSize="14" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Comments of the track chosen with the comment button on its row -->
    <Border x:Name="CommentsPanel" Grid.Row="3" Visibility="Collapsed" Padding="16" CornerRadius="8" MaxHeight="360"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <ScrollViewer>
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CommentsTrackTitle" Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Click="CloseComments_Click"
                    AutomationProperties.Name="{loc:Tr Key='Ukryj komentarze'}"
                    ToolTipService.ToolTip="{loc:Tr Key='Ukryj komentarze'}">
              <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
          </Grid>
          <local:CreativeComments x:Name="CommentsControl" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="4" Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="NowPlayingTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="NowPlayingAuthor" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" StepFrequency="1" VerticalAlignment="Center" ValueChanged="Seek_ValueChanged" />
          <TextBlock x:Name="TimeText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0:00 / 0:00" />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Style="{StaticResource AccentButtonStyle}"
                  AutomationProperties.Name="{loc:Tr Key='Graj'}">
            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="14" />
          </Button>
          <Button Click="Next_Click" ToolTipService.ToolTip="{loc:Tr Key='Następny'}"
                  AutomationProperties.Name="{loc:Tr Key='Następny'}">
            <FontIcon Glyph="&#xE893;" FontSize="14" />
          </Button>
        </StackPanel>

        <Slider x:Name="VolumeSlider" Grid.Column="3" Minimum="0" Maximum="100" Value="100"
                VerticalAlignment="Center" ToolTipService.ToolTip="{loc:Tr Key='Głośność'}"
                AutomationProperties.Name="{loc:Tr Key='Głośność'}" ValueChanged="Volume_ValueChanged" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
