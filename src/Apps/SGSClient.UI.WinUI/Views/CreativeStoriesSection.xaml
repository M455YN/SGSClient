<UserControl xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    xmlns:local="using:SGSClient.UI.WinUI.Views"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    x:Class="SGSClient.UI.WinUI.Views.CreativeStoriesSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

    <DataTemplate x:Key="StoryCardTemplate">
      <Button Click="Card_Click" Padding="0" Margin="0,0,16,16" Width="168" Height="300"
              VerticalAlignment="Top" CornerRadius="8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
        <StackPanel Spacing="4">
          <Grid Height="150" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock Text="{Binding TileLabel}" FontSize="28" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}" />
            <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"
                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
          </Grid>
          <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                     MaxLines="2" TextTrimming="CharacterEllipsis" Margin="8,4,8,0" />
          <TextBlock Text="{Binding Author}" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                     Margin="8,0" />
          <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                     MaxLines="3" TextTrimming="CharacterEllipsis" Margin="8,0" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- Browse: search, status and the card grid -->
    <ScrollViewer x:Name="BrowsePanel">
      <StackPanel Spacing="16" Margin="0,0,0,8">
        <TextBox x:Name="SearchBox" PlaceholderText="{loc:Tr Key='Szukaj opowiadań…'}"
                 MaxWidth="420" HorizontalAlignment="Left" KeyDown="SearchBox_KeyDown" />
        <ProgressRing x:Name="BusyRing" Width="32" Height="32" HorizontalAlignment="Left" />
        <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <controls:ItemsRepeater x:Name="ItemsList" ItemTemplate="{StaticResource StoryCardTemplate}">
          <controls:ItemsRepeater.Layout>
            <controls:UniformGridLayout MinItemWidth="184" MinItemHeight="316"
                                        MinRowSpacing="0" MinColumnSpacing="0" />
          </controls:ItemsRepeater.Layout>
        </controls:ItemsRepeater>
      </StackPanel>
    </ScrollViewer>

    <!-- Reader: back button, chapter picker and the chapter text -->
    <Grid x:Name="ReaderPanel" Visibility="Collapsed" Margin="0,0,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Spacing="10" MaxWidth="720" HorizontalAlignment="Left">
        <Button Click="Back_Click" AutomationProperties.Name="{loc:Tr Key='← Wróć'}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72B;" FontSize="14" />
            <TextBlock Text="{loc:Tr Key='Wróć'}" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="ReaderTitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                  MaxWidth="720" HorizontalAlignment="Left">
        <Button x:Name="PrevButton" Content="{loc:Tr Key='Poprzedni rozdział'}" Click="Prev_Click" />
        <ComboBox x:Name="ChapterPicker" MinWidth="260" VerticalAlignment="Center"
                  SelectionChanged="ChapterPicker_SelectionChanged" />
        <Button x:Name="NextButton" Content="{loc:Tr Key='Następny rozdział'}" Click="Next_Click" />
      </StackPanel>

      <TextBlock x:Name="ReaderStatusText" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                 MaxWidth="720" HorizontalAlignment="Left" Margin="0,12,0,0" />

      <ScrollViewer x:Name="ReaderScroll" Grid.Row="3" Margin="0,12,0,0">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="24" Margin="0,0,18,24">
          <TextBlock x:Name="ChapterTextBlock" FontSize="17" LineHeight="28" TextWrapping="Wrap"
                     IsTextSelectionEnabled="True" />
          <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <local:CreativeComments x:Name="CommentsControl" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
