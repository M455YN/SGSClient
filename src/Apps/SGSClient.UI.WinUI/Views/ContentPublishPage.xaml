<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.ContentPublishPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel Margin="28,24,28,32" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Tr Key='Wybierz pliki i uzupełnij dane. Paczka i manifest powstaną automatycznie.'}"
                   Opacity="0.65" TextWrapping="Wrap" />
        <TextBlock x:Name="AuthHintText" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Typ treści'}" Opacity="0.55" FontSize="12" />
            <StackPanel x:Name="KindPanel" Orientation="Horizontal" Spacing="16">
              <RadioButton Tag="book" Content="{loc:Tr Key='Książka'}" GroupName="ContentKind" Checked="Kind_Checked" />
              <RadioButton Tag="music" Content="{loc:Tr Key='Muzyka'}" GroupName="ContentKind" Checked="Kind_Checked" />
              <RadioButton Tag="art" Content="{loc:Tr Key='Grafika'}" GroupName="ContentKind" Checked="Kind_Checked" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Nazwa'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="TitleBox" TextChanged="Form_Changed" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Symbol (małe litery i myślniki)'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="SymbolBox" TextChanged="Form_Changed" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Opis'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                     TextChanged="Form_Changed" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Wersja'}" Opacity="0.55" FontSize="12" />
            <TextBox x:Name="VersionBox" TextChanged="Form_Changed" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Key='Pliki'}" Opacity="0.55" FontSize="12" />
            <TextBlock x:Name="FilesText" Opacity="0.8" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Tr Key='Wybierz pliki…'}" Click="PickFiles_Click" Padding="14,8" />
              <Button Content="{loc:Tr Key='Wyczyść'}" Click="ClearFiles_Click" Padding="14,8" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Key='Okładka (opcjonalnie)'}" Opacity="0.55" FontSize="12" />
            <TextBlock x:Name="CoverText" Opacity="0.8" TextWrapping="Wrap" />
            <Button Content="{loc:Tr Key='Wybierz okładkę…'}" Click="PickCover_Click" Padding="14,8" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Button x:Name="PublishButton" Content="{loc:Tr Key='Opublikuj w sklepie'}" Click="Publish_Click"
              Padding="18,12" Background="#2E7D32" Foreground="White" HorizontalAlignment="Left" />

      <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock Text="{loc:Tr Key='Wysyłanie…'}" Opacity="0.7" />
        <ProgressBar x:Name="UploadProgress" Minimum="0" Maximum="1" Height="8" />
      </StackPanel>

      <TextBlock x:Name="StatusText" Opacity="0.75" TextWrapping="Wrap" />
      <ItemsControl x:Name="IssuesList" />
    </StackPanel>
  </ScrollViewer>
</Page>
