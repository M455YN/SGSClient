<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.CreativePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SGSClient.UI.WinUI.Views">

  <Grid Margin="28,24,28,0" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="12">
      <TextBlock Text="{loc:Tr Key='Twórczość'}" Style="{StaticResource TitleTextBlockStyle}" />
      <StackPanel x:Name="SectionPanel" Orientation="Horizontal" Spacing="8">
        <RadioButton Tag="Art" Content="{loc:Tr Key='Grafika'}" GroupName="CreativeSection" Checked="Section_Checked" />
        <RadioButton Tag="Music" Content="{loc:Tr Key='Muzyka'}" GroupName="CreativeSection" Checked="Section_Checked" />
        <RadioButton Tag="Stories" Content="{loc:Tr Key='Opowiadania'}" GroupName="CreativeSection" Checked="Section_Checked" />
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="1">
      <local:CreativeArtSection x:Name="ArtSection" />
      <local:CreativeMusicSection x:Name="MusicSection" Visibility="Collapsed" />
      <local:CreativeStoriesSection x:Name="StoriesSection" Visibility="Collapsed" />
    </Grid>
  </Grid>
</Page>
