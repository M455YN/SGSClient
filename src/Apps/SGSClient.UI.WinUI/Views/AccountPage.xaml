<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SGSClient.UI.ViewModels"
    xmlns:local="using:SGSClient.UI.WinUI.Views">

  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="BoolToVisInv" />
  </Page.Resources>

  <Grid>
    <StackPanel x:Name="SignedOutPanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12"
                MaxWidth="480"
                Margin="32">
      <TextBlock Text="{loc:Tr Key='Profil'}" FontSize="32" FontWeight="SemiBold" />
      <TextBlock x:Name="SignedOutStatus" Opacity="0.75" TextWrapping="Wrap" />
      <Button Content="{loc:Tr Key='Zaloguj się'}" Click="SignIn_Click" HorizontalAlignment="Left" Padding="16,8" />
    </StackPanel>

    <StackPanel x:Name="TagSetupPanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12"
                MaxWidth="480"
                Margin="32"
                Visibility="Collapsed">
      <TextBlock Text="{loc:Tr Key='Wybierz tag gracza'}" FontSize="32" FontWeight="SemiBold" />
      <TextBlock Text="{loc:Tr Key='Twój unikalny identyfikator w SGS. Inni znajdą Cię po @tagu.'}"
                 Opacity="0.75" TextWrapping="Wrap" />
      <TextBlock x:Name="TagPreviewText" FontSize="22" FontWeight="SemiBold" Opacity="0.9" />
      <TextBox x:Name="DraftTagBox" PlaceholderText="np. m455yn" MinHeight="40"
               TextChanged="DraftTag_TextChanged" />
      <TextBlock x:Name="TagStatusText" Opacity="0.7" TextWrapping="Wrap" FontSize="13" />
      <Button Content="{loc:Tr Key='Zapisz tag'}" Click="ClaimTag_Click" HorizontalAlignment="Left" Padding="16,8" />
    </StackPanel>

    <ScrollViewer x:Name="ProfileScroll" Visibility="Collapsed">
      <Grid>
        <Border Height="360" VerticalAlignment="Top" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Color="#331A3A5C" Offset="0" />
              <GradientStop Color="#1A243848" Offset="0.45" />
              <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <Grid Padding="28" ColumnSpacing="28">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Spacing="20">
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="96" Height="96" CornerRadius="48"
                      Background="#2A2A2A" BorderBrush="#55FFFFFF" BorderThickness="2">
                <Grid>
                  <TextBlock x:Name="AvatarInitialsText"
                             FontSize="32" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Ellipse Width="96" Height="96">
                    <Ellipse.Fill>
                      <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                  </Ellipse>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="DisplayNameText" FontSize="34" FontWeight="Bold" />
                <TextBlock x:Name="PlayerTagText" Opacity="0.75" FontSize="16" />
                <TextBlock x:Name="LastActivityText" Opacity="0.7" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,8,0,0">
                  <Button x:Name="FriendsText" Click="OpenFriends_Click" Tag="Friends"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalAlignment="Left" />
                  <Button x:Name="FollowingText" Click="OpenFriends_Click" Tag="Following"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalAlignment="Left" />
                  <Button x:Name="FollowersText" Click="OpenFriends_Click" Tag="Followers"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <StackPanel x:Name="ProfileInfoPanel" Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Key='Biografia'}" FontWeight="SemiBold" Opacity="0.55" FontSize="12" />
                <TextBlock x:Name="BioText" TextWrapping="Wrap" Opacity="0.9" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Key='Lokalizacja'}" FontWeight="SemiBold" Opacity="0.55" FontSize="12" />
                <TextBlock x:Name="LocationText" />
              </StackPanel>
              <TextBlock x:Name="EmailText" Opacity="0.55" FontSize="12" />
            </StackPanel>

            <StackPanel Spacing="10" Margin="0,8,0,0">
              <TextBlock Text="{loc:Tr Key='Ściana'}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Znajomi mogą zostawić tu podpis." Opacity="0.55" FontSize="12" />
              <TextBox x:Name="WallCommentBox" PlaceholderText="{loc:Tr Key='Napisz coś na swojej ścianie…'}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                       TextChanged="WallCommentBox_TextChanged" />
              <Button Content="{loc:Tr Key='Dodaj podpis'}" HorizontalAlignment="Left" Padding="12,8"
                      Click="PostWall_Click" />
              <TextBlock x:Name="WallStatusText" Opacity="0.6" FontSize="12" />
              <ItemsControl x:Name="WallCommentsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileCommentItem">
                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                            Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding AuthorLabel}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding WhenText}" FontSize="11" Opacity="0.55" />
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:Tr Key='Usuń'}" Padding="8,4" Tag="{Binding}"
                                Click="DeleteWall_Click" VerticalAlignment="Top"
                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="10" Margin="0,8,0,0">
              <TextBlock Text="{loc:Tr Key='Biblioteka'}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{loc:Tr Key='Osiągnięcia i postęp gier pojawią się tutaj.'}" Opacity="0.55" FontSize="13" />
              <ItemsControl x:Name="LibraryList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,10" ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="48" Height="48" CornerRadius="4" Background="#333">
                        <Grid>
                          <TextBlock Text="{Binding TileLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontWeight="SemiBold" FontSize="12"
                                     Visibility="{Binding HasCover, Converter={StaticResource BoolToVisInv}}" />
                          <Image Stretch="UniformToFill" Source="{Binding CoverImageUrl}"
                                 Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" Opacity="0.55" FontSize="12" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="{loc:Tr Key='Osiągnięcia'}" Tag="{Binding}"
                              Click="OpenLibraryAchievements_Click" VerticalAlignment="Center" Padding="10,4" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="RightRail" Grid.Column="1" Spacing="16">
            <Button x:Name="EditButton" Content="{loc:Tr Key='Dostosuj profil'}" HorizontalAlignment="Stretch"
                    Padding="12,10" Click="Edit_Click" />
            <Button Content="{loc:Tr Key='Znajomi'}" HorizontalAlignment="Stretch" Padding="12,10" Click="OpenFriendsPage_Click" />
            <Button Content="{loc:Tr Key='Wyloguj'}" HorizontalAlignment="Stretch" Padding="12,10" Click="SignOut_Click" />

            <StackPanel Spacing="10" Margin="0,8,0,0">
              <TextBlock Text="{loc:Tr Key='Ostatnio używane gry'}" FontWeight="SemiBold" />
              <GridView x:Name="RecentGrid" SelectionMode="None" IsItemClickEnabled="False">
                <GridView.ItemTemplate>
                  <DataTemplate>
                    <Border Width="88" Height="88" CornerRadius="6" Background="#2B2B2B" Margin="4"
                            ToolTipService.ToolTip="{Binding Title}">
                      <Grid>
                        <TextBlock Text="{Binding TileLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="14"
                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVisInv}}" />
                        <Image Stretch="UniformToFill" Source="{Binding CoverImageUrl}"
                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </GridView.ItemTemplate>
              </GridView>
              <TextBlock x:Name="EmptyRecentText" Text="{loc:Tr Key='Brak gier w lokalnej bibliotece.'}"
                         Opacity="0.5" FontSize="12" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="10" Margin="0,8,0,0">
              <TextBlock Text="{loc:Tr Key='Osiągnięcia'}" FontWeight="SemiBold" />
              <TextBlock x:Name="AchievementsTotalText" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
              <ItemsControl x:Name="AchievementsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8" ColumnSpacing="8">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Opacity="0.75" />
                      <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="1"
                                   Value="{Binding Fraction}" Height="4" Margin="0,4,0,0" />
                      <Button Grid.Row="2" Grid.ColumnSpan="2" Content="{loc:Tr Key='Pokaż wszystkie osiągnięcia'}"
                              Tag="{Binding}" Click="OpenGameAchievements_Click" Padding="10,4" Margin="0,6,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
              <TextBlock Text="{loc:Tr Key='Gdzie gram'}" FontWeight="SemiBold" />
              <TextBlock Text="PC" Opacity="0.75" />
            </StackPanel>
          </StackPanel>

          <Border x:Name="EditPanel"
                  Grid.Column="1"
                  Visibility="Collapsed"
                  Background="#22FFFFFF"
                  CornerRadius="8"
                  Padding="18"
                  VerticalAlignment="Top">
            <StackPanel Spacing="14">
              <TextBlock Text="{loc:Tr Key='Dostosuj profil'}" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Key='Tag gracza'}" Opacity="0.6" FontSize="12" />
                <TextBox x:Name="EditPlayerTagBox" MinHeight="36" PlaceholderText="np. m455yn" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Key='Nazwa wyświetlana'}" Opacity="0.6" FontSize="12" />
                <TextBox x:Name="EditDisplayNameBox" MinHeight="36" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Key='Biografia'}" Opacity="0.6" FontSize="12" />
                <TextBox x:Name="EditBioBox" AcceptsReturn="True" Height="110" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Key='Lokalizacja'}" Opacity="0.6" FontSize="12" />
                <TextBox x:Name="EditLocationBox" MinHeight="36" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Key='Prywatność'}" Opacity="0.6" FontSize="12" />
                <CheckBox x:Name="EditHideAchievementsBox"
                          Content="{loc:Tr Key='Ukryj moje osiągnięcia przed innymi graczami'}" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Key='Zdjęcie profilowe'}" Opacity="0.6" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{loc:Tr Key='Zmień zdjęcie'}" Click="ChangeAvatar_Click" Padding="12,8" />
                  <Button Content="{loc:Tr Key='Usuń'}" Click="ClearAvatar_Click" Padding="12,8" />
                </StackPanel>
                <TextBlock x:Name="AvatarActionStatusText" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="{loc:Tr Key='Zapisz'}" Click="Save_Click" Padding="16,8" />
                <Button Content="{loc:Tr Key='Anuluj'}" Click="CancelEdit_Click" Padding="16,8" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
