<Page
    x:Class="SGSClient.UI.WinUI.Views.StudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SGSClient.UI.ViewModels"
    xmlns:local="using:SGSClient.UI.WinUI.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="BoolToVisInv" />

    <Style x:Key="GameListItem" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Padding="28,20,28,12" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="Panel twórcy" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="Strona sklepu, multimedia, buildy i DLC."
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Click="AddGame_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE710;" FontSize="14" />
            <TextBlock Text="Nowa gra" />
          </StackPanel>
        </Button>
        <Button Click="Refresh_Click" Padding="10,8" ToolTipService.ToolTip="Odśwież">
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="28,0,28,0" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource SectionCard}" Padding="0" Margin="0,0,0,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <AutoSuggestBox Margin="12,12,12,8"
                          PlaceholderText="Szukaj po tytule lub symbolu"
                          QueryIcon="Find"
                          Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <ListView Grid.Row="1"
                    ItemsSource="{Binding FilteredGames}"
                    SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                    ItemContainerStyle="{StaticResource GameListItem}"
                    SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:StudioContentItem">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="48" Height="48" CornerRadius="4"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid>
                      <TextBlock Text="{Binding TileLabel}" FontWeight="SemiBold" FontSize="12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0.55"
                                 Visibility="{Binding HasCover, Converter={StaticResource BoolToVisInv}}" />
                      <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"
                             Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Grid.Row="2" Margin="12,8,12,12"
                     Text="{Binding ListSummary}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" Margin="0,0,0,16"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
        <StackPanel Spacing="16">
          <SelectorBar x:Name="TabBar" SelectionChanged="Tab_SelectionChanged">
            <SelectorBarItem Tag="overview" Text="Przegląd" Icon="View" IsSelected="True" />
            <SelectorBarItem Tag="store" Text="Strona sklepu" Icon="Shop" />
            <SelectorBarItem Tag="media" Text="Multimedia" Icon="Pictures" />
            <SelectorBarItem Tag="builds" Text="Buildy" Icon="Setting" />
            <SelectorBarItem Tag="dlc" Text="DLC" Icon="Library" />
          </SelectorBar>

          <!-- Overview -->
          <StackPanel Spacing="16" Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
              <Viewbox Stretch="Uniform" Width="560" Height="262" HorizontalAlignment="Left">
                <Grid Width="920" Height="430">
                  <TextBlock Text="{Binding SelectedGame.TileLabel}" FontSize="48" FontWeight="Bold"
                             Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding SelectedGame.HasHeaderArt, Converter={StaticResource BoolToVisInv}}" />
                  <Image Source="{Binding SelectedGame.HeaderImageUrl}" Stretch="UniformToFill"
                         Visibility="{Binding SelectedGame.HasHeaderArt, Converter={StaticResource BoolToVis}}" />
                  <Border VerticalAlignment="Bottom" Padding="16,12">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#CC000000" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding SelectedGame.Title}" FontSize="22" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding SelectedGame.MetaText}" Opacity="0.8" FontSize="12" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Viewbox>
            </Border>

            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource SectionCard}">
                <StackPanel Spacing="2">
                  <TextBlock Text="Pobrania" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                  <TextBlock Text="{Binding TotalDownloadsText}" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource SectionCard}">
                <StackPanel Spacing="2">
                  <TextBlock Text="Ostatnie 30 dni" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                  <TextBlock Text="{Binding Last30Text}" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <StackPanel Spacing="2">
                  <TextBlock Text="Ostatnie 7 dni" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                  <TextBlock Text="{Binding Last7Text}" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Style="{StaticResource SectionCard}">
                <StackPanel Spacing="2">
                  <TextBlock Text="Wersja" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                  <TextBlock Text="{Binding SelectedGame.CurrentVersionText}" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource SectionCard}" Visibility="{Binding HasDailyBars, Converter={StaticResource BoolToVis}}">
              <StackPanel Spacing="8">
                <TextBlock Text="Aktywność pobrań (30 dni)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl ItemsSource="{Binding DailyBars}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="8" Height="{Binding BarHeight}" CornerRadius="2" VerticalAlignment="Bottom"
                              Background="{ThemeResource AccentFillColorDefaultBrush}"
                              Opacity="0.85" ToolTipService.ToolTip="{Binding Tooltip}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding LastDownloadText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                  <TextBlock Text="Widoczność w sklepie" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <TextBlock Text="Szkic jest ukryty dla graczy. Włącz, gdy strona sklepu i build są gotowe."
                             Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="PublishedSwitch" Grid.Column="1"
                              OffContent="Szkic" OnContent="W sklepie"
                              Toggled="Published_Toggled" />
              </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Opublikuj nową wersję" Click="AddVersion_Click" Padding="14,8" />
              <Button Content="Dodaj DLC" Click="AddDlc_Click" Padding="14,8" />
              <Button Content="Usuń grę" Click="Delete_Click" Padding="14,8" />
            </StackPanel>
          </StackPanel>

          <!-- Store -->
          <StackPanel Spacing="12" Visibility="{Binding IsStoreTab, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SectionCard}">
              <StackPanel Spacing="10">
                <TextBlock Text="Podstawowe" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBox Header="Tytuł" Text="{Binding SelectedGame.EditTitle, Mode=TwoWay}" />
                <TextBox Header="Opis" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                         Text="{Binding SelectedGame.EditDescription, Mode=TwoWay}" />
                <TextBox Header="Wymagania sprzętowe" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                         Text="{Binding SelectedGame.EditHardwareRequirements, Mode=TwoWay}" />
                <TextBox Header="Inne informacje" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                         Text="{Binding SelectedGame.EditOtherInformation, Mode=TwoWay}" />
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Header="Gatunek" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding GenreOptions}"
                            SelectedItem="{Binding SelectedGame.EditGenre, Mode=TwoWay}" />
                  <ComboBox Grid.Column="1" Header="Silnik" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding EngineOptions}"
                            SelectedItem="{Binding SelectedGame.EditEngine, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
              <StackPanel Spacing="10">
                <TextBlock Text="Wydanie i klasyfikacja" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Header="Status wydania" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ReleaseStatusOptions}"
                            SelectedIndex="{Binding SelectedGame.EditReleaseStatusIndex, Mode=TwoWay}" />
                  <CalendarDatePicker Grid.Column="1" Header="Data premiery"
                                      Date="{Binding SelectedGame.EditReleaseDate, Mode=TwoWay}" />
                  <ComboBox Grid.Column="2" Header="Kategoria wiekowa" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding AgeRatingOptions}"
                            SelectedIndex="{Binding SelectedGame.EditAgeRatingIndex, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
              <StackPanel Spacing="10">
                <TextBlock Text="Studio i linki" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBox Header="Nazwa studia" Text="{Binding SelectedGame.EditStudioName, Mode=TwoWay}" />
                <TextBox Header="Strona www" Text="{Binding SelectedGame.EditWebsiteUrl, Mode=TwoWay}" />
                <TextBox Header="Discord" Text="{Binding SelectedGame.EditDiscordUrl, Mode=TwoWay}" />
                <TextBox Header="Wsparcie" Text="{Binding SelectedGame.EditSupportUrl, Mode=TwoWay}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
              <StackPanel Spacing="10">
                <TextBlock Text="Funkcje" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Content="Singleplayer" IsChecked="{Binding SelectedGame.HasSinglePlayer, Mode=TwoWay}" />
                  <CheckBox Grid.Column="1" Content="Multiplayer" IsChecked="{Binding SelectedGame.HasMultiPlayer, Mode=TwoWay}" />
                  <CheckBox Grid.Column="2" Content="Kooperacja" IsChecked="{Binding SelectedGame.HasCoOp, Mode=TwoWay}" />
                  <CheckBox Grid.Column="3" Content="Pad" IsChecked="{Binding SelectedGame.HasController, Mode=TwoWay}" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Content="Chmura" IsChecked="{Binding SelectedGame.HasCloudSaves, Mode=TwoWay}" />
                  <CheckBox Grid.Column="1" Content="Osiągnięcia" IsChecked="{Binding SelectedGame.HasAchievements, Mode=TwoWay}" />
                  <CheckBox Grid.Column="2" Content="Mody" IsChecked="{Binding SelectedGame.HasModding, Mode=TwoWay}" />
                  <CheckBox Grid.Column="3" Content="VR" IsChecked="{Binding SelectedGame.HasVr, Mode=TwoWay}" />
                </Grid>
                <TextBox Header="Języki (oddzielone przecinkiem)"
                         Text="{Binding SelectedGame.EditLanguages, Mode=TwoWay}"
                         PlaceholderText="Polski, English" />
                <TextBox Header="Tagi (oddzielone przecinkiem)"
                         Text="{Binding SelectedGame.EditTags, Mode=TwoWay}"
                         PlaceholderText="roguelike, pixel art" />
              </StackPanel>
            </Border>

            <Button Content="Zapisz stronę sklepu" Style="{StaticResource AccentButtonStyle}"
                    Click="SaveStore_Click" HorizontalAlignment="Left" Padding="16,8" />
          </StackPanel>

          <!-- Media -->
          <StackPanel Spacing="12" Visibility="{Binding IsMediaTab, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SectionCard}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Height="160" Width="120" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <Image Source="{Binding SelectedGame.OwnCoverImageUrl}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Miniaturka" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <TextBlock Text="Pionowa, na listy i w bibliotece (jak kapsuła Steam)."
                             Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Wybierz plik" Click="PickCover_Click" />
                    <Button Content="Usuń" Click="ClearCover_Click" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource SectionCard}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="280" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="240" Height="112" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <Image Source="{Binding SelectedGame.OwnHeaderImageUrl}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Okładka pozioma" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <TextBlock Text="920 × 430 (proporcje Steam header) — wypełnia kafelek w całości."
                             Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Wybierz plik" Click="PickHeader_Click" />
                    <Button Content="Usuń" Click="ClearHeader_Click" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource SectionCard}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Height="140" Width="140" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <Image Source="{Binding SelectedGame.OwnLogoImageUrl}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Logo (kwadratowe)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <TextBlock Text="Kwadratowe logo na małe kafelki (np. lista zainstalowanych w sidebarze). Zalecane 512×512."
                             Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Wybierz plik" Click="PickLogo_Click" />
                    <Button Content="Usuń" Click="ClearLogo_Click" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource SectionCard}">
              <StackPanel Spacing="8">
                <TextBlock Text="Intro / zwiastun" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{Binding SelectedGame.IntroUrl}" Opacity="0.7" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Wybierz wideo" Click="PickIntro_Click" />
                  <Button Content="Usuń" Click="ClearIntro_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SectionCard}">
              <StackPanel Spacing="10">
                <Grid>
                  <TextBlock Text="Zrzuty ekranu" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <Button Content="Dodaj" HorizontalAlignment="Right" Click="AddScreenshot_Click" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SelectedGame.ScreenshotItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Width="160" Height="92" Margin="0,0,8,8">
                        <Border CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                          <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                        </Border>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                Tag="{Binding}" Click="RemoveScreenshot_Click" Padding="6">
                          <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Builds -->
          <StackPanel Spacing="12" Visibility="{Binding IsBuildsTab, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SectionCard}">
              <StackPanel Spacing="10">
                <Grid>
                  <TextBlock Text="Aktualne buildy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <Button Content="Nowa wersja" HorizontalAlignment="Right" Click="AddVersion_Click" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SelectedGame.Builds}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="12" Margin="0,0,0,8" CornerRadius="6"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid>
                          <StackPanel>
                            <TextBlock Text="{Binding PlatformText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MetaText}" Opacity="0.7" FontSize="12" />
                          </StackPanel>
                          <TextBlock Text="{Binding Version}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     FontWeight="SemiBold" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SectionCard}">
              <StackPanel Spacing="10">
                <TextBlock Text="Historia i opis zmian" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl ItemsSource="{Binding Versions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StudioVersionItem">
                      <Border Padding="12" Margin="0,0,0,10" CornerRadius="6"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                          <Grid>
                            <TextBlock Text="{Binding Version}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MetaText}" HorizontalAlignment="Right" Opacity="0.7" FontSize="12" />
                          </Grid>
                          <TextBox Header="Notatki do tej wersji" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                   Text="{Binding EditNotes, Mode=TwoWay}" />
                          <Button Content="Zapisz opis zmian" Tag="{Binding}" Click="SaveNotes_Click"
                                  HorizontalAlignment="Left" Padding="12,6" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Brak opublikowanych wersji." Opacity="0.6"
                           Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisInv}}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- DLC -->
          <StackPanel Spacing="12" Visibility="{Binding IsDlcTab, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SectionCard}">
              <StackPanel Spacing="10">
                <Grid>
                  <TextBlock Text="Dodatki" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <Button Content="Dodaj DLC" HorizontalAlignment="Right" Click="AddDlc_Click" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SelectedGame.Dlcs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="12" Margin="0,0,0,8" CornerRadius="6"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid ColumnSpacing="12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MetaText}" Opacity="0.7" FontSize="12" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="Usuń" Tag="{Binding}" Click="DeleteDlc_Click" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Ta gra nie ma jeszcze DLC." Opacity="0.6"
                           Visibility="{Binding SelectedGame.HasDlcs, Converter={StaticResource BoolToVisInv}}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="0,0,0,16"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInv}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
          <Button Content="Opublikuj pierwszą grę" Click="AddGame_Click" Style="{StaticResource AccentButtonStyle}"
                  Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Padding="28,8,28,16">
      <TextBlock Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap" />
      <ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" HorizontalAlignment="Right"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </Grid>
</Page>
