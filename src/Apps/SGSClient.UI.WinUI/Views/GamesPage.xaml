<Page
    x:Class="SGSClient.UI.WinUI.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,24" RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="6">
        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Opacity="0.65" FontSize="13" />
      </StackPanel>
      <Button Grid.Column="1" Content="Odśwież" Click="Refresh_Click" Padding="12,6" VerticalAlignment="Top" />
    </Grid>

    <Grid Grid.Row="1">
      <TextBlock x:Name="EmptyText"
                 Opacity="0.6"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed" />

      <GridView x:Name="GamesGrid"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="GamesGrid_ItemClick">
        <!-- Kill default GridViewItem hover chrome (sharp offset rectangle). -->
        <GridView.ItemContainerStyle>
          <Style TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
          <DataTemplate>
            <Border Width="260" Padding="14" CornerRadius="8"
                    Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                    PointerEntered="GameCard_PointerEntered"
                    PointerExited="GameCard_PointerExited">
              <StackPanel Spacing="10">
                <Border Height="140" CornerRadius="8" Background="#333">
                  <Grid>
                    <TextBlock Text="{Binding TileLabel}" FontWeight="Bold" FontSize="28" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding FeaturedBadge}" FontSize="11" Opacity="0.7" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" Opacity="0.7" FontSize="12"
                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PlatformsText}" Opacity="0.55" FontSize="11" />
                <Button Content="{Binding ActionLabel}"
                        Click="AddToLibrary_Click"
                        Tag="{Binding}"
                        IsEnabled="{Binding CanAdd}"
                        HorizontalAlignment="Stretch"
                        Padding="10,8" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
    </Grid>
  </Grid>
</Page>
