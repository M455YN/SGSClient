<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SGSClient.UI.WinUI.Views">

  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />

    <!-- Reusable checkbox list shown inside a filter flyout. -->
    <DataTemplate x:Key="FilterOptionTemplate">
      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0" Padding="8,0,0,0" />
    </DataTemplate>
  </Page.Resources>

  <Grid Padding="36,20,36,0" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Search, centered like the reference store. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="2*" MaxWidth="560" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="1"
               PlaceholderText="{loc:Tr Key='Wyszukaj gry, studia i tagi'}"
               TextChanged="Filter_Changed" Padding="12,8" CornerRadius="18" />
      <Button Grid.Column="2" Content="{loc:Tr Key='Odśwież'}" Click="Refresh_Click"
              HorizontalAlignment="Right" Padding="12,6" />
    </Grid>

    <!-- Title + sort / filter toggle. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock x:Name="TitleText" FontSize="34" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Tr Key='Odkrywaj gry niezależnych twórców'}" FontSize="14" Opacity="0.8" />
        <TextBlock x:Name="StatusText" Margin="0,14,0,0" Opacity="0.6" FontSize="12" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
        <Button x:Name="FilterButton" Click="ToggleFilters_Click" Padding="14,7">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE71C;" FontSize="14" />
            <TextBlock x:Name="FilterButtonText" Text="{loc:Tr Key='Filtry'}" />
          </StackPanel>
        </Button>
        <Button Click="ViewMode_Click" Padding="10,7"
                ToolTipService.ToolTip="Przełącz widok: siatka / lista">
          <FontIcon x:Name="ViewModeIcon" Glyph="&#xE8FD;" FontSize="14" />
        </Button>
        <TextBlock Text="{loc:Tr Key='Sortuj według'}" VerticalAlignment="Center" FontSize="13" />
        <ComboBox x:Name="SortBox" MinWidth="170" SelectionChanged="Sort_Changed" />
      </StackPanel>
    </Grid>

    <!-- Collapsible filter panel (Gatunek / Silnik / Funkcje / Platforma / Premiera). -->
    <Border Grid.Row="2" CornerRadius="10" Padding="20,16"
            Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
            Visibility="{x:Bind ViewModel.IsFilterPanelOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="6">
          <TextBlock Text="{loc:Tr Key='Gatunek'}" FontWeight="SemiBold" FontSize="13" />
          <DropDownButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Content="{x:Bind ViewModel.GenreFilters.Summary, Mode=OneWay}">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ScrollViewer MaxHeight="340" MinWidth="240">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.GenreFilters.Options}"
                                ItemTemplate="{StaticResource FilterOptionTemplate}" />
                </ScrollViewer>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="{loc:Tr Key='Silnik'}" FontWeight="SemiBold" FontSize="13" />
          <DropDownButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Content="{x:Bind ViewModel.EngineFilters.Summary, Mode=OneWay}">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ScrollViewer MaxHeight="340" MinWidth="240">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.EngineFilters.Options}"
                                ItemTemplate="{StaticResource FilterOptionTemplate}" />
                </ScrollViewer>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock Text="{loc:Tr Key='Funkcje'}" FontWeight="SemiBold" FontSize="13" />
          <DropDownButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Content="{x:Bind ViewModel.FeatureFilters.Summary, Mode=OneWay}">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ScrollViewer MaxHeight="340" MinWidth="220">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.FeatureFilters.Options}"
                                ItemTemplate="{StaticResource FilterOptionTemplate}" />
                </ScrollViewer>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </StackPanel>

        <StackPanel Grid.Column="3" Spacing="6">
          <TextBlock Text="{loc:Tr Key='Platforma'}" FontWeight="SemiBold" FontSize="13" />
          <ComboBox HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.PlatformOptions}"
                    SelectedIndex="{x:Bind ViewModel.SelectedPlatformIndex, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Column="4" Spacing="6">
          <TextBlock Text="{loc:Tr Key='Etap premiery'}" FontWeight="SemiBold" FontSize="13" />
          <ComboBox HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.ReleaseStatusFilterOptions}"
                    SelectedIndex="{x:Bind ViewModel.SelectedStatusIndex, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Tr Key='Wyczyść'}" Click="ClearFilters_Click" Padding="12,6" />
          <Button Content="✕" Click="ToggleFilters_Click" Padding="10,6" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <TextBlock x:Name="EmptyText"
                 Opacity="0.6"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed" />

      <!-- Compact list mode: one dense row per game. -->
      <ListView x:Name="GamesList"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="GamesGrid_ItemClick"
                Padding="0,6,0,24">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="8" Padding="10,8"
                    Background="#1FFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                    PointerEntered="GameCard_PointerEntered"
                    PointerExited="GameCard_PointerExited">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition Width="3*" MinWidth="180" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="1.4*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="48" Height="64" Background="#2B2B2B" CornerRadius="4">
                  <TextBlock Text="{Binding TileLabel}" FontWeight="Bold" FontSize="14" Opacity="0.3"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding PosterImageUrl}" Stretch="UniformToFill" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <TextBlock Text="{Binding StudioName}" Opacity="0.6" FontSize="12"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding GenresText}" FontSize="12"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <TextBlock Text="{Binding EnginesText}" Opacity="0.55" FontSize="11"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding PlatformsText}" Opacity="0.55" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Column="4" Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="5" Content="{Binding WishlistSymbol}" FontSize="16" Padding="9,3"
                        VerticalAlignment="Center" Click="Wishlist_Click" Tag="{Binding}"
                        ToolTipService.ToolTip="{Binding WishlistLabel}" />

                <Button Grid.Column="6" Content="{Binding ActionLabel}" Click="AddToLibrary_Click"
                        Tag="{Binding}" IsEnabled="{Binding CanAdd}" VerticalAlignment="Center"
                        Padding="10,5" FontSize="12" MinWidth="140" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <GridView x:Name="GamesGrid"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="GamesGrid_ItemClick"
                Padding="0,6,0,24">
        <!-- Kill default GridViewItem hover chrome (sharp offset rectangle). -->
        <GridView.ItemContainerStyle>
          <Style TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,18,18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
          <DataTemplate>
            <!-- Portrait store capsule: poster on top, meta below. -->
            <Border Width="190" CornerRadius="8"
                    Background="#1FFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                    PointerEntered="GameCard_PointerEntered"
                    PointerExited="GameCard_PointerExited">
              <StackPanel>
                <Grid Height="254" Background="#2B2B2B" CornerRadius="8,8,0,0">
                  <TextBlock Text="{Binding TileLabel}" FontWeight="Bold" FontSize="34" Opacity="0.3"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding PosterImageUrl}" Stretch="UniformToFill" />

                  <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                          Padding="7,3" CornerRadius="4" Background="#CC111111"
                          Visibility="{Binding HasStatusBadge, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold" />
                  </Border>

                  <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                          Padding="8,2" CornerRadius="14" Background="#99000000"
                          Content="{Binding WishlistSymbol}" FontSize="16"
                          Click="Wishlist_Click" Tag="{Binding}"
                          ToolTipService.ToolTip="{Binding WishlistLabel}" />
                </Grid>

                <StackPanel Padding="10,10,10,10" Spacing="3">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                             MinHeight="34" />
                  <TextBlock Text="{Binding StudioName}" Opacity="0.6" FontSize="12"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <TextBlock Text="{Binding GenresText}" FontSize="11" Opacity="0.85"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" MaxLines="1" MinHeight="16" />
                  <TextBlock Text="{Binding PlatformsText}" Opacity="0.5" FontSize="11"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <Button Content="{Binding ActionLabel}"
                          Click="AddToLibrary_Click"
                          Tag="{Binding}"
                          IsEnabled="{Binding CanAdd}"
                          HorizontalAlignment="Stretch"
                          Margin="0,6,0,0"
                          Padding="8,5" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
    </Grid>
  </Grid>
</Page>
