<UserControl
    x:Class="SGSClient.UI.WinUI.Views.GamePropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="1100"
    MinHeight="620"
    Width="1100">

  <Grid Height="640" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
      <StackPanel Margin="12,16" Spacing="4">
        <TextBlock x:Name="GameTitleText"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                   TextWrapping="Wrap"
                   Margin="8,0,8,12" />
        <ListView x:Name="NavList"
                  SelectionMode="Single"
                  SelectionChanged="NavList_SelectionChanged"
                  Background="Transparent"
                  BorderThickness="0">
          <ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" Margin="4,2" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Padding="24,20">
      <StackPanel Spacing="16">
        <StackPanel x:Name="BetasPanel" Spacing="12">
          <TextBlock Text="Wersje i bety gry" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="Wybrana wersja gry" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Text="Wersje są udostępniane przez twórców. Starsze buildy mogą być niestabilne."
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tytuł i opis"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1"
                       Text="Ostatnia aktualizacja"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Grid>

          <ListView x:Name="VersionsList"
                    SelectionMode="Single"
                    SelectionChanged="Version_SelectionChanged"
                    Background="Transparent"
                    BorderThickness="0"
                    MaxHeight="260">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="4,8" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding UpdatedText}"
                             VerticalAlignment="Center"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <InfoBar IsOpen="True"
                   IsClosable="False"
                   Severity="Informational"
                   Title="Wersje prywatne"
                   Message="Odblokowywanie prywatnych bet będzie dostępne w kolejnej wersji." />
        </StackPanel>

        <StackPanel x:Name="FilesPanel" Spacing="14" Visibility="Collapsed">
          <TextBlock Text="Zainstalowane pliki" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="Lokalne pliki gry na tym komputerze. Odinstalowanie usuwa pliki, ale gra zostaje w bibliotece."
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />

          <Border Padding="16" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="12">
              <Grid RowSpacing="8" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Status" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InstallStateText" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Row="1" Text="Wersja" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InstalledVersionText" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="2" Text="Rozmiar" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InstallSizeText" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" Text="Pliki" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InstallFilesText" Grid.Row="3" Grid.Column="1" />
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Text="Folder instalacji"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InstallPathText" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="BrowseFilesButton"
                    Content="Przeglądaj pliki lokalne…"
                    Click="BrowseLocalFiles_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="14,10" />
            <Button Content="Odśwież"
                    Click="RefreshInstallInfo_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="14,10" />
            <Button x:Name="UninstallFilesButton"
                    Content="Odinstaluj…"
                    Click="UninstallFiles_Click"
                    Padding="14,10" />
          </StackPanel>

          <Border x:Name="MoveFilesPanel"
                  Padding="14"
                  CornerRadius="8"
                  Margin="0,4,0,0"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Visibility="Collapsed">
            <StackPanel Spacing="10">
              <TextBlock Text="Przenieś pliki" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="Wybierz inny folder biblioteki (dodajesz je w Ustawieniach)."
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextWrapping="Wrap" />
              <ComboBox x:Name="MoveTargetCombo"
                        DisplayMemberPath="DisplayName"
                        SelectionChanged="MoveTargetCombo_SelectionChanged"
                        HorizontalAlignment="Stretch"
                        MinHeight="36" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="MoveFilesButton"
                        Content="Przenieś pliki…"
                        Click="MoveFiles_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="14,10" />
                <TextBlock x:Name="MoveProgressText"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="Weryfikacja integralności plików pojawi się w kolejnej wersji."
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="PersonalizationPanel" Spacing="14" Visibility="Collapsed">
          <TextBlock Text="Personalizacja" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="Własny obrazek kafla w bibliotece (nadpisuje okładkę ze sklepu)."
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />

          <Border Width="168" Height="248" CornerRadius="8" HorizontalAlignment="Left"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <Grid>
              <TextBlock x:Name="CustomCoverPlaceholder"
                         Text="Podgląd"
                         Opacity="0.45"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <Image x:Name="CustomCoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Wybierz obrazek…"
                    Click="PickCustomCover_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="14,10" />
            <Button x:Name="ClearCustomCoverButton"
                    Content="Przywróć domyślny"
                    Click="ClearCustomCover_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="14,10" />
          </StackPanel>
          <TextBlock Text="Obsługiwane: PNG, JPG, WEBP. Plik trafia do lokalnej pamięci klienta."
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="DlcPanel" Spacing="14" Visibility="Collapsed">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DLC" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Zobacz więcej w sklepie"
                    Click="ViewMoreInStore_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="12,8" />
          </Grid>

          <TextBox x:Name="DlcSearchBox"
                   PlaceholderText="Szukaj DLC…"
                   TextChanged="DlcSearchBox_TextChanged" />

          <Grid Margin="0,4,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Instaluj" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Nazwa" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="Dodano" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="3" Text="Rozmiar" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right" />
          </Grid>

          <ListView x:Name="DlcList"
                    SelectionMode="None"
                    Background="Transparent"
                    BorderThickness="0"
                    MaxHeight="360">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="0,8" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsInstalled}"
                            MinWidth="0"
                            Click="DlcInstallCheck_Click"
                            Tag="{Binding}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Border Width="40" Height="40" CornerRadius="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                      <Image Source="{Binding CoverPreviewUri}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding AddedText}" VerticalAlignment="Center"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center"
                             HorizontalAlignment="Right"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <TextBlock x:Name="DlcStatusText"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel x:Name="PlaceholderPanel" Spacing="8" Visibility="Collapsed">
          <InfoBar x:Name="PlaceholderInfo"
                   IsOpen="True"
                   IsClosable="False"
                   Severity="Informational"
                   Title="Wkrótce"
                   Message="Ta sekcja pojawi się w kolejnej wersji klienta." />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
