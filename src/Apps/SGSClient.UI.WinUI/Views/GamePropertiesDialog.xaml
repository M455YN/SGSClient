<UserControl xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.GamePropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="1100"
    MinHeight="620"
    Width="1100">

  <Grid Height="640" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
      <StackPanel Margin="12,16" Spacing="4">
        <TextBlock x:Name="GameTitleText"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                   TextWrapping="Wrap"
                   Margin="8,0,8,12" />
        <ListView x:Name="NavList"
                  SelectionMode="Single"
                  SelectionChanged="NavList_SelectionChanged"
                  Background="Transparent"
                  BorderThickness="0">
          <ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" Margin="4,2" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Padding="24,20">
      <StackPanel Spacing="16">
        <StackPanel x:Name="BetasPanel" Spacing="12">
          <TextBlock Text="{loc:Tr Key='Wersje i bety gry'}" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="{loc:Tr Key='Wybrana wersja gry'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Text="{loc:Tr Key='Wersje są udostępniane przez twórców. Starsze buildy mogą być niestabilne.'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Tr Key='Tytuł i opis'}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1"
                       Text="{loc:Tr Key='Ostatnia aktualizacja'}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Grid>

          <ListView x:Name="VersionsList"
                    SelectionMode="Single"
                    SelectionChanged="Version_SelectionChanged"
                    Background="Transparent"
                    BorderThickness="0"
                    MaxHeight="260">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="4,8" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding UpdatedText}"
                             VerticalAlignment="Center"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <InfoBar IsOpen="True"
                   IsClosable="False"
                   Severity="Informational"
                   Title="{loc:Tr Key='Wersje prywatne'}"
                   Message="Prywatne wersje beta — wkrótce." />
        </StackPanel>

        <StackPanel x:Name="FilesPanel" Spacing="14" Visibility="Collapsed">
          <TextBlock Text="{loc:Tr Key='Zainstalowane pliki'}" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="{loc:Tr Key='Lokalne pliki gry na tym komputerze. Odinstalowanie usuwa pliki, ale gra zostaje w bibliotece.'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />

          <Border Padding="16" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="12">
              <Grid RowSpacing="8" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Status" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InstallStateText" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Row="1" Text="{loc:Tr Key='Wersja'}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InstalledVersionText" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="2" Text="{loc:Tr Key='Rozmiar'}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InstallSizeText" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" Text="{loc:Tr Key='Pliki'}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InstallFilesText" Grid.Row="3" Grid.Column="1" />
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Key='Folder instalacji'}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InstallPathText" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="BrowseFilesButton"
                    Content="{loc:Tr Key='Przeglądaj pliki lokalne…'}"
                    Click="BrowseLocalFiles_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="14,10" />
            <Button Content="{loc:Tr Key='Odśwież'}"
                    Click="RefreshInstallInfo_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="14,10" />
            <Button x:Name="UninstallFilesButton"
                    Content="{loc:Tr Key='Odinstaluj…'}"
                    Click="UninstallFiles_Click"
                    Padding="14,10" />
          </StackPanel>

          <Border x:Name="MoveFilesPanel"
                  Padding="14"
                  CornerRadius="8"
                  Margin="0,4,0,0"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Visibility="Collapsed">
            <StackPanel Spacing="10">
              <TextBlock Text="{loc:Tr Key='Przenieś pliki'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="{loc:Tr Key='Wybierz inny folder biblioteki (dodajesz je w Ustawieniach).'}"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextWrapping="Wrap" />
              <ComboBox x:Name="MoveTargetCombo"
                        DisplayMemberPath="DisplayName"
                        SelectionChanged="MoveTargetCombo_SelectionChanged"
                        HorizontalAlignment="Stretch"
                        MinHeight="36" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="MoveFilesButton"
                        Content="{loc:Tr Key='Przenieś pliki…'}"
                        Click="MoveFiles_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="14,10" />
                <TextBlock x:Name="MoveProgressText"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{loc:Tr Key='Weryfikacja plików — wkrótce.'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="PersonalizationPanel" Spacing="14" Visibility="Collapsed">
          <TextBlock Text="{loc:Tr Key='Personalizacja'}" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="{loc:Tr Key='Własny obrazek kafla w bibliotece (nadpisuje okładkę ze sklepu).'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />

          <Border Width="168" Height="248" CornerRadius="8" HorizontalAlignment="Left"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <Grid>
              <TextBlock x:Name="CustomCoverPlaceholder"
                         Text="{loc:Tr Key='Podgląd'}"
                         Opacity="0.45"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <Image x:Name="CustomCoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{loc:Tr Key='Wybierz obrazek…'}"
                    Click="PickCustomCover_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="14,10" />
            <Button x:Name="ClearCustomCoverButton"
                    Content="{loc:Tr Key='Przywróć domyślny'}"
                    Click="ClearCustomCover_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="14,10" />
          </StackPanel>
          <TextBlock Text="{loc:Tr Key='Obsługiwane: PNG, JPG, WEBP. Plik trafia do lokalnej pamięci klienta.'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="DlcPanel" Spacing="14" Visibility="Collapsed">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DLC" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{loc:Tr Key='Zobacz więcej w sklepie'}"
                    Click="ViewMoreInStore_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="12,8" />
          </Grid>

          <TextBox x:Name="DlcSearchBox"
                   PlaceholderText="{loc:Tr Key='Szukaj DLC…'}"
                   TextChanged="DlcSearchBox_TextChanged" />

          <Grid Margin="0,4,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Tr Key='Instaluj'}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="{loc:Tr Key='Nazwa'}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="{loc:Tr Key='Dodano'}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="3" Text="{loc:Tr Key='Rozmiar'}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right" />
          </Grid>

          <ListView x:Name="DlcList"
                    SelectionMode="None"
                    Background="Transparent"
                    BorderThickness="0"
                    MaxHeight="360">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="0,8" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsInstalled}"
                            MinWidth="0"
                            Click="DlcInstallCheck_Click"
                            Tag="{Binding}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Border Width="40" Height="40" CornerRadius="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                      <Image Source="{Binding CoverPreviewUri}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding AddedText}" VerticalAlignment="Center"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center"
                             HorizontalAlignment="Right"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <TextBlock x:Name="DlcStatusText"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel x:Name="GeneralPanel" Spacing="14" Visibility="Collapsed">
          <TextBlock Text="{loc:Tr Key='Ogólne'}" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock x:Name="GeneralSummaryText"
                     Style="{StaticResource BodyTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />
          <Grid ColumnSpacing="24" RowSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Status" Opacity="0.65" />
            <TextBlock x:Name="GeneralStateText" Grid.Column="1" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="{loc:Tr Key='Wersja'}" Opacity="0.65" />
            <TextBlock x:Name="GeneralVersionText" Grid.Row="1" Grid.Column="1" />
            <TextBlock Grid.Row="2" Text="{loc:Tr Key='Lokalizacja'}" Opacity="0.65" />
            <TextBlock x:Name="GeneralPathText" Grid.Row="2" Grid.Column="1"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Tr Key='Otwórz folder'}" Click="BrowseLocalFiles_Click" x:Name="GeneralBrowseButton" />
            <Button Content="{loc:Tr Key='Zobacz w sklepie'}" Click="ViewMoreInStore_Click" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="UpdatesPanel" Spacing="14" Visibility="Collapsed">
          <TextBlock Text="{loc:Tr Key='Aktualizacje'}" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock x:Name="UpdatesStatusText"
                     Style="{StaticResource BodyTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />
          <Grid ColumnSpacing="24" RowSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:Tr Key='Zainstalowana'}" Opacity="0.65" />
            <TextBlock x:Name="UpdatesInstalledText" Grid.Column="1" />
            <TextBlock Grid.Row="1" Text="{loc:Tr Key='Dostępna w sklepie'}" Opacity="0.65" />
            <TextBlock x:Name="UpdatesLatestText" Grid.Row="1" Grid.Column="1" />
          </Grid>
          <ToggleSwitch x:Name="AutoUpdateSwitch"
                        OffContent="{loc:Tr Key='Aktualizacje ręczne'}"
                        OnContent="{loc:Tr Key='Aktualizuj automatycznie'}"
                        Toggled="AutoUpdateSwitch_Toggled" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Tr Key='Sprawdź aktualizacje'}" Click="CheckForUpdates_Click" />
            <Button x:Name="UpdateNowButton" Content="{loc:Tr Key='Aktualizuj teraz'}"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="UpdateNow_Click" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="PlaceholderPanel" Spacing="8" Visibility="Collapsed">
          <InfoBar x:Name="PlaceholderInfo"
                   IsOpen="True"
                   IsClosable="False"
                   Severity="Informational"
                   Title="{loc:Tr Key='Wkrótce'}"
                   Message="Ta sekcja pojawi się w kolejnej wersji klienta." />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
