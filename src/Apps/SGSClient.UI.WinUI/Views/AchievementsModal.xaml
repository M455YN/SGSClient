<UserControl
    x:Class="SGSClient.UI.WinUI.Views.AchievementsModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    xmlns:local="using:SGSClient.UI.WinUI.Views"
    Width="760" Height="640">

  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

    <Border Grid.Row="1" Padding="14,10" CornerRadius="6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="8">
        <Grid>
          <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" FontSize="12" />
          <TextBlock Text="{Binding PercentText}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="220" />
      </Grid.ColumnDefinitions>
      <Button Content="{loc:Tr Key='Moje osiągnięcia'}" Click="Mine_Click" />
      <Button Grid.Column="1" Content="{loc:Tr Key='Osiągnięcia globalne'}" Click="Global_Click" />
      <TextBox Grid.Column="3" PlaceholderText="{loc:Tr Key='Szukaj'}"
               Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>

    <ScrollViewer Grid.Row="3">
      <StackPanel Spacing="8">
        <TextBlock x:Name="EmptyText" Opacity="0.6" />
        <ItemsControl ItemsSource="{Binding Visible}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="10" CornerRadius="6"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="56" Height="56" CornerRadius="4"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" Opacity="0.8" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RarityText}" Opacity="0.55" FontSize="12" />
                    <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding UnlockedText}" Opacity="0.65" FontSize="12"
                             VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
