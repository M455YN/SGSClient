<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SGSClient.UI.WinUI.Views">

  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="BoolToVisInv" />

    <Style x:Key="IconAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="CharacterSpacing" Value="60" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
  </Page.Resources>

  <Grid Padding="28,24" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{loc:Tr Key='Pobrania'}" Style="{StaticResource TitleTextBlockStyle}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button Style="{StaticResource IconAction}" Content="&#xE72C;" Click="Refresh_Click"
                ToolTipService.ToolTip="{loc:Tr Key='Odśwież'}" />
        <Button Style="{StaticResource IconAction}" Content="&#xE713;"
                ToolTipService.ToolTip="{loc:Tr Key='Ustawienia pobierania'}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="8" Width="260">
                <TextBlock Text="{loc:Tr Key='Limit pobierania (MB/s):'}" />
                <NumberBox x:Name="BandwidthBox"
                           Minimum="0"
                           Maximum="1000"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="BandwidthBox_ValueChanged" />
                <TextBlock Text="{loc:Tr Key='0 = bez limitu'}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Active download: cover on the left, live numbers and controls on the right -->
    <Border Grid.Row="1" CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            Visibility="{Binding HasActiveDownload, Converter={StaticResource BoolToVis}}">
      <Grid MinHeight="168">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="200" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="7,0,0,7" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
          <Border CornerRadius="7,0,0,7">
            <Border.Background>
              <ImageBrush ImageSource="{Binding ActiveCoverUrl}" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
        </Border>

        <Grid Grid.Column="1" Padding="20,16" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="2">
            <TextBlock Text="{Binding ActiveDownloadTitle}" Style="{StaticResource SubtitleTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ActiveDownloadDetail}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <Grid Grid.Row="1" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{loc:Tr Key='SIEĆ'}" Style="{StaticResource StatLabel}" />
              <TextBlock Text="{Binding ActiveSpeedText}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{loc:Tr Key='NAJWIĘCEJ'}" Style="{StaticResource StatLabel}" />
              <TextBlock Text="{Binding ActivePeakText}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{loc:Tr Key='ROZMIAR'}" Style="{StaticResource StatLabel}" />
              <TextBlock Text="{Binding ActiveSizeText}" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ActiveDownloadProgress}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ActiveDownloadProgressText}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Grid>

          <Grid Grid.Row="3" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ActiveEtaText}" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Style="{StaticResource AccentButtonStyle}" Click="Pause_Click" Tag="{Binding ActiveRow}"
                      Visibility="{Binding ActiveRow.CanPause, Converter={StaticResource BoolToVis}}"
                      ToolTipService.ToolTip="{loc:Tr Key='Pauza'}">
                <FontIcon Glyph="&#xE769;" FontSize="14" />
              </Button>
              <Button Style="{StaticResource AccentButtonStyle}" Click="Resume_Click" Tag="{Binding ActiveRow}"
                      Visibility="{Binding ActiveRow.CanResume, Converter={StaticResource BoolToVis}}"
                      ToolTipService.ToolTip="{loc:Tr Key='Wznów'}">
                <FontIcon Glyph="&#xE768;" FontSize="14" />
              </Button>
              <Button Click="Cancel_Click" Tag="{Binding ActiveRow}"
                      Visibility="{Binding ActiveRow.CanCancel, Converter={StaticResource BoolToVis}}"
                      ToolTipService.ToolTip="{loc:Tr Key='Anuluj'}">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                Visibility="{Binding HasActiveDownload, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{loc:Tr Key='Następne'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock Text="{Binding UpNext.Count}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <Grid Grid.Row="3">
      <TextBlock Text="{loc:Tr Key='Brak aktywnych pobierań.'}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding HasActiveDownload, Converter={StaticResource BoolToVisInv}}" />

      <StackPanel Visibility="{Binding HasActiveDownload, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{loc:Tr Key='Brak pobrań w kolejce'}" Margin="4,0,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasUpNext, Converter={StaticResource BoolToVisInv}}" />

        <ListView x:Name="DownloadsList"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="DownloadsList_ItemClick">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="0,6" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="96" Height="44" CornerRadius="4"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                  <Border CornerRadius="4">
                    <Border.Background>
                      <ImageBrush ImageSource="{Binding CoverImageUrl}" Stretch="UniformToFill" />
                    </Border.Background>
                  </Border>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding KindText}" /><Run Text=" · " /><Run Text="{Binding StateText}" />
                  </TextBlock>
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                               Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                  <TextBlock Text="{Binding DetailText}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Style="{StaticResource IconAction}" Content="&#xE74A;" Click="MoveUp_Click" Tag="{Binding}"
                          Visibility="{Binding CanMoveUp, Converter={StaticResource BoolToVis}}"
                          ToolTipService.ToolTip="{loc:Tr Key='Wyżej w kolejce'}" />
                  <Button Style="{StaticResource IconAction}" Content="&#xE74B;" Click="MoveDown_Click" Tag="{Binding}"
                          Visibility="{Binding CanMoveDown, Converter={StaticResource BoolToVis}}"
                          ToolTipService.ToolTip="{loc:Tr Key='Niżej w kolejce'}" />
                  <Button Style="{StaticResource IconAction}" Content="&#xE769;" Click="Pause_Click" Tag="{Binding}"
                          Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                          ToolTipService.ToolTip="{loc:Tr Key='Pauza'}" />
                  <Button Style="{StaticResource IconAction}" Content="&#xE768;" Click="Resume_Click" Tag="{Binding}"
                          Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                          ToolTipService.ToolTip="{loc:Tr Key='Wznów'}" />
                  <Button Style="{StaticResource IconAction}" Content="&#xE711;" Click="Cancel_Click" Tag="{Binding}"
                          Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                          ToolTipService.ToolTip="{loc:Tr Key='Anuluj'}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
