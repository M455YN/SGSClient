<Page
    x:Class="SGSClient.UI.WinUI.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,24" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="6">
        <TextBlock Text="Pobrania" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Opacity="0.65" FontSize="13" />
      </StackPanel>
      <Button Grid.Column="1" Content="Odśwież" Click="Refresh_Click" Padding="12,6"
              VerticalAlignment="Top" />
    </Grid>

    <Grid Grid.Row="1">
      <TextBlock x:Name="EmptyText"
                 Text="Brak aktywnych pobierań."
                 Opacity="0.6"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed" />

      <ListView x:Name="DownloadsList"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="DownloadsList_ItemClick">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="4,10" ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock FontSize="12" Opacity="0.7">
                  <Run Text="{Binding KindText}" />
                  <Run Text=" · " />
                  <Run Text="{Binding StateText}" />
                </TextBlock>
                <TextBlock Text="{Binding DetailText}" FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                             Height="6" />
                <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.65"
                           HorizontalAlignment="Right" />
              </StackPanel>
              <Button Grid.Column="2" Content="Anuluj" Padding="12,6"
                      VerticalAlignment="Center"
                      Click="Cancel_Click" Tag="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</Page>
