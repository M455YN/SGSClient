<UserControl
    x:Class="SGSClient.UI.WinUI.Views.AchievementsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    xmlns:vm="using:SGSClient.UI.ViewModels"
    xmlns:local="using:SGSClient.UI.WinUI.Views">

  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Resources>

  <StackPanel Spacing="12">
    <Border Style="{StaticResource SectionCard}">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{loc:Tr Key='Osiągnięcia'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Tr Key='Dodaj osiągnięcie'}" Command="{Binding AddCommand}" />
          <Button Content="{loc:Tr Key='Odśwież'}" Command="{Binding ReloadCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StudioAchievementItem">
          <Border Padding="12" Margin="0,0,0,8" CornerRadius="6"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Header="{loc:Tr Key='Klucz (stały identyfikator)'}"
                         Text="{Binding EditKey, Mode=TwoWay}" IsEnabled="{Binding IsKeyEditable}" />
                <TextBox Grid.Column="1" Header="{loc:Tr Key='Tytuł'}" Text="{Binding EditTitle, Mode=TwoWay}" />
              </Grid>
              <TextBox Header="{loc:Tr Key='Opis'}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                       Text="{Binding EditDescription, Mode=TwoWay}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Header="{loc:Tr Key='Tytuł (angielski)'}" Text="{Binding EditTitleEn, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="{loc:Tr Key='Opis (angielski)'}"
                         Text="{Binding EditDescriptionEn, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <Image Source="{Binding IconPreviewUrl}" Stretch="UniformToFill"
                         Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                </Border>
                <TextBox Grid.Column="1" Header="{loc:Tr Key='Adres ikony (URL)'}"
                         Text="{Binding EditIconUrl, Mode=TwoWay}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                  <Button Content="{loc:Tr Key='Wgraj ikonę'}" Tag="{Binding}" Click="PickIcon_Click" />
                  <Button Content="{loc:Tr Key='Usuń ikonę'}" Tag="{Binding}" Click="ClearIcon_Click" />
                </StackPanel>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Header="{loc:Tr Key='Punkty'}" Text="{Binding EditPoints, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="{loc:Tr Key='Cel licznika (puste = jednorazowe)'}"
                         Text="{Binding EditTarget, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <CheckBox Content="{loc:Tr Key='Ukryte do odblokowania'}" IsChecked="{Binding EditHidden, Mode=TwoWay}" />
                  <TextBlock Text="{Binding StatsText}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="MoveUp_Click" />
                  <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="MoveDown_Click" />
                  <Button Content="{loc:Tr Key='Testowo odblokuj'}" Tag="{Binding}" Click="TestUnlock_Click" />
                  <Button Content="{loc:Tr Key='Usuń'}" Tag="{Binding}" Click="Remove_Click" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{loc:Tr Key='Zapisz osiągnięcia'}" Style="{StaticResource AccentButtonStyle}"
              Command="{Binding SaveCommand}" Padding="16,8" />
      <Button Content="{loc:Tr Key='Wyzeruj mój postęp'}" Command="{Binding ResetProgressCommand}" Padding="14,8" />
    </StackPanel>

    <Border Style="{StaticResource SectionCard}">
      <StackPanel Spacing="6">
        <TextBlock Text="{loc:Tr Key='Integracja z grą'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock Text="{Binding Help}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
