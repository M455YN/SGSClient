<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.AddStoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="28,24,16,32" RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="{loc:Tr Key='Rozdziały'}" FontSize="18" FontWeight="SemiBold" />

      <Border Grid.Row="1" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <ListView x:Name="ChaptersList" ItemsSource="{x:Bind ViewModel.Chapters}"
                  SelectedItem="{x:Bind ViewModel.SelectedChapter, Mode=TwoWay}">
          <ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Padding="4,8" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Border>

      <StackPanel Grid.Row="2" Spacing="8">
        <Button Content="{loc:Tr Key='+ Dodaj rozdział'}" Click="AddChapter_Click"
                HorizontalAlignment="Stretch" Padding="14,8" />
        <Button x:Name="RemoveChapterButton" Content="{loc:Tr Key='Usuń rozdział'}" Click="RemoveChapter_Click"
                HorizontalAlignment="Stretch" Padding="14,8" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="16,24,28,32" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
        <StackPanel Spacing="6">
          <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
          <TextBlock x:Name="AuthHintText" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
          <StackPanel Spacing="14">
            <TextBlock Text="{loc:Tr Key='Szczegóły'}" FontSize="18" FontWeight="SemiBold" />

            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key='Tytuł opowiadania'}" Opacity="0.55" FontSize="12" />
              <TextBox Text="{x:Bind ViewModel.StoryTitle, Mode=TwoWay}" PlaceholderText="{loc:Tr Key='np. Moja historia'}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key='Opis'}" Opacity="0.55" FontSize="12" />
              <TextBox Text="{x:Bind ViewModel.Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="88" PlaceholderText="{loc:Tr Key='Krótki opis opowiadania'}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key='Tagi (oddzielone przecinkami)'}" Opacity="0.55" FontSize="12" />
              <TextBox Text="{x:Bind ViewModel.Tags, Mode=TwoWay}" PlaceholderText="{loc:Tr Key='np. fantasy, przygoda'}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key='Okładka'}" Opacity="0.55" FontSize="12" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.CoverPath, Mode=OneWay}" IsReadOnly="True"
                         PlaceholderText="{loc:Tr Key='Brak okładki'}" />
                <Button Grid.Column="1" Content="{loc:Tr Key='Wybierz okładkę…'}" Click="PickCover_Click" Padding="12,8" />
                <Button Grid.Column="2" Content="{loc:Tr Key='Importuj z pliku…'}" Click="ImportFile_Click" Padding="12,8" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border x:Name="EditorBorder" Padding="18" CornerRadius="10" Background="#1AFFFFFF"
                BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="Collapsed">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key='Tytuł rozdziału'}" Opacity="0.55" FontSize="12" />
              <TextBox x:Name="ChapterTitleBox" TextChanged="ChapterTitleBox_TextChanged" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Key='Treść rozdziału'}" Opacity="0.55" FontSize="12" />
              <TextBox x:Name="ChapterTextBox" AcceptsReturn="True" TextWrapping="Wrap" FontSize="16"
                       MinHeight="360" PlaceholderText="{loc:Tr Key='Pisz tutaj…'}"
                       TextChanged="ChapterTextBox_TextChanged" />
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Spacing="12">
          <Button x:Name="PublishButton" Content="{loc:Tr Key='Opublikuj'}" Click="Publish_Click"
                  Padding="18,12" Background="#2E7D32" Foreground="White" HorizontalAlignment="Left" />

          <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="{loc:Tr Key='Wysyłanie…'}" Opacity="0.7" />
            <ProgressBar x:Name="PublishProgress" Minimum="0" Maximum="1" Height="8" />
          </StackPanel>

          <TextBlock x:Name="StatusText" Opacity="0.75" TextWrapping="Wrap" />

          <ItemsControl ItemsSource="{x:Bind ViewModel.Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#EF9A9A" Margin="0,0,0,4" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
