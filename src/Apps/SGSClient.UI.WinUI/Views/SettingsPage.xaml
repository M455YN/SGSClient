<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel Margin="28,24,28,32" Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:Tr Key='Wygląd i język'}" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{loc:Tr Key='Motyw'}" />
              <TextBlock Text="{loc:Tr Key='Kolory interfejsu aplikacji.'}" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="180" SelectionChanged="ThemeBox_SelectionChanged" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{loc:Tr Key='Język'}" />
              <TextBlock Text="{loc:Tr Key='Język interfejsu.'}" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox x:Name="LanguageBox" Grid.Column="1" MinWidth="180" SelectionChanged="LanguageBox_SelectionChanged" />
          </Grid>
          <TextBlock x:Name="LanguageHintText" Opacity="0.55" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:Tr Key='Biblioteka'}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="LibrarySummaryText" Opacity="0.8" TextWrapping="Wrap" />
          <ListView x:Name="LibraryFoldersList" MinHeight="120" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="AddLibraryFolderButton" Content="{loc:Tr Key='Dodaj folder…'}" Click="AddLibraryFolder_Click" Padding="14,8" />
            <Button x:Name="RemoveLibraryFolderButton" Content="{loc:Tr Key='Usuń z listy'}" Click="RemoveLibraryFolder_Click" Padding="14,8" />
            <Button Content="{loc:Tr Key='Otwórz folder'}" Click="OpenLibraryFolder_Click" Padding="14,8" />
            <Button x:Name="RescanLibraryButton" Content="{loc:Tr Key='Skanuj ponownie'}" Click="RescanLibrary_Click" Padding="14,8" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:Tr Key='Konto i sklep'}" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{loc:Tr Key='Konto'}" />
            </StackPanel>
            <TextBlock x:Name="AccountStatusText" Grid.Column="1" Opacity="0.85" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{loc:Tr Key='Serwer sklepu'}" />
            </StackPanel>
            <TextBlock x:Name="StoreStatusText" Grid.Column="1" Opacity="0.85" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:Tr Key='O aplikacji'}" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{loc:Tr Key='Wersja'}" />
            </StackPanel>
            <TextBlock x:Name="AboutText" Grid.Column="1" Opacity="0.85" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
          </Grid>
          <TextBlock Text="Szyr Game Studio" Opacity="0.55" FontSize="12" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="StatusText" Opacity="0.7" FontSize="13" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Page>
