<Page
    x:Class="SGSClient.UI.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel Margin="28,24,28,32" Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Dostosuj klienta do siebie." Opacity="0.65" FontSize="13" />
      </StackPanel>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="Wygląd i język" FontSize="18" FontWeight="SemiBold" />
          <StackPanel Spacing="4">
            <TextBlock Text="Motyw" Opacity="0.55" FontSize="12" />
            <TextBlock x:Name="AppearanceText" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Język" Opacity="0.55" FontSize="12" />
            <TextBlock x:Name="LanguageText" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="Konto i sklep" FontSize="18" FontWeight="SemiBold" />
          <StackPanel Spacing="4">
            <TextBlock Text="Konto" Opacity="0.55" FontSize="12" />
            <TextBlock x:Name="AccountStatusText" TextWrapping="Wrap" />
            <TextBlock Text="E-mail z logowania musi być na liście Admin:Emails w API (np. m455yn@outlook.com), żeby pojawił się panel Admin."
                       Opacity="0.45" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Sklep" Opacity="0.55" FontSize="12" />
            <TextBlock x:Name="StoreStatusText" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="Foldery biblioteki" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="LibrarySummaryText" Opacity="0.8" TextWrapping="Wrap" />
          <ListView x:Name="LibraryFoldersList" MinHeight="120" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ContentId}" Opacity="0.5" FontSize="11" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="AddLibraryFolderButton" Content="Dodaj folder…" Click="AddLibraryFolder_Click" Padding="14,8" />
            <Button x:Name="RemoveLibraryFolderButton" Content="Usuń z listy" Click="RemoveLibraryFolder_Click" Padding="14,8" />
            <Button Content="Otwórz folder" Click="OpenLibraryFolder_Click" Padding="14,8" />
            <Button x:Name="RescanLibraryButton" Content="Skanuj ponownie" Click="RescanLibrary_Click" Padding="14,8" />
          </StackPanel>
          <TextBlock Text="Struktura: libraryfolder.json + sgsapps/common/{symbol}/{version}/ + sgsapps/manifests/ (jak Steam libraryfolder.vdf + steamapps)."
                     Opacity="0.5" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="O SGSClient" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="AboutText" Opacity="0.85" />
          <TextBlock Text="Klient gier Szyr Game Studio." Opacity="0.55" FontSize="12" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="StatusText" Opacity="0.7" FontSize="13" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Page>
