<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.WishlistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,24" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="6">
        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Opacity="0.65" FontSize="13" />
      </StackPanel>
      <Button x:Name="LoginButton"
              Grid.Column="1"
              Content="{loc:Tr Key='Zaloguj się'}"
              Click="Login_Click"
              Padding="12,6"
              Margin="0,0,8,0"
              VerticalAlignment="Top"
              Visibility="Collapsed" />
      <Button Grid.Column="2" Content="{loc:Tr Key='Odśwież'}" Click="Refresh_Click" Padding="12,6" VerticalAlignment="Top" />
    </Grid>

    <Grid Grid.Row="1">
      <TextBlock x:Name="EmptyText"
                 Opacity="0.6"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed" />

      <GridView x:Name="GamesGrid"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="GamesGrid_ItemClick">
        <GridView.ItemContainerStyle>
          <Style TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
          <DataTemplate>
            <Border Width="260" Padding="14" CornerRadius="8"
                    Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
              <StackPanel Spacing="10">
                <Border Height="112" CornerRadius="8" Background="#333">
                  <Grid>
                    <TextBlock Text="{Binding TileLabel}" FontWeight="Bold" FontSize="28" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PlatformsText}" Opacity="0.55" FontSize="11" />
                <Button Content="{Binding ActionLabel}"
                        Click="AddToLibrary_Click"
                        Tag="{Binding}"
                        IsEnabled="{Binding CanAdd}"
                        HorizontalAlignment="Stretch"
                        Padding="10,8" />
                <Button Content="{loc:Tr Key='Usuń z listy'}"
                        Click="Remove_Click"
                        Tag="{Binding}"
                        HorizontalAlignment="Stretch"
                        Padding="10,6" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
    </Grid>
  </Grid>
</Page>
