<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.AddMediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel Margin="28,24,28,32" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="DropHintText" Opacity="0.65" TextWrapping="Wrap" />
        <TextBlock x:Name="AuthHintText" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <Border x:Name="DropZone" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"
              MinHeight="140" Padding="24" CornerRadius="10" Background="#1AFFFFFF"
              BorderBrush="#55FFFFFF" BorderThickness="2">
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{loc:Tr Key='Przeciągnij pliki tutaj lub'}" Opacity="0.7" HorizontalAlignment="Center" />
          <Button x:Name="AddFilesButton" Click="AddFiles_Click" Padding="16,8" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <ItemsControl x:Name="EntriesList" ItemsSource="{x:Bind ViewModel.Entries}" Visibility="Collapsed">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="10" CornerRadius="8" Background="#1AFFFFFF">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="72" Height="72" CornerRadius="6" Background="#33FFFFFF"
                        Loaded="Thumb_Loaded" />
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="{loc:Tr Key='Tytuł'}" />
                  <TextBlock Text="{Binding FileName}" Opacity="0.55" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding StateText}" Opacity="0.75" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveEntry_Click"
                        ToolTipService.ToolTip="{loc:Tr Key='Usuń z listy'}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border x:Name="DetailsBorder" Visibility="Collapsed" Padding="18" CornerRadius="10" Background="#1AFFFFFF"
              BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Tagi'}" Opacity="0.55" FontSize="12" />
            <TextBox Text="{x:Bind ViewModel.Tags, Mode=TwoWay}"
                     PlaceholderText="{loc:Tr Key='Tagi oddzielone przecinkami'}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Opis (dla wszystkich)'}" Opacity="0.55" FontSize="12" />
            <TextBox Text="{x:Bind ViewModel.Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="88" />
          </StackPanel>

          <StackPanel x:Name="CoverPanel" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="{loc:Tr Key='Okładka'}" Opacity="0.55" FontSize="12" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="CoverBox" Grid.Column="0" IsReadOnly="True" PlaceholderText="{loc:Tr Key='Brak okładki'}" />
              <Button x:Name="PickCoverButton" Grid.Column="1" Content="{loc:Tr Key='Wybierz okładkę…'}"
                      Click="PickCover_Click" Padding="12,8" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
        <Button x:Name="PublishButton" Content="{loc:Tr Key='Opublikuj'}" Click="Publish_Click"
                Padding="18,12" Background="#2E7D32" Foreground="White" />
        <Button x:Name="ClearButton" Content="{loc:Tr Key='Wyczyść'}" Click="Clear_Click" Padding="14,12" />
      </StackPanel>

      <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock Text="{loc:Tr Key='Wysyłanie…'}" Opacity="0.7" />
        <ProgressBar x:Name="UploadProgress" Minimum="0" Maximum="1" Height="8" />
      </StackPanel>

      <TextBlock x:Name="StatusText" Opacity="0.75" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.Issues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="#EF9A9A" Margin="0,0,0,4" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
