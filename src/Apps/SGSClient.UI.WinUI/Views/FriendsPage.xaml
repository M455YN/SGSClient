<Page
    x:Class="SGSClient.UI.WinUI.Views.FriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SGSClient.UI.WinUI.ViewModels"
    xmlns:local="using:SGSClient.UI.WinUI.Views">

  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <DataTemplate x:Key="PersonRowTemplate" x:DataType="vm:SocialPersonItem">
      <Border Margin="0,0,0,10" Padding="14" CornerRadius="8"
              Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="22" Background="#2A2A2A">
            <TextBlock Text="{Binding Initials}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Content="Akceptuj" Tag="{Binding}" Click="Accept_Click" Padding="10,6"
                    Visibility="{Binding ShowAccept, Converter={StaticResource BoolToVis}}" />
            <Button Content="Dodaj" Tag="{Binding}" Click="AddFriend_Click" Padding="10,6"
                    Visibility="{Binding ShowAddFriend, Converter={StaticResource BoolToVis}}" />
            <Button Content="{Binding RemoveFriendLabel}" Tag="{Binding}" Click="RemoveFriend_Click" Padding="10,6"
                    Visibility="{Binding ShowRemoveFriend, Converter={StaticResource BoolToVis}}" />
            <Button Content="Obserwuj" Tag="{Binding}" Click="Follow_Click" Padding="10,6"
                    Visibility="{Binding ShowFollow, Converter={StaticResource BoolToVis}}" />
            <Button Content="Przestań" Tag="{Binding}" Click="Unfollow_Click" Padding="10,6"
                    Visibility="{Binding ShowUnfollow, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <ScrollViewer>
    <StackPanel Margin="28,24,28,32" Spacing="18" MaxWidth="920" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Text="Znajomi" FontSize="32" FontWeight="Bold" />
        <TextBlock x:Name="StatusText" Opacity="0.7" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>

      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" PlaceholderText="Szukaj gracza po nazwie…" MinHeight="36" />
        <Button Grid.Column="1" Content="Szukaj" Click="Search_Click" Padding="16,8" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button x:Name="TabFriends" Content="Znajomi" Tag="Friends" Click="Tab_Click" Padding="14,8" />
        <Button x:Name="TabRequests" Content="Zaproszenia" Tag="Requests" Click="Tab_Click" Padding="14,8" />
        <Button x:Name="TabFollowing" Content="Obserwowane" Tag="Following" Click="Tab_Click" Padding="14,8" />
        <Button x:Name="TabFollowers" Content="Obserwujący" Tag="Followers" Click="Tab_Click" Padding="14,8" />
        <Button x:Name="TabSearch" Content="Szukaj" Tag="Search" Click="Tab_Click" Padding="14,8" />
      </StackPanel>
      <Border Height="1" Background="#33FFFFFF" />

      <StackPanel x:Name="FriendsPanel" Spacing="8">
        <TextBlock x:Name="EmptyFriendsText" Text="Nie masz jeszcze znajomych. Wyszukaj gracza po nazwie."
                   Opacity="0.6" TextWrapping="Wrap" />
        <ItemsControl x:Name="FriendsList" ItemTemplate="{StaticResource PersonRowTemplate}" />
      </StackPanel>

      <StackPanel x:Name="RequestsPanel" Spacing="14" Visibility="Collapsed">
        <StackPanel Spacing="8">
          <TextBlock Text="Do Ciebie" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="EmptyIncomingText" Text="Brak nowych zaproszeń." Opacity="0.6" />
          <ItemsControl x:Name="IncomingList" ItemTemplate="{StaticResource PersonRowTemplate}" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="Wysłane" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="EmptyOutgoingText" Text="Nie czekasz na żadną odpowiedź." Opacity="0.6" />
          <ItemsControl x:Name="OutgoingList" ItemTemplate="{StaticResource PersonRowTemplate}" />
        </StackPanel>
      </StackPanel>

      <StackPanel x:Name="FollowingPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock x:Name="EmptyFollowingText" Text="Nikogo nie obserwujesz." Opacity="0.6" />
        <ItemsControl x:Name="FollowingList" ItemTemplate="{StaticResource PersonRowTemplate}" />
      </StackPanel>

      <StackPanel x:Name="FollowersPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock x:Name="EmptyFollowersText" Text="Nikt Cię jeszcze nie obserwuje." Opacity="0.6" />
        <ItemsControl x:Name="FollowersList" ItemTemplate="{StaticResource PersonRowTemplate}" />
      </StackPanel>

      <StackPanel x:Name="SearchPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock x:Name="EmptySearchText" Text="Wpisz nazwę i naciśnij Szukaj." Opacity="0.6" />
        <ItemsControl x:Name="SearchList" ItemTemplate="{StaticResource PersonRowTemplate}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
