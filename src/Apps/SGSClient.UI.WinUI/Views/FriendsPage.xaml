<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.FriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SGSClient.UI.ViewModels"
    xmlns:local="using:SGSClient.UI.WinUI.Views"
    Background="Transparent">

  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="BoolToVisInv" />

    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="CompactAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="CloseGlyphButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="SocialListItem" TargetType="ListViewItem">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <DataTemplate x:Key="PersonRowTemplate" x:DataType="vm:SocialPersonItem">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Background="Transparent" BorderThickness="0" Padding="0" Tag="{Binding}"
                Click="OpenProfile_Click" ToolTipService.ToolTip="Otwórz profil">
          <Grid Width="40" Height="40">
            <PersonPicture Width="36" Height="36" DisplayName="{Binding DisplayName}" Initials="{Binding Initials}" />
            <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Fill="{ThemeResource SystemFillColorSuccessBrush}"
                     Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2"
                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
            <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                     Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="2"
                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisInv}}" />
          </Grid>
        </Button>
        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Tag="{Binding}" Click="OpenProfile_Click">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Content="{loc:Tr Key='Napisz'}" Tag="{Binding}" Click="Message_Click" Style="{StaticResource CompactButton}"
                  Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVis}}" />
          <Button Content="{loc:Tr Key='Akceptuj'}" Tag="{Binding}" Click="Accept_Click" Style="{StaticResource CompactAccentButton}"
                  Visibility="{Binding ShowAccept, Converter={StaticResource BoolToVis}}" />
          <Button Content="{loc:Tr Key='Dodaj'}" Tag="{Binding}" Click="AddFriend_Click" Style="{StaticResource CompactAccentButton}"
                  Visibility="{Binding ShowAddFriend, Converter={StaticResource BoolToVis}}" />
          <Button Content="{Binding RemoveFriendLabel}" Tag="{Binding}" Click="RemoveFriend_Click" Style="{StaticResource CompactButton}"
                  Visibility="{Binding ShowRemoveFriend, Converter={StaticResource BoolToVis}}" />
          <Button Content="{loc:Tr Key='Obserwuj'}" Tag="{Binding}" Click="Follow_Click" Style="{StaticResource CompactButton}"
                  Visibility="{Binding ShowFollow, Converter={StaticResource BoolToVis}}" />
          <Button Content="{loc:Tr Key='Przestań'}" Tag="{Binding}" Click="Unfollow_Click" Style="{StaticResource CompactButton}"
                  Visibility="{Binding ShowUnfollow, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProfileCommentTemplate" x:DataType="vm:ProfileCommentItem">
      <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding AuthorLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="{Binding WhenText}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Content="{loc:Tr Key='Usuń'}" Tag="{Binding}" Click="DeleteComment_Click"
                  Style="{StaticResource CompactButton}" VerticalAlignment="Top"
                  Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ChatThreadTemplate" x:DataType="vm:ChatThreadItem">
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Padding="8,6" Margin="0,0,0,4" Tag="{Binding}" Click="OpenThread_Click">
        <StackPanel Spacing="2">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding UnreadBadge}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Grid>
          <TextBlock Text="{Binding Preview}" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="ChatMessageTemplate" x:DataType="vm:ChatMessageItem">
      <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8" MaxWidth="280"
              HorizontalAlignment="Left"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Meta}" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" />
          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid Padding="16,12,12,12" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <SelectorBar x:Name="SocialTabs" Grid.Column="0" SelectionChanged="SocialTabs_SelectionChanged">
        <SelectorBarItem x:Name="TabProfile" Tag="Profile" Text="{loc:Tr Key='Profil'}" Icon="Contact" />
        <SelectorBarItem x:Name="TabFriends" Tag="Friends" Text="{loc:Tr Key='Znajomi'}" Icon="People" IsSelected="True" />
        <SelectorBarItem x:Name="TabChat" Tag="Chat" Text="{loc:Tr Key='Czat'}" Icon="Message" />
        <SelectorBarItem x:Name="TabSearch" Tag="Search" Text="{loc:Tr Key='Dodaj'}" Icon="AddFriend" />
      </SelectorBar>
      <Button Grid.Column="1" VerticalAlignment="Center"
              Style="{StaticResource CloseGlyphButton}"
              Click="Close_Click" ToolTipService.ToolTip="Zamknij">
        <FontIcon Glyph="&#xE711;" FontSize="12" />
      </Button>
    </Grid>

    <TextBlock Grid.Row="1" Text="{loc:Tr Key='Społeczność'}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="4,4,4,0" />

    <AutoSuggestBox x:Name="SearchBox" Grid.Row="2" QueryIcon="Find"
                    PlaceholderText="{loc:Tr Key='Szukaj znajomych'}"
                    QuerySubmitted="Search_QuerySubmitted"
                    TextChanged="Search_TextChanged" />

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <!-- Public profile + wall -->
        <StackPanel x:Name="ProfilePanel" Spacing="10" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Tr Key='← Wróć'}" Click="CloseProfile_Click" Style="{StaticResource CompactButton}" />
            <Button x:Name="MessageFromProfileButton" Content="{loc:Tr Key='Napisz wiadomość'}"
                    Click="MessageFromProfile_Click" Style="{StaticResource CompactAccentButton}" />
          </StackPanel>
          <TextBlock x:Name="ProfileHeaderText" Style="{StaticResource TitleTextBlockStyle}" />
          <TextBlock x:Name="ProfileSubtitleText" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="{loc:Tr Key='Ściana'}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
          <TextBox x:Name="ProfileCommentBox" PlaceholderText="{loc:Tr Key='Podpisz się pod profilem…'}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                   TextChanged="ProfileCommentBox_TextChanged" />
          <Button Content="{loc:Tr Key='Dodaj podpis'}" Style="{StaticResource CompactAccentButton}"
                  Click="PostComment_Click" HorizontalAlignment="Left" />
          <TextBlock x:Name="ProfileStatusText" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <ItemsControl x:Name="ProfileCommentsList" ItemTemplate="{StaticResource ProfileCommentTemplate}" />
        </StackPanel>

        <!-- Chat -->
        <Grid x:Name="ChatPanel" MinHeight="320" ColumnSpacing="10" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Key='Rozmowy'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="ChatStatusText" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="EmptyChatText" Text="{loc:Tr Key='Brak rozmów.'}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ItemsControl x:Name="ChatThreadsList" ItemTemplate="{StaticResource ChatThreadTemplate}" />
          </StackPanel>
          <StackPanel x:Name="ChatConversationPanel" Grid.Column="1" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="ChatPeerTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" />
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ChatMessagesList" ItemTemplate="{StaticResource ChatMessageTemplate}" />
            </ScrollViewer>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ChatDraftBox" PlaceholderText="{loc:Tr Key='Wiadomość…'}"
                       KeyDown="ChatDraft_KeyDown" TextChanged="ChatDraftBox_TextChanged" />
              <Button Grid.Column="1" Content="{loc:Tr Key='Wyślij'}" Style="{StaticResource AccentButtonStyle}"
                      Click="SendChat_Click" />
            </Grid>
          </StackPanel>
        </Grid>

        <StackPanel x:Name="FriendsPanel" Spacing="8">
          <TextBlock x:Name="EmptyFriendsText" Text="{loc:Tr Key='Nie masz jeszcze znajomych. Wpisz nazwę lub @tag, żeby kogoś znaleźć.'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

          <Expander x:Name="IncomingExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Expanding="IncomingExpander_Expanding" Collapsed="IncomingExpander_Collapsed">
            <Expander.Header>
              <Grid>
                <TextBlock Text="{loc:Tr Key='Zaproszenia'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <InfoBadge x:Name="IncomingBadge" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </Expander.Header>
            <ListView x:Name="IncomingList" ItemTemplate="{StaticResource PersonRowTemplate}"
                      ItemContainerStyle="{StaticResource SocialListItem}"
                      SelectionMode="None" IsItemClickEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled" />
          </Expander>

          <Expander x:Name="OnlineExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Expanding="OnlineExpander_Expanding" Collapsed="OnlineExpander_Collapsed">
            <Expander.Header>
              <Grid>
                <TextBlock Text="Online" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <InfoBadge x:Name="OnlineBadge" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </Expander.Header>
            <ListView x:Name="OnlineList" ItemTemplate="{StaticResource PersonRowTemplate}"
                      ItemContainerStyle="{StaticResource SocialListItem}"
                      SelectionMode="None" IsItemClickEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled" />
          </Expander>

          <Expander x:Name="OfflineExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Expanding="OfflineExpander_Expanding" Collapsed="OfflineExpander_Collapsed">
            <Expander.Header>
              <Grid>
                <TextBlock Text="Offline" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <InfoBadge x:Name="OfflineBadge" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </Expander.Header>
            <ListView x:Name="OfflineList" ItemTemplate="{StaticResource PersonRowTemplate}"
                      ItemContainerStyle="{StaticResource SocialListItem}"
                      SelectionMode="None" IsItemClickEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled" />
          </Expander>
        </StackPanel>

        <StackPanel x:Name="RequestsPanel" Spacing="8" Visibility="Collapsed">
          <TextBlock Text="{loc:Tr Key='Do Ciebie'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock x:Name="EmptyIncomingText" Text="{loc:Tr Key='Brak nowych zaproszeń.'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <ListView x:Name="IncomingListAlt" ItemTemplate="{StaticResource PersonRowTemplate}"
                    ItemContainerStyle="{StaticResource SocialListItem}"
                    SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
          <TextBlock Text="{loc:Tr Key='Wysłane'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock x:Name="EmptyOutgoingText" Text="{loc:Tr Key='Nie czekasz na żadną odpowiedź.'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <ListView x:Name="OutgoingList" ItemTemplate="{StaticResource PersonRowTemplate}"
                    ItemContainerStyle="{StaticResource SocialListItem}"
                    SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
        </StackPanel>

        <StackPanel x:Name="FollowingPanel" Spacing="8" Visibility="Collapsed">
          <TextBlock Text="{loc:Tr Key='Obserwowane'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock x:Name="EmptyFollowingText" Text="{loc:Tr Key='Nikogo nie obserwujesz.'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <ListView x:Name="FollowingList" ItemTemplate="{StaticResource PersonRowTemplate}"
                    ItemContainerStyle="{StaticResource SocialListItem}"
                    SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
        </StackPanel>

        <StackPanel x:Name="FollowersPanel" Spacing="8" Visibility="Collapsed">
          <TextBlock Text="{loc:Tr Key='Obserwujący'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock x:Name="EmptyFollowersText" Text="{loc:Tr Key='Nikt Cię jeszcze nie obserwuje.'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <ListView x:Name="FollowersList" ItemTemplate="{StaticResource PersonRowTemplate}"
                    ItemContainerStyle="{StaticResource SocialListItem}"
                    SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
        </StackPanel>

        <StackPanel x:Name="SearchPanel" Spacing="8" Visibility="Collapsed">
          <TextBlock x:Name="EmptySearchText" Text="{loc:Tr Key='Wpisz nazwę lub @tag i naciśnij Enter.'}"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <ListView x:Name="SearchList" ItemTemplate="{StaticResource PersonRowTemplate}"
                    ItemContainerStyle="{StaticResource SocialListItem}"
                    SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
