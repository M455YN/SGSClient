<Page
    x:Class="SGSClient.UI.WinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SGSClient.UI.ViewModels"
    xmlns:local="using:SGSClient.UI.WinUI.Views"
    Background="Transparent">

  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="BoolToVisInv" />

    <Style x:Key="RailItem" TargetType="ListViewItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuickActionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <DataTemplate x:Key="PosterTemplate" x:DataType="vm:HomeGameCard">
      <Border Width="168" Height="248" CornerRadius="8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid>
          <TextBlock Text="{Binding TileLabel}"
                     FontSize="28" FontWeight="SemiBold" Opacity="0.28"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding HasCover, Converter={StaticResource BoolToVisInv}}" />
          <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"
                 Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
          <Border VerticalAlignment="Bottom" Padding="12,10"
                  Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Caption}"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="WideCardTemplate" x:DataType="vm:HomeGameCard">
      <!-- Image slot 240×112 ≈ 920∶430 landscape -->
      <Border Width="240" CornerRadius="8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="{Binding TileLabel}"
                       FontSize="28" FontWeight="SemiBold" Opacity="0.28"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasCover, Converter={StaticResource BoolToVisInv}}" />
            <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"
                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
          </Grid>
          <StackPanel Grid.Row="1" Padding="12,10" Spacing="2"
                      Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Blurb}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid x:Name="HeroBackdropHost"
          Visibility="{Binding HasHero, Converter={StaticResource BoolToVis}}" />
    <Border Background="#C0101014" IsHitTestVisible="False" />

    <ProgressBar VerticalAlignment="Top" Height="3"
                 IsIndeterminate="True"
                 ShowPaused="False"
                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
      <StackPanel Margin="32,24,32,40" Spacing="28">

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding DateText}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding Greeting}"
                       Style="{StaticResource TitleTextBlockStyle}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border CornerRadius="8" Padding="16,10" MinWidth="104"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{Binding LibraryCountText}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="W bibliotece"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="16,10" MinWidth="104"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{Binding InstalledCountText}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Zainstalowane"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="16,10" MinWidth="104"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{Binding CatalogCountText}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="W sklepie"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <InfoBar IsOpen="{Binding HasError}"
                 Severity="Error"
                 IsClosable="False"
                 Title="Katalog"
                 Message="{Binding StatusText}" />

        <StackPanel Spacing="10" Visibility="{Binding HasHero, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="WYRÓŻNIONE I POLECANE"
                     FontSize="11" FontWeight="SemiBold" Opacity="0.7"
                     CharacterSpacing="80" />
          <Grid Height="340" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Width="28" Height="48" VerticalAlignment="Center" Padding="0"
                    Click="PreviousSlide_Click"
                    Visibility="{Binding HasMultipleSlides, Converter={StaticResource BoolToVis}}">
              <FontIcon Glyph="&#xE76B;" FontSize="12" />
            </Button>
            <Grid x:Name="HeroClip" Grid.Column="1">
            <Border x:Name="HeroCapsule" CornerRadius="4" Tapped="OpenHero_Tapped"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBlock Text="{Binding Hero.TileLabel}"
                             FontSize="72" FontWeight="SemiBold" Opacity="0.16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding Hero.HasCover, Converter={StaticResource BoolToVisInv}}" />
                  <Rectangle Visibility="{Binding Hero.HasCover, Converter={StaticResource BoolToVis}}">
                    <Rectangle.Fill>
                      <ImageBrush ImageSource="{Binding Hero.CoverImageUrl}" Stretch="UniformToFill" />
                    </Rectangle.Fill>
                  </Rectangle>
                  <Border VerticalAlignment="Bottom" Height="120">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#CC000000" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding Hero.Title}" Margin="24,0,16,18"
                               VerticalAlignment="Bottom" FontSize="28" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis" />
                  </Border>
                </Grid>
                <Border Grid.Column="1" Padding="16,14"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                  <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Hero.Title}" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                    <Grid Grid.Row="1"
                          Visibility="{Binding Hero.HasShots, Converter={StaticResource BoolToVis}}">
                      <Grid ColumnSpacing="6" RowSpacing="6"
                            Visibility="{Binding Hero.ShotLayout1, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                          <Rectangle>
                            <Rectangle.Fill>
                              <ImageBrush ImageSource="{Binding Hero.Shot1}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                          </Rectangle>
                        </Border>
                      </Grid>
                      <Grid ColumnSpacing="6"
                            Visibility="{Binding Hero.ShotLayout2, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                          <Rectangle>
                            <Rectangle.Fill>
                              <ImageBrush ImageSource="{Binding Hero.Shot1}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                          </Rectangle>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                          <Rectangle>
                            <Rectangle.Fill>
                              <ImageBrush ImageSource="{Binding Hero.Shot2}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                          </Rectangle>
                        </Border>
                      </Grid>
                      <Grid ColumnSpacing="6" RowSpacing="6"
                            Visibility="{Binding Hero.ShotLayout3, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="*" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border CornerRadius="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                          <Rectangle>
                            <Rectangle.Fill>
                              <ImageBrush ImageSource="{Binding Hero.Shot1}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                          </Rectangle>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                          <Rectangle>
                            <Rectangle.Fill>
                              <ImageBrush ImageSource="{Binding Hero.Shot2}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                          </Rectangle>
                        </Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                          <Rectangle>
                            <Rectangle.Fill>
                              <ImageBrush ImageSource="{Binding Hero.Shot3}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                          </Rectangle>
                        </Border>
                      </Grid>
                      <Grid ColumnSpacing="6" RowSpacing="6"
                            Visibility="{Binding Hero.ShotLayout4, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="*" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border CornerRadius="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                          <Rectangle>
                            <Rectangle.Fill>
                              <ImageBrush ImageSource="{Binding Hero.Shot1}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                          </Rectangle>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                          <Rectangle>
                            <Rectangle.Fill>
                              <ImageBrush ImageSource="{Binding Hero.Shot2}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                          </Rectangle>
                        </Border>
                        <Border Grid.Row="1" CornerRadius="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                          <Rectangle>
                            <Rectangle.Fill>
                              <ImageBrush ImageSource="{Binding Hero.Shot3}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                          </Rectangle>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                          <Rectangle>
                            <Rectangle.Fill>
                              <ImageBrush ImageSource="{Binding Hero.Shot4}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                          </Rectangle>
                        </Border>
                      </Grid>
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="8">
                      <TextBlock Text="{Binding Hero.ReleaseLine}" FontSize="13" Opacity="0.85"
                                 TextTrimming="CharacterEllipsis" />
                      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" CornerRadius="2" Padding="8,3"
                              HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Hero.BadgeText}" FontSize="11" Opacity="0.8" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
            </Grid>
            <Button Grid.Column="2" Width="28" Height="48" VerticalAlignment="Center" Padding="0"
                    Click="NextSlide_Click"
                    Visibility="{Binding HasMultipleSlides, Converter={StaticResource BoolToVis}}">
              <FontIcon Glyph="&#xE76C;" FontSize="12" />
            </Button>
          </Grid>
          <ItemsControl ItemsSource="{Binding FeaturedDots}" HorizontalAlignment="Center"
                        Visibility="{Binding HasMultipleSlides, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FeaturedSlideDot">
                <Grid Width="28" Height="16" Tag="{Binding Index}" Tapped="Dot_Tapped">
                  <Border Width="22" Height="5" CornerRadius="1"
                          Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVisInv}}" />
                  <Border Width="22" Height="5" CornerRadius="1"
                          Background="{ThemeResource AccentFillColorDefaultBrush}"
                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid x:Name="QuickActionsGrid" ColumnSpacing="12"
              Visibility="{Binding HasHero, Converter={StaticResource BoolToVisInv}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="PublishColumn" Width="*" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource QuickActionButton}" Click="OpenStore_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE719;" FontSize="20" />
              <StackPanel>
                <TextBlock Text="Sklep" FontWeight="SemiBold" />
                <TextBlock Text="Przeglądaj katalog"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource QuickActionButton}" Click="OpenLibrary_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE8F1;" FontSize="20" />
              <StackPanel>
                <TextBlock Text="Biblioteka" FontWeight="SemiBold" />
                <TextBlock Text="Twoje gry"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Style="{StaticResource QuickActionButton}" Click="OpenFriends_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE716;" FontSize="20" />
              <StackPanel>
                <TextBlock Text="Znajomi" FontWeight="SemiBold" />
                <TextBlock Text="Panel społecznościowy"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Style="{StaticResource QuickActionButton}" Click="OpenPublish_Click"
                  Visibility="{Binding CanPublish, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE898;" FontSize="20" />
              <StackPanel>
                <TextBlock Text="Panel twórcy" FontWeight="SemiBold" />
                <TextBlock Text="Twoje gry i wydania"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Button>
        </Grid>

        <StackPanel Spacing="12" Visibility="{Binding HasContinue, Converter={StaticResource BoolToVis}}">
          <Grid>
            <TextBlock Text="Kontynuuj" Style="{StaticResource SubtitleTextBlockStyle}" />
            <HyperlinkButton Content="Biblioteka"
                             Click="OpenLibrary_Click"
                             HorizontalAlignment="Right"
                             Padding="8,4" />
          </Grid>
          <ListView ItemsSource="{Binding ContinuePlaying}"
                    ItemTemplate="{StaticResource PosterTemplate}"
                    ItemContainerStyle="{StaticResource RailItem}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Rail_ItemClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
          </ListView>
        </StackPanel>

        <StackPanel Spacing="12" Visibility="{Binding HasReadyToInstall, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Gotowe do instalacji" Style="{StaticResource SubtitleTextBlockStyle}" />
          <ListView ItemsSource="{Binding ReadyToInstall}"
                    ItemTemplate="{StaticResource PosterTemplate}"
                    ItemContainerStyle="{StaticResource RailItem}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Rail_ItemClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
          </ListView>
        </StackPanel>

        <StackPanel Spacing="12" Visibility="{Binding HasFeatured, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Wyróżnione" Style="{StaticResource SubtitleTextBlockStyle}" />
          <ListView ItemsSource="{Binding Featured}"
                    ItemTemplate="{StaticResource WideCardTemplate}"
                    ItemContainerStyle="{StaticResource RailItem}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Rail_ItemClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
          </ListView>
        </StackPanel>

        <StackPanel Spacing="12" Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Kategorie" Style="{StaticResource SubtitleTextBlockStyle}" />
          <ListView ItemsSource="{Binding Categories}"
                    ItemContainerStyle="{StaticResource RailItem}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Category_ItemClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:HomeCategoryItem">
                <Border Width="196" Height="88" CornerRadius="8" Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                      <TextBlock Text="{Binding Initial}"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding CountText}"
                                 Style="{StaticResource CaptionTextBlockStyle}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>

        <StackPanel Spacing="12" Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVis}}">
          <Grid>
            <TextBlock Text="Nowe w sklepie" Style="{StaticResource SubtitleTextBlockStyle}" />
            <HyperlinkButton Content="Sklep"
                             Click="OpenStore_Click"
                             HorizontalAlignment="Right"
                             Padding="8,4" />
          </Grid>
          <ListView ItemsSource="{Binding Catalog}"
                    ItemTemplate="{StaticResource WideCardTemplate}"
                    ItemContainerStyle="{StaticResource RailItem}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Rail_ItemClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
          </ListView>
        </StackPanel>

        <StackPanel Spacing="12"
                    HorizontalAlignment="Left"
                    MaxWidth="480"
                    Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Nic tu jeszcze nie ma"
                     Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="Dodaj gry ze sklepu albo uruchom Api, żeby zobaczyć wyróżnione tytuły."
                     Style="{StaticResource BodyTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />
          <Button Content="Przeglądaj sklep"
                  Click="OpenStore_Click"
                  Style="{StaticResource AccentButtonStyle}"
                  HorizontalAlignment="Left"
                  Padding="16,8" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
