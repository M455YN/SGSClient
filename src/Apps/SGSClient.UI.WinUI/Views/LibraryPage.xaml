<Page
    x:Class="SGSClient.UI.WinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="28,24" RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="6">
        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Opacity="0.65" FontSize="13" />
      </StackPanel>
      <Button Grid.Column="1" Content="Odśwież" Click="Refresh_Click" Padding="12,6" VerticalAlignment="Top" />
    </Grid>

    <Grid Grid.Row="1">
      <TextBlock x:Name="EmptyText"
                 Opacity="0.6"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed" />

      <ListView x:Name="GamesList"
                SelectionMode="None"
                IsItemClickEnabled="False">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,12" Padding="14" CornerRadius="8"
                    Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="8" Background="#333">
                  <TextBlock Text="{Binding TileLabel}" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
                  <TextBlock Opacity="0.65" FontSize="12">
                    <Run Text="{Binding PlatformText}" />
                    <Run Text=" · " />
                    <Run Text="{Binding VersionText}" />
                  </TextBlock>
                  <TextBlock Text="{Binding StateText}" Opacity="0.7" FontSize="12" />
                  <TextBlock Text="{Binding LastPlayedText}" Opacity="0.5" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="Graj" Click="Launch_Click" Tag="{Binding}"
                          IsEnabled="{Binding CanLaunch}" Padding="12,8" />
                  <Button Content="Usuń" Click="Remove_Click" Tag="{Binding}" Padding="12,8" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</Page>
