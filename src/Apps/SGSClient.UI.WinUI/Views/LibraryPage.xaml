<Page
    x:Class="SGSClient.UI.WinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="16,16,16,8" Spacing="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Biblioteka"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Click="Refresh_Click"
                    ToolTipService.ToolTip="Odśwież"
                    Style="{StaticResource SubtleButtonStyle}">
              <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
          </Grid>

          <AutoSuggestBox x:Name="SearchBox"
                          PlaceholderText="Szukaj w bibliotece"
                          QueryIcon="Find"
                          TextChanged="Search_TextChanged" />

          <Button HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Click="Home_Click"
                  Style="{StaticResource SubtleButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE80F;" FontSize="16" />
              <TextBlock Text="Strona główna" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <ListView x:Name="SidebarList"
                  Grid.Row="1"
                  SelectionMode="Single"
                  SelectionChanged="Sidebar_SelectionChanged"
                  Background="Transparent"
                  BorderThickness="0"
                  IsItemClickEnabled="False">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid ColumnSpacing="12" Padding="4,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid>
                    <TextBlock Text="{Binding TileLabel}"
                               FontWeight="SemiBold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Title}"
                             TextTrimming="CharacterEllipsis"
                             Style="{StaticResource BodyTextBlockStyle}" />
                  <TextBlock Text="{Binding StateText}"
                             TextTrimming="CharacterEllipsis"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="SidebarStatus"
                   Grid.Row="2"
                   Margin="16,8,16,12"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1" Padding="0">
      <TextBlock x:Name="EmptyText"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Style="{StaticResource BodyStrongTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Visibility="Collapsed" />

      <ScrollViewer x:Name="HomeScroll" Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,32" Spacing="28">
          <StackPanel x:Name="RecentPanel" Spacing="12" Visibility="Collapsed">
            <TextBlock Text="Niedawne gry" Style="{StaticResource SubtitleTextBlockStyle}" />
            <GridView x:Name="RecentList"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="Poster_ItemClick">
              <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                  <Setter Property="Margin" Value="0,0,12,12" />
                </Style>
              </GridView.ItemContainerStyle>
              <GridView.ItemTemplate>
                <DataTemplate>
                  <Border Width="168" Height="268" CornerRadius="8"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">
                    <Grid>
                      <TextBlock Text="{Binding TileLabel}"
                                 FontSize="32" FontWeight="SemiBold" Opacity="0.35"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill" />
                      <Border VerticalAlignment="Bottom" Padding="12,10"
                              Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding LastPlayedText}"
                                     Style="{StaticResource CaptionTextBlockStyle}"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                          <TextBlock Text="{Binding PlaytimeText}"
                                     Style="{StaticResource CaptionTextBlockStyle}"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </GridView.ItemTemplate>
            </GridView>
          </StackPanel>

          <StackPanel Spacing="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="AllGamesHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
              <TextBlock Grid.Column="1"
                         Text="Sortuj: alfabetycznie"
                         VerticalAlignment="Center"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <GridView x:Name="AllGamesList"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="Poster_ItemClick">
              <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                  <Setter Property="Margin" Value="0,0,12,12" />
                </Style>
              </GridView.ItemContainerStyle>
              <GridView.ItemTemplate>
                <DataTemplate>
                  <Border Width="132" Height="198" CornerRadius="8"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">
                    <Grid>
                      <TextBlock Text="{Binding TileLabel}"
                                 FontSize="26" FontWeight="SemiBold" Opacity="0.35"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill" />
                      <Border VerticalAlignment="Bottom" Padding="8,8"
                              Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </GridView.ItemTemplate>
            </GridView>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
