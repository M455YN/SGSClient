<Page xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.UserProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SGSClient.UI.ViewModels"
    xmlns:local="using:SGSClient.UI.WinUI.Views">

  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="BoolToVisInv" />

    <Style x:Key="ProfileCard" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CountPill" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1100" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RailColumn.Width" Value="0" />
            <Setter Target="BodyGrid.ColumnSpacing" Value="0" />
            <Setter Target="RightRail.(Grid.Column)" Value="0" />
            <Setter Target="RightRail.(Grid.Row)" Value="1" />
            <Setter Target="RightRail.Margin" Value="0,16,0,0" />
            <Setter Target="HeroActions.(Grid.Column)" Value="1" />
            <Setter Target="HeroActions.(Grid.Row)" Value="1" />
            <Setter Target="HeroActions.HorizontalAlignment" Value="Left" />
            <Setter Target="HeroActions.Margin" Value="0,16,0,0" />
            <Setter Target="HeroGrid.Height" Value="280" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <ScrollViewer>
      <StackPanel MaxWidth="1280" Padding="28,24,28,40" Spacing="16">
        <InfoBar Severity="Error" IsClosable="False" Message="{Binding ErrorText}"
                 IsOpen="{Binding HasError}" />

        <!-- Hero: avatar, name, presence, bio, relation actions -->
        <Grid x:Name="HeroGrid" CornerRadius="12" Height="220"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Rectangle>
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{ThemeResource SystemAccentColorDark2}" Offset="0" />
                <GradientStop Color="{ThemeResource SystemAccentColorDark3}" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <Image x:Name="BannerImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Rectangle Opacity="0.88">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="0" />
                <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="0.35" />
                <GradientStop Color="Transparent" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

          <Grid Padding="28" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid VerticalAlignment="Center">
              <PersonPicture x:Name="AvatarPicture" Width="128" Height="128"
                             DisplayName="{Binding DisplayName}" Initials="{Binding Initials}" />
              <Ellipse Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                       Fill="{ThemeResource SystemFillColorSuccessBrush}"
                       Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="3"
                       Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MaxWidth="680" HorizontalAlignment="Left">
              <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TitleTextBlockStyle}"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding PlayerTagDisplay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Grid>
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}"
                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorNeutralBrush}"
                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisInv}}" />
                  </Grid>
                  <TextBlock Text="{Binding PresenceText}" Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{Binding Bio}" TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis"
                         Margin="0,6,0,0" IsTextSelectionEnabled="True" />
              <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6"
                            Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}">
                  <FontIcon Glyph="&#xE707;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Text="{Binding Location}" Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Text="{Binding MemberSinceText}" Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="HeroActions" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Top" HorizontalAlignment="Right">
              <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding MessageCommand}" Padding="14,7"
                      Visibility="{Binding Person.ShowMessage, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                  <TextBlock Text="{loc:Tr Key='Napisz'}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding AddFriendCommand}" Padding="14,7"
                      Visibility="{Binding Person.ShowAddFriend, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                  <TextBlock Text="{loc:Tr Key='Dodaj do znajomych'}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding AcceptFriendCommand}" Padding="14,7"
                      Content="{loc:Tr Key='Akceptuj zaproszenie'}"
                      Visibility="{Binding Person.ShowAccept, Converter={StaticResource BoolToVis}}" />
              <Button Command="{Binding FollowCommand}" Padding="14,7" Content="{loc:Tr Key='Obserwuj'}"
                      Visibility="{Binding Person.ShowFollow, Converter={StaticResource BoolToVis}}" />
              <Button Command="{Binding UnfollowCommand}" Padding="14,7" Content="{loc:Tr Key='Przestań obserwować'}"
                      Visibility="{Binding Person.ShowUnfollow, Converter={StaticResource BoolToVis}}" />
              <Button Padding="10,7" ToolTipService.ToolTip="{loc:Tr Key='Więcej'}" AutomationProperties.Name="{loc:Tr Key='Więcej'}"
                      Visibility="{Binding Person.ShowRemoveFriend, Converter={StaticResource BoolToVis}}">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuFlyoutItem x:Name="RemoveFriendItem" Click="RemoveFriend_Click">
                      <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8F8;" />
                      </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- Stats strip -->
        <Border Style="{StaticResource ProfileCard}" Padding="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Center" Padding="8,14">
              <TextBlock Text="{Binding GamesCount}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Tr Key='Gry'}" Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
              <StackPanel HorizontalAlignment="Center" Padding="8,14">
                <TextBlock Text="{Binding TotalPlaytimeText}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Key='Czas gry'}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center" Padding="8,14">
              <TextBlock Text="{Binding AchievementsUnlocked}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Tr Key='Osiągnięcia'}" Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            </Border>
            <Border Grid.Column="3" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
              <StackPanel HorizontalAlignment="Center" Padding="8,14">
                <TextBlock Text="{Binding AchievementPoints}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Key='Punkty'}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
              <StackPanel HorizontalAlignment="Center" Padding="8,14">
                <TextBlock Text="{Binding Comments.Count}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Key='Komentarze'}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid x:Name="BodyGrid" ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RailColumn" Width="340" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>


          <!-- Main column: recent activity, comments -->
          <StackPanel Spacing="16">
            <Grid>
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Key='Ostatnia aktywność'}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{Binding TotalPlaytimeText}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding RecentActivity}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentGameItem">
                  <Border Style="{StaticResource ProfileCard}" Padding="16">
                    <Grid ColumnSpacing="20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Height="94" CornerRadius="6" VerticalAlignment="Top"
                              Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                          <TextBlock Text="{Binding TileLabel}" Style="{StaticResource SubtitleTextBlockStyle}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding HasHeader, Converter={StaticResource BoolToVisInv}}" />
                          <Image Source="{Binding HeaderImageUrl}" Stretch="UniformToFill"
                                 Visibility="{Binding HasHeader, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <Grid>
                          <HyperlinkButton Content="{Binding Title}" Tag="{Binding}" Click="OpenGame_Click"
                                           Padding="0" FontWeight="SemiBold" FontSize="16"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                          <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource CaptionTextBlockStyle}"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding PlaytimeText}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid Margin="0,10,0,0" RowSpacing="6"
                              Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Text="{loc:Tr Key='Postęp osiągnięć'}" Style="{StaticResource CaptionTextBlockStyle}" />
                          <TextBlock Text="{Binding Achievements.ProgressText}" Style="{StaticResource CaptionTextBlockStyle}"
                                     HorizontalAlignment="Right" />
                          <ProgressBar Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding Achievements.Fraction}" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource ProfileCard}" Padding="28"
                    Visibility="{Binding HasGames, Converter={StaticResource BoolToVisInv}}">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7FC;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding GamesText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

          <Border Style="{StaticResource ProfileCard}" VerticalAlignment="Top">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{loc:Tr Key='Komentarze'}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource CountPill}">
                  <TextBlock Text="{Binding Comments.Count}" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
              </StackPanel>
              <TextBox x:Name="CommentBox" PlaceholderText="{loc:Tr Key='Dodaj komentarz…'}"
                       Text="{Binding CommentDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxLength="1000" />
              <Button Content="{loc:Tr Key='Opublikuj'}" Style="{StaticResource AccentButtonStyle}"
                      HorizontalAlignment="Right" MinWidth="96" Command="{Binding PostCommentCommand}" />
              <TextBlock Text="{Binding CommentStatus}" Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <ItemsControl ItemsSource="{Binding Comments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileCommentItem">
                    <Grid Padding="0,12" ColumnSpacing="12" BorderThickness="0,1,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <PersonPicture Width="32" Height="32" VerticalAlignment="Top"
                                     DisplayName="{Binding AuthorLabel}" Initials="{Binding Initials}" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <HyperlinkButton Content="{Binding AuthorLabel}" Tag="{Binding}" Click="OpenAuthor_Click"
                                           Padding="0" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                          <TextBlock Text="{Binding WhenText}" Style="{StaticResource CaptionTextBlockStyle}"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                      </StackPanel>
                      <Button Grid.Column="2" Tag="{Binding}" Click="DeleteComment_Click" VerticalAlignment="Top"
                              Background="Transparent" BorderThickness="0" Padding="6"
                              ToolTipService.ToolTip="{loc:Tr Key='Usuń'}"
                              AutomationProperties.Name="{loc:Tr Key='Usuń'}"
                              Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </StackPanel>

          <StackPanel x:Name="RightRail" Grid.Column="1" Spacing="16">
            <Border Style="{StaticResource ProfileCard}" Padding="16">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{loc:Tr Key='Gry'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <Border Style="{StaticResource CountPill}">
                    <TextBlock Text="{Binding GamesCount}" Style="{StaticResource CaptionTextBlockStyle}" />
                  </Border>
                </StackPanel>
                <GridView ItemsSource="{Binding Games}" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="GamesGrid_ItemClick">
                  <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentGameItem">
                      <Border Width="64" Height="64" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                              ToolTipService.ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                        <Grid>
                          <TextBlock Text="{Binding TileLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontWeight="SemiBold" FontSize="12"
                                     Visibility="{Binding HasCover, Converter={StaticResource BoolToVisInv}}" />
                          <Image Stretch="UniformToFill" Source="{Binding CoverImageUrl}"
                                 Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </GridView.ItemTemplate>
                </GridView>
                <TextBlock Text="{Binding GamesText}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Visibility="{Binding HasGames, Converter={StaticResource BoolToVisInv}}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ProfileCard}" Padding="16">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{loc:Tr Key='Osiągnięcia'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <Border Style="{StaticResource CountPill}">
                    <TextBlock Text="{Binding AchievementsUnlocked}" Style="{StaticResource CaptionTextBlockStyle}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding AchievementsText}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Achievements}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AchievementSummaryItem">
                      <Grid RowSpacing="4" Margin="0,4">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,0,56,0" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding Fraction}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
