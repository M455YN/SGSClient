<Page
    x:Class="SGSClient.UI.WinUI.Views.GameDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <TextBlock x:Name="EmptyStatus"
               Opacity="0.65"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="14" />

    <ScrollViewer x:Name="ContentScroll" Visibility="Collapsed">
      <Grid>
        <Border Height="420" VerticalAlignment="Top" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Color="#332A4A3A" Offset="0" />
              <GradientStop Color="#1A243828" Offset="0.45" />
              <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <StackPanel Margin="28,20,28,32" Spacing="22">
          <Button x:Name="BackButton" Content="← Sklep" Click="Back_Click" HorizontalAlignment="Left" Padding="10,6" />

          <Grid ColumnSpacing="36" MinHeight="280">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="14" VerticalAlignment="Top">
              <TextBlock x:Name="ContextLabelText" Text="SGS STORE" Opacity="0.55" FontSize="12" FontWeight="SemiBold" />
              <TextBlock x:Name="TitleText" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" />
              <ItemsControl x:Name="BadgesList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,8,8" Padding="10,5" CornerRadius="4"
                            Background="#33FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1">
                      <TextBlock Text="{Binding}" FontSize="11" Opacity="0.9" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="TaglineText" FontSize="16" Opacity="0.85" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Button x:Name="PrimaryActionButton"
                        Click="AddToLibrary_Click"
                        Padding="18,12"
                        MinWidth="200"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="LaunchButton"
                        Content="Graj"
                        Click="Launch_Click"
                        Visibility="Collapsed"
                        Padding="18,12"
                        MinWidth="120"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="InstallButton"
                        Content="Zainstaluj"
                        Click="Install_Click"
                        Visibility="Collapsed"
                        Padding="14,12" />
                <Button x:Name="UninstallButton"
                        Content="Odinstaluj"
                        Click="Uninstall_Click"
                        Visibility="Collapsed"
                        Padding="14,12" />
                <Button x:Name="PropertiesButton"
                        Content="Właściwości"
                        Click="Properties_Click"
                        Visibility="Collapsed"
                        Padding="14,12"
                        Style="{StaticResource SubtleButtonStyle}" />
              </StackPanel>
              <StackPanel x:Name="InstallProgressPanel" Spacing="4" Visibility="Collapsed">
                <TextBlock x:Name="InstallProgressText" Opacity="0.7" FontSize="12" />
                <ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="1" Height="4" />
              </StackPanel>
              <TextBlock x:Name="StatusText" Opacity="0.65" FontSize="12" />
              <TextBlock x:Name="PlaytimeText" Opacity="0.75" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="10">
              <Border x:Name="HeroBorder" Height="220" CornerRadius="8"
                      PointerPressed="Cover_PointerPressed">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF2A3A4A" Offset="0" />
                    <GradientStop Color="#FF1A242E" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid x:Name="HeroGrid">
                  <TextBlock x:Name="TileLabelText"
                             FontSize="56" FontWeight="Bold" Opacity="0.35"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image x:Name="CoverImage" Stretch="UniformToFill" />
                  <Border x:Name="IntroHost" Visibility="Collapsed" />
                  <Border x:Name="PlayOverlay"
                          Width="56" Height="56" CornerRadius="28" Background="#99000000"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          PointerPressed="PlayOverlay_PointerPressed">
                    <TextBlock Text="▶" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>
              <ItemsControl x:Name="MediaThumbsList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="92" Height="56" CornerRadius="4" Background="#334455" Margin="0,0,8,0"
                            PointerPressed="MediaThumb_PointerPressed"
                            Tag="{Binding}">
                      <Grid>
                        <TextBlock Text="{Binding Label}" FontSize="10" Opacity="0.85"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>

          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="Szczegóły" Tag="Details" Click="Tab_Click" Padding="14,8" FontWeight="SemiBold" />
              <Button Content="Recenzje" Tag="Reviews" Click="Tab_Click" Padding="14,8" />
              <Button Content="Więcej" Tag="More" Click="Tab_Click" Padding="14,8" />
            </StackPanel>
            <Border Height="1" Background="#33FFFFFF" />

            <StackPanel x:Name="DetailsPanel" Spacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="Opis" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="DescriptionText" Opacity="0.85" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel x:Name="HardwarePanel" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="Wymagania sprzętowe" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="HardwareText" Opacity="0.85" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel x:Name="BuildsPanel" Spacing="10" Visibility="Collapsed">
                <TextBlock Text="Właściwości wersji" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Wybierz wersję do pobrania (jak Betas w Steam). Domyślnie zaznaczona jest najnowsza."
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                <ItemsControl x:Name="BuildsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,10" Padding="14" CornerRadius="8"
                              Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="10">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding PlatformText}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding MetaText}" Opacity="0.6" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding PreferredLabel}"
                                       FontSize="11" Foreground="#A5D6A7" VerticalAlignment="Center" />
                          </Grid>
                          <StackPanel Spacing="4">
                            <TextBlock Text="Wersja" Opacity="0.7" FontSize="11" />
                            <ComboBox ItemsSource="{Binding Versions}"
                                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayText"
                                      MinWidth="260"
                                      HorizontalAlignment="Left" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel x:Name="OtherPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="Dodatkowe informacje" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="OtherText" Opacity="0.85" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ReviewsPanel" Spacing="8" Visibility="Collapsed">
              <TextBlock Text="Recenzje" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Recenzje społeczności pojawią się tutaj." Opacity="0.6" />
            </StackPanel>

            <StackPanel x:Name="MorePanel" Spacing="8" Visibility="Collapsed">
              <TextBlock Text="Więcej" FontSize="18" FontWeight="SemiBold" />
              <TextBlock x:Name="PlatformsText" Opacity="0.75" />
              <TextBlock x:Name="SymbolText" Opacity="0.55" FontSize="12" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Fullscreen media preview -->
    <Grid x:Name="MediaPreviewOverlay"
          Visibility="Collapsed"
          Background="#E6000000"
          PointerPressed="MediaPreviewBackdrop_PointerPressed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="20,16" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="MediaPreviewLabelText" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" TextWrapping="NoWrap" />
        <TextBlock x:Name="MediaPreviewCounterText" Grid.Column="1"
                   Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Grid.Column="2" Content="✕" Click="CloseMediaPreview_Click"
                Padding="12,6" Style="{StaticResource SubtleButtonStyle}" />
      </Grid>

      <Grid Grid.Row="1" Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="PreviewPrevButton" Content="‹" FontSize="36"
                Click="PreviewPrevious_Click" Padding="18,10"
                VerticalAlignment="Center" Margin="8,0"
                Style="{StaticResource SubtleButtonStyle}" />
        <Image x:Name="MediaPreviewImage" Grid.Column="1"
               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
               PointerPressed="MediaPreviewImage_PointerPressed" />
        <Button x:Name="PreviewNextButton" Grid.Column="2" Content="›" FontSize="36"
                Click="PreviewNext_Click" Padding="18,10"
                VerticalAlignment="Center" Margin="8,0"
                Style="{StaticResource SubtleButtonStyle}" />
      </Grid>

      <TextBlock x:Name="MediaPreviewHintText" Grid.Row="2"
                 Margin="20,8,20,20" Opacity="0.65" FontSize="13"
                 HorizontalAlignment="Center" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Page>
