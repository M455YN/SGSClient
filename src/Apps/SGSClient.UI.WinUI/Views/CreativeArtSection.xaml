<UserControl xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.CreativeArtSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SGSClient.UI.WinUI.Views">

  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />

    <Style x:Key="ChipStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12,4" />
    </Style>

    <Style x:Key="ChipSelectedStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid x:Name="GalleryPanel">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,12,0">
          <StackPanel x:Name="ChipsPanel" Orientation="Horizontal" Spacing="4" />
        </ScrollViewer>
        <TextBox x:Name="SearchBox" Grid.Column="1" Width="260" VerticalAlignment="Center"
                 PlaceholderText="{loc:Tr Key='Szukaj grafik…'}" KeyDown="SearchBox_KeyDown" />
      </Grid>

      <Grid Grid.Row="1">
        <GridView x:Name="ItemsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Gallery_ItemClick">
          <GridView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsWrapGrid Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </GridView.ItemsPanel>
          <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
              <Setter Property="Margin" Value="4" />
            </Style>
          </GridView.ItemContainerStyle>
          <GridView.ItemTemplate>
            <DataTemplate>
              <Grid Width="260" Height="240" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                <TextBlock Text="{Binding TileLabel}" FontSize="48" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                <!-- Caption scrim over the picture stays dark with white text in every theme. -->
                <Border Tag="overlay" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Bottom"
                        Background="#B3000000" Padding="12,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{Binding Author}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="White" Opacity="0.85" TextTrimming="CharacterEllipsis" MaxLines="1"
                               Visibility="{Binding HasAuthor, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{loc:Tr Key='Nieznany autor'}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="White" Opacity="0.85"
                               Visibility="{Binding HasAuthor, Converter={StaticResource InvBoolToVis}}" />
                  </StackPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </GridView.ItemTemplate>
        </GridView>
        <ProgressRing x:Name="BusyRing" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      </Grid>
    </Grid>

    <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel MaxWidth="960" HorizontalAlignment="Left" Spacing="16" Padding="0,0,0,24">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Click="Close_Click" AutomationProperties.Name="{loc:Tr Key='← Wróć'}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE72B;" FontSize="14" />
              <TextBlock Text="{loc:Tr Key='Wróć'}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Download_Click"
                  AutomationProperties.Name="{loc:Tr Key='Pobierz'}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE896;" FontSize="14" />
              <TextBlock Text="{loc:Tr Key='Pobierz'}" />
            </StackPanel>
          </Button>
        </Grid>

        <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Image Source="{Binding FileUrl}" Stretch="Uniform" MaxHeight="620" />
        </Border>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <PersonPicture Width="48" Height="48" VerticalAlignment="Top" DisplayName="{Binding Author}" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasAuthor, Converter={StaticResource BoolToVis}}">
              <Run Text="{loc:Tr Key='przez'}" /><Run Text=" " /><Run Text="{Binding Author}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </TextBlock>
            <TextBlock Text="{loc:Tr Key='Nieznany autor'}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasAuthor, Converter={StaticResource InvBoolToVis}}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top">
            <Run Text="{loc:Tr Key='Opublikowano:'}" /><Run Text=" " /><Run Text="{Binding PublishedText}" />
          </TextBlock>
        </Grid>

        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding Tags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="8,4">
                  <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
          <Run Text="{loc:Tr Key='Plik:'}" /><Run Text=" " /><Run Text="{Binding FileName}" />
        </TextBlock>

        <local:CreativeComments x:Name="CommentsControl" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
