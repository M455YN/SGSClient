<UserControl xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.Views.CreativeArtSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="SearchBox" Grid.Row="0" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,12"
             PlaceholderText="{loc:Tr Key='Szukaj grafik…'}" KeyDown="SearchBox_KeyDown" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="ItemsList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsWrapGrid Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Width="220" Height="220" Margin="0,0,12,12" Background="#2B2B2B" CornerRadius="8"
                  Tapped="Tile_Tapped">
              <TextBlock Text="{Binding TileLabel}" FontSize="48" FontWeight="Bold" Opacity="0.3"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
              <Border VerticalAlignment="Bottom" Background="#B3000000" Padding="10,6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <TextBlock Text="{Binding Author}" Opacity="0.7" FontSize="12"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock x:Name="StatusText" Grid.Row="2" Opacity="0.75" TextWrapping="Wrap" Margin="0,12,0,0" />

    <Border x:Name="Lightbox" Grid.RowSpan="3" Background="#E6101010" Padding="32" Visibility="Collapsed">
      <Grid x:Name="LightboxPanel">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="{Binding FileUrl}" Stretch="Uniform" Margin="0,0,0,12" />
        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="2" Text="{Binding Author}" Opacity="0.7" />
        <TextBlock Grid.Row="3" Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="120" Margin="0,8,0,0" />
        <TextBlock x:Name="LightboxTags" Grid.Row="4" Opacity="0.6" Margin="0,4,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
          <Button Content="{loc:Tr Key='Pobierz'}" Style="{StaticResource AccentButtonStyle}" Click="Download_Click" />
          <Button Content="{loc:Tr Key='Zamknij'}" Click="Close_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
