<Window xmlns:loc="using:SGSClient.UI.WinUI.Localization"
    x:Class="SGSClient.UI.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SGSClient.UI.WinUI.Views"
    Title="SGSClient">

  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar drawn by the app so it blends into the navigation shell -->
    <Grid x:Name="AppTitleBar"
          Height="36"
          Background="{ThemeResource LayerFillColorDefaultBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Login/sgs-logo.png" Width="16" Height="16" />
        <TextBlock x:Name="AppTitleText" Text="SGSClient"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid x:Name="ShellRoot" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <Border x:Name="OfflineBanner"
                Visibility="Collapsed"
                Background="#CC8B0000"
                Padding="12,8">
          <TextBlock Text="{loc:Tr Key='Tryb offline — pokazujemy zapisane dane'}"
                     Foreground="White"
                     FontSize="13"
                     HorizontalAlignment="Center" />
        </Border>
        <Border x:Name="MaintenanceBanner"
                Visibility="Collapsed"
                Background="#CCB45309"
                Padding="12,8">
          <TextBlock x:Name="MaintenanceBannerText"
                     Foreground="White"
                     FontSize="13"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:ShellSidebar x:Name="Sidebar" Grid.Column="0" />

        <Grid Grid.Column="1">
          <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,1,0,1"
                  CornerRadius="8,0,0,8"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Frame x:Name="ContentFrame" Background="Transparent" />
          </Border>

          <Border x:Name="SocialPanel"
                  Width="360"
                  HorizontalAlignment="Right"
                  Margin="0,12,12,12"
                  CornerRadius="8"
                  Visibility="Collapsed"
                  Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <Border.Shadow>
              <ThemeShadow />
            </Border.Shadow>
            <Frame x:Name="SocialFrame" Background="Transparent" />
          </Border>
        </Grid>
      </Grid>

      <!-- Fluent bottom status strip -->
      <Border Grid.Row="2"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              MinHeight="40"
              Padding="8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button x:Name="NotificationsStatusButton"
                  Style="{StaticResource SubtleButtonStyle}"
                  Padding="12,6"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  ToolTipService.ToolTip="Powiadomienia">
            <Button.Flyout>
              <Flyout x:Name="NotificationsFlyout" Placement="TopEdgeAlignedLeft">
                <Border Width="320" MaxHeight="280" Padding="8">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{loc:Tr Key='Powiadomienia'}" FontWeight="SemiBold" FontSize="13"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="{loc:Tr Key='Przeczytaj wszystkie'}" FontSize="11"
                              Padding="6,2" Click="MarkAllNotificationsRead_OnClick" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="220">
                      <ItemsControl x:Name="NotificationsList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="4,6"
                                    Click="NotificationItem_OnClick" Tag="{Binding}">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Body}" FontSize="11" Opacity="0.75"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Border>
              </Flyout>
            </Button.Flyout>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xEA8F;" FontSize="14" />
              <TextBlock Grid.Column="1" Text="{loc:Tr Key='Powiadomienia'}" VerticalAlignment="Center" FontSize="12" />
              <Border x:Name="NotificationsBadge" Grid.Column="2"
                      MinWidth="18" Height="18" CornerRadius="9"
                      Background="#C62828" Padding="4,0"
                      Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="NotificationsBadgeText" FontSize="11" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Button>

          <Button x:Name="DownloadStatusButton"
                  Grid.Column="1"
                  Style="{StaticResource SubtleButtonStyle}"
                  Padding="12,4"
                  MinWidth="280"
                  MaxWidth="420"
                  HorizontalContentAlignment="Stretch"
                  VerticalAlignment="Center"
                  Click="DownloadStatusButton_OnClick"
                  ToolTipService.ToolTip="Pobrania">
            <Grid MinWidth="240">
              <Grid x:Name="DownloadStatusActivePanel" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE896;" FontSize="14" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock x:Name="DownloadStatusTitle" FontSize="12" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <ProgressBar x:Name="DownloadStatusProgress" Minimum="0" Maximum="1" Height="3"
                               HorizontalAlignment="Stretch" />
                </StackPanel>
                <TextBlock x:Name="DownloadStatusPercent" Grid.Column="2"
                           FontSize="11" Opacity="0.7" MinWidth="36"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
              </Grid>
              <StackPanel x:Name="DownloadStatusIdleText"
                          Orientation="Horizontal" Spacing="8"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr Key='Zarządzaj pobieraniem'}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Button>

          <Button x:Name="FriendsStatusButton"
                  Grid.Column="2"
                  Style="{StaticResource SubtleButtonStyle}"
                  Padding="12,6"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Click="FriendsStatusButton_OnClick"
                  ToolTipService.ToolTip="Znajomi">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE716;" FontSize="14" />
              <TextBlock Text="{loc:Tr Key='Znajomi'}" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="LoginGatePanel" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="440" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Image Source="ms-appx:///Assets/Login/login-background.jpg" Stretch="UniformToFill" />
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" />
      </Grid>

      <Grid Grid.Column="1" Padding="56,48">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
          <Image Source="ms-appx:///Assets/Login/sgs-logo.png" Width="32" Height="32" />
          <TextBlock Text="SGSClient" Style="{StaticResource BodyStrongTextBlockStyle}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="{loc:Tr Key='Zaloguj się'}" Style="{StaticResource TitleTextBlockStyle}" />
          <TextBlock Text="{loc:Tr Key='Użyj konta SGS.'}"
                     Style="{StaticResource BodyTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

          <Button x:Name="LoginButton"
                  Content="{loc:Tr Key='Zaloguj się'}"
                  Style="{StaticResource AccentButtonStyle}"
                  HorizontalAlignment="Stretch"
                  MinHeight="36"
                  Margin="0,24,0,0"
                  Click="LoginButton_OnClick" />

          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
            <TextBlock Text="{loc:Tr Key='Nie masz konta?'}" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton x:Name="SignUpLink" Content="{loc:Tr Key='Zarejestruj się'}" Padding="4,2" FontSize="12"
                             Click="SignUpLink_OnClick" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <ProgressRing x:Name="LoginProgress" Width="16" Height="16"
                          IsActive="False" Visibility="Collapsed" />
            <TextBlock x:Name="LoginStatusText" TextWrapping="Wrap" MaxWidth="240"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton x:Name="LoginCancelLink" Content="{loc:Tr Key='Anuluj'}" Padding="4,2" FontSize="12"
                             VerticalAlignment="Center" Visibility="Collapsed"
                             Click="LoginCancelLink_OnClick" />
          </StackPanel>
        </StackPanel>

        <TextBlock x:Name="LoginVersionText" Grid.Row="2"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
