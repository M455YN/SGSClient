<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>Custom</WebPublishMethod>
    <DockerPublish>true</DockerPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishImageName>sgsclient-api</PublishImageName>
    <PublishImageTag>latest</PublishImageTag>
    <DockerfileBuildArguments>--platform linux/amd64</DockerfileBuildArguments>
    <HowToPublish>DockerImage</HowToPublish>
  </PropertyGroup>
</Project>
