{
  "ConnectionStrings": {
    "SgsDatabase": "Data Source=localhost;Initial Catalog=sgsclient;User ID=sa;Password=<PASSWORD>;Encrypt=True;TrustServerCertificate=True",
    "RofwDatabase": "Data Source=localhost;Initial Catalog=SZYRROGI_AUTOBATTLER;User ID=sa;Password=<PASSWORD>;Encrypt=True;TrustServerCertificate=True",
    "ReportingoDatabase": "Data Source=localhost;Initial Catalog=REPORTINGO;User ID=sa;Password=<PASSWORD>;Encrypt=True;TrustServerCertificate=True"
  },
  "AzureAd": {
    "Enabled": false,
    "ClientId": "<B2C-APP-CLIENT-ID>",
    "TenantName": "<your-b2c-tenant>",
    "SigninPolicy": "B2C_1_SGSClient_SignInUp",
    "PasswordResetPolicy": "B2C_1_SGSClient_PassRESET",
    "ApiAudience": "",
    "Scopes": [ "openid", "offline_access" ]
  },
  "Games": {
    "StoragePath": "App_Data/games",
    "PublicBaseUrl": "/api/games/packages",
    "MediaPublicBaseUrl": "/api/games/media"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
