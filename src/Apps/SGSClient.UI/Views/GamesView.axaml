<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.GamesView"
             x:DataType="vm:GamesViewModel">
  <DockPanel Margin="28,24">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,18">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/>
        <Button Grid.Column="1" Content="Odśwież" Click="Refresh_OnClick" Padding="12,6"/>
      </Grid>
      <TextBlock Text="{Binding StatusText}" Opacity="0.65" FontSize="13"/>
    </StackPanel>

    <TextBlock Text="{Binding StatusText}"
               IsVisible="{Binding ShowEmpty}"
               Opacity="0.6"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasGames}">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameListItem">
            <Border Width="280" Margin="0,0,16,16" Padding="14" CornerRadius="8"
                    Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                  <Border Width="56" Height="56" CornerRadius="8" Background="#333">
                    <TextBlock Text="{Binding TileLabel}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding FeaturedBadge}" FontSize="11" Opacity="0.7"
                               IsVisible="{Binding ShowFeaturedBadge}"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Description}" Opacity="0.7" FontSize="12"
                           TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PlatformsText}" Opacity="0.55" FontSize="11"/>
                <Button Content="{Binding ActionLabel}"
                        Tag="{Binding}"
                        Click="AddToLibrary_OnClick"
                        IsEnabled="{Binding CanAdd}"
                        HorizontalAlignment="Stretch"
                        Padding="10,8"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
