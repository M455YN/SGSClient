<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.GamesView"
             x:DataType="vm:GamesViewModel">
  <DockPanel Margin="28,24">
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,18">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/>
        <Button Grid.Column="1" Content="Odśwież" Click="Refresh_OnClick" Padding="12,6"/>
      </Grid>
      <TextBlock Text="{Binding StatusText}" Opacity="0.65" FontSize="13"/>
      <Grid ColumnDefinitions="2*,*,Auto,Auto" ColumnSpacing="10">
        <TextBox PlaceholderText="Szukaj…" Text="{Binding SearchText}" Padding="10,8"/>
        <TextBox Grid.Column="1" PlaceholderText="Gatunek" Text="{Binding GenreFilter}" Padding="10,8"/>
        <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                  MinWidth="140" Padding="8,6"/>
        <Button Grid.Column="3" Content="Wyczyść gatunek" Command="{Binding ClearGenreFilterCommand}" Padding="10,8"/>
      </Grid>
    </StackPanel>

    <TextBlock Text="{Binding StatusText}"
               IsVisible="{Binding ShowEmpty}"
               Opacity="0.6"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasGames}">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.Styles>
          <Style Selector="ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
          </Style>
          <Style Selector="Border.game-card:pointerover">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameListItem">
            <Border Classes="game-card" Width="280" Margin="0,0,16,16" Padding="14" CornerRadius="8"
                    Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                    Cursor="Hand" Tag="{Binding}" PointerPressed="GameCard_OnPointerPressed">
              <StackPanel Spacing="10">
                <Border Height="112" CornerRadius="8" Background="#333" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="{Binding TileLabel}" FontWeight="Bold" FontSize="28" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasCover}"/>
                    <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"
                           IsVisible="{Binding HasCover}"/>
                  </Panel>
                </Border>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding FeaturedBadge}" FontSize="11" Opacity="0.7"
                             IsVisible="{Binding ShowFeaturedBadge}"/>
                </StackPanel>
                <TextBlock Text="{Binding Description}" Opacity="0.7" FontSize="12"
                           TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PlatformsText}" Opacity="0.55" FontSize="11"/>
                <Button Content="{Binding ActionLabel}"
                        Tag="{Binding}"
                        Click="AddToLibrary_OnClick"
                        IsEnabled="{Binding CanAdd}"
                        HorizontalAlignment="Stretch"
                        Padding="10,8"/>
                <Button Content="{Binding WishlistLabel}"
                        Tag="{Binding}"
                        Command="{Binding $parent[UserControl].((vm:GamesViewModel)DataContext).ToggleWishlistCommand}"
                        CommandParameter="{Binding}"
                        HorizontalAlignment="Stretch"
                        Padding="10,6"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
