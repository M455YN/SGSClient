<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.GamesView"
             x:DataType="vm:GamesViewModel">
  <DockPanel Margin="36,20,36,0">
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,14">
      <Grid ColumnDefinitions="*,2*,*">
        <TextBox Grid.Column="1" PlaceholderText="Wyszukaj gry, studia i tagi"
                 Text="{Binding SearchText}" Padding="12,8" CornerRadius="18" MaxWidth="560"/>
        <Button Grid.Column="2" Content="Odśwież" Click="Refresh_OnClick" Padding="12,6"
                HorizontalAlignment="Right"/>
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="SemiBold"/>
          <TextBlock Text="Odkrywaj gry niezależnych twórców" FontSize="14" Opacity="0.8"/>
          <TextBlock Text="{Binding CountText}" Margin="0,14,0,0" Opacity="0.6" FontSize="12"
                     IsVisible="{Binding HasGames}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
          <Button Command="{Binding ToggleFilterPanelCommand}" Padding="14,7">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Filtry"/>
              <TextBlock Text="{Binding ActiveFilterCount, StringFormat='({0})'}"
                         IsVisible="{Binding HasActiveFilters}"/>
            </StackPanel>
          </Button>
          <TextBlock Text="Sortuj według" VerticalAlignment="Center" FontSize="13"/>
          <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                    MinWidth="170" Padding="8,6"/>
        </StackPanel>
      </Grid>

      <!-- Collapsible filter panel (Gatunek / Silnik / Funkcje / Platforma / Premiera). -->
      <Border IsVisible="{Binding IsFilterPanelOpen}" CornerRadius="10" Padding="20,16"
              Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Grid ColumnDefinitions="*,*,*,*,*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="Gatunek" FontWeight="SemiBold" FontSize="13"/>
            <DropDownButton Content="{Binding GenreFilters.Summary}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ScrollViewer MaxHeight="340" MinWidth="240">
                    <ItemsControl ItemsSource="{Binding GenreFilters.Options}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaxonomyOption">
                          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="Silnik" FontWeight="SemiBold" FontSize="13"/>
            <DropDownButton Content="{Binding EngineFilters.Summary}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ScrollViewer MaxHeight="340" MinWidth="240">
                    <ItemsControl ItemsSource="{Binding EngineFilters.Options}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaxonomyOption">
                          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Text="Funkcje" FontWeight="SemiBold" FontSize="13"/>
            <DropDownButton Content="{Binding FeatureFilters.Summary}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ScrollViewer MaxHeight="340" MinWidth="220">
                    <ItemsControl ItemsSource="{Binding FeatureFilters.Options}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaxonomyOption">
                          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </StackPanel>

          <StackPanel Grid.Column="3" Spacing="6">
            <TextBlock Text="Platforma" FontWeight="SemiBold" FontSize="13"/>
            <ComboBox ItemsSource="{Binding PlatformOptions}"
                      SelectedIndex="{Binding SelectedPlatformIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
          </StackPanel>

          <StackPanel Grid.Column="4" Spacing="6">
            <TextBlock Text="Etap premiery" FontWeight="SemiBold" FontSize="13"/>
            <ComboBox ItemsSource="{Binding ReleaseStatusFilterOptions}"
                      SelectedIndex="{Binding SelectedStatusIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
          </StackPanel>

          <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
            <Button Content="Wyczyść" Command="{Binding ClearFiltersCommand}" Padding="12,6"/>
            <Button Content="✕" Command="{Binding ToggleFilterPanelCommand}" Padding="10,6"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <TextBlock Text="{Binding StatusText}"
               IsVisible="{Binding ShowEmpty}"
               Opacity="0.6"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasGames}">
      <ItemsControl ItemsSource="{Binding Games}" Margin="0,6,0,24">
        <ItemsControl.Styles>
          <Style Selector="ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
          </Style>
          <Style Selector="Border.game-card:pointerover">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameListItem">
            <!-- Portrait store capsule: poster on top, meta below. -->
            <Border Classes="game-card" Width="190" Margin="0,0,18,18" CornerRadius="8"
                    Background="#1FFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                    ClipToBounds="True" Cursor="Hand" Tag="{Binding}"
                    PointerPressed="GameCard_OnPointerPressed">
              <StackPanel>
                <Panel Height="254" Background="#2B2B2B">
                  <TextBlock Text="{Binding TileLabel}" FontWeight="Bold" FontSize="34" Opacity="0.3"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding !HasPoster}"/>
                  <Image Source="{Binding PosterImageUrl}" Stretch="UniformToFill"
                         IsVisible="{Binding HasPoster}"/>

                  <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                          Padding="7,3" CornerRadius="4" Background="#CC111111"
                          IsVisible="{Binding HasStatusBadge}">
                    <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold"/>
                  </Border>

                  <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                          Padding="8,2" CornerRadius="14" Background="#99000000" FontSize="16"
                          Content="{Binding WishlistSymbol}"
                          Command="{Binding $parent[UserControl].((vm:GamesViewModel)DataContext).ToggleWishlistCommand}"
                          CommandParameter="{Binding}"/>
                </Panel>

                <StackPanel Margin="10" Spacing="3">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                             MinHeight="34"/>
                  <TextBlock Text="{Binding StudioName}" Opacity="0.6" FontSize="12"
                             TextTrimming="CharacterEllipsis" MaxLines="1"/>
                  <TextBlock Text="{Binding GenresText}" FontSize="11" Opacity="0.85"
                             TextTrimming="CharacterEllipsis" MaxLines="1" MinHeight="16"/>
                  <TextBlock Text="{Binding PlatformsText}" Opacity="0.5" FontSize="11"
                             TextTrimming="CharacterEllipsis" MaxLines="1"/>
                  <Button Content="{Binding ActionLabel}"
                          Tag="{Binding}"
                          Click="AddToLibrary_OnClick"
                          IsEnabled="{Binding CanAdd}"
                          HorizontalAlignment="Stretch"
                          Margin="0,6,0,0"
                          Padding="8,5" FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
