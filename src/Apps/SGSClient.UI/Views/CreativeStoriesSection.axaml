<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             xmlns:views="using:SGSClient.UI.Views"
             x:Class="SGSClient.UI.Views.CreativeStoriesSection"
             x:DataType="vm:CreativeStoriesViewModel">
  <Grid>
    <!-- Browse: search, status and the card grid -->
    <ScrollViewer IsVisible="{Binding !IsReading}">
      <StackPanel Spacing="12" Margin="0,0,0,8">
        <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="{loc:Tr Key='Szukaj opowiadań…'}"
                 MaxWidth="420" HorizontalAlignment="Left" KeyDown="SearchBox_KeyDown"/>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" HorizontalAlignment="Left" Width="160"/>
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CreativeItem">
              <Button Click="Card_Click" Padding="0" Margin="0,0,16,16" Width="168" Height="300" CornerRadius="8"
                      VerticalAlignment="Top" Background="{DynamicResource ControlFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel Spacing="6" Width="170">
                  <Panel Height="150" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" ClipToBounds="True">
                    <TextBlock Text="{Binding TileLabel}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasCover}"/>
                    <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" IsVisible="{Binding HasCover}"/>
                  </Panel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                             TextTrimming="CharacterEllipsis" Margin="8,4,8,0"/>
                  <TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                             MaxLines="3" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Reader: back button, chapter picker and the chapter text -->
    <DockPanel IsVisible="{Binding IsReading}">
      <StackPanel DockPanel.Dock="Top" Spacing="10" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,12">
        <Button Content="{loc:Tr Key='← Wróć'}" Command="{Binding CloseCommand}" Padding="14,8"
                HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding ReaderTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Tr Key='Poprzedni rozdział'}" Command="{Binding PreviousChapterCommand}"
                  Padding="14,8"/>
          <ComboBox ItemsSource="{Binding Chapters}" SelectedIndex="{Binding SelectedChapterIndex, Mode=TwoWay}"
                    MinWidth="260" VerticalAlignment="Center"/>
          <Button Content="{loc:Tr Key='Następny rozdział'}" Command="{Binding NextChapterCommand}" Padding="14,8"/>
        </StackPanel>
        <TextBlock Text="{Binding ReaderStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <ScrollViewer>
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="24" Margin="0,0,18,24">
          <SelectableTextBlock Text="{Binding ChapterText}" FontSize="17" LineHeight="28" TextWrapping="Wrap"/>
          <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
          <views:CreativeComments DataContext="{Binding Comments}"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
