<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:SGSClient.UI.Converters"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             xmlns:views="using:SGSClient.UI.Views"
             x:Class="SGSClient.UI.Views.CreativeMusicSection"
             x:DataType="vm:CreativeMusicViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="16">
    <TextBox Grid.Row="0" x:Name="SearchBox" Watermark="{loc:Tr Key='Szukaj utworów…'}"
             KeyDown="SearchBox_OnKeyDown"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="48" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CreativeItem">
            <Grid ColumnDefinitions="56,*,Auto" Margin="0,6">
              <Border Width="56" Height="56" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" ClipToBounds="True"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Panel>
                  <TextBlock Text="{Binding TileLabel}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image conv:ImageUrl.Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{loc:Tr Key='Komentarze'}" Click="Comments_OnClick"/>
                <Button Content="{loc:Tr Key='Graj'}" Click="Play_OnClick"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="3" IsVisible="{Binding IsCommentsOpen}" Padding="16" CornerRadius="8" MaxHeight="360"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <ScrollViewer>
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding CommentsTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{loc:Tr Key='Ukryj komentarze'}" Click="CloseComments_OnClick"/>
          </Grid>
          <views:CreativeComments DataContext="{Binding Comments}"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="4" Padding="16,12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding NowPlayingTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding NowPlayingAuthor}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{loc:Tr Key='Odtwarzanie w domyślnym odtwarzaczu systemu'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
        </StackPanel>
        <Button Grid.Column="1" Content="{loc:Tr Key='Następny'}" VerticalAlignment="Center" Click="Next_OnClick"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
