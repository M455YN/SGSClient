<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:SGSClient.UI.Converters"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.GameDetailsView"
             x:DataType="vm:GameDetailsViewModel">
  <Panel>
    <TextBlock Text="{Binding StatusText}"
               IsVisible="{Binding !HasContent}"
               Opacity="0.65"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="14"/>

    <ScrollViewer IsVisible="{Binding HasContent}" HorizontalScrollBarVisibility="Disabled">
      <Panel>
        <Border Height="420" VerticalAlignment="Top" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Color="#332A4A3A" Offset="0"/>
              <GradientStop Color="#1A243828" Offset="0.45"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <StackPanel Margin="28,20,28,32" Spacing="22">
          <Button Content="{Binding BackLabel}" Click="Back_OnClick" HorizontalAlignment="Left" Padding="10,6"/>

          <Grid ColumnDefinitions="*,1.1*" ColumnSpacing="36" MinHeight="280">
            <!-- Left: identity + CTA -->
            <StackPanel Spacing="14" VerticalAlignment="Top">
              <TextBlock Text="{Binding ContextLabel}" Opacity="0.55" FontSize="12" FontWeight="SemiBold" LetterSpacing="1.2"/>
              <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="Bold" TextWrapping="Wrap"/>

              <ItemsControl ItemsSource="{Binding Badges}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,8,8" Padding="10,5" CornerRadius="4"
                            Background="#33FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1">
                      <TextBlock Text="{Binding}" FontSize="11" Opacity="0.9"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding Tagline}" FontSize="16" Opacity="0.85" TextWrapping="Wrap"/>

              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Button Content="{Binding PrimaryActionLabel}"
                        Click="AddToLibrary_OnClick"
                        IsEnabled="{Binding CanAdd}"
                        IsVisible="{Binding !ShowLibraryActions}"
                        Padding="18,12"
                        MinWidth="200"
                        Classes="accent"/>
                <Button Content="{Binding WishlistLabel}"
                        Command="{Binding ToggleWishlistCommand}"
                        IsVisible="{Binding CanToggleWishlist}"
                        Padding="14,12"/>
                <Button Content="{loc:Tr Key='Graj'}"
                        Click="Launch_OnClick"
                        IsVisible="{Binding ShowLibraryActions}"
                        IsEnabled="{Binding CanLaunch}"
                        Padding="18,12"
                        MinWidth="120"
                        Classes="accent"/>
                <Button Content="{loc:Tr Key='Zainstaluj'}"
                        Click="Install_OnClick"
                        IsVisible="{Binding ShowLibraryActions}"
                        IsEnabled="{Binding CanInstall}"
                        Padding="14,12"/>
                <Button Content="{loc:Tr Key='Odinstaluj'}"
                        Click="Uninstall_OnClick"
                        IsVisible="{Binding ShowLibraryActions}"
                        IsEnabled="{Binding CanUninstall}"
                        Padding="14,12"/>
                <Button Content="{loc:Tr Key='Właściwości'}"
                        Click="Properties_OnClick"
                        IsVisible="{Binding ShowLibraryActions}"
                        Classes="subtle"
                        Padding="14,12"/>
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding IsInstalling}">
                <TextBlock Text="{Binding InstallProgressText}" Opacity="0.7" FontSize="12"/>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding InstallProgressFraction}" Height="4"/>
                <Button Content="{loc:Tr Key='Anuluj'}" Click="CancelInstall_OnClick" Padding="12,6" HorizontalAlignment="Left"/>
              </StackPanel>

              <TextBlock Text="{Binding StatusText}" Opacity="0.65" FontSize="12"/>
              <TextBlock Text="{Binding PlaytimeText}" IsVisible="{Binding HasPlaytime}"
                         Opacity="0.75" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Right: media -->
            <StackPanel Grid.Column="1" Spacing="10">
              <Border CornerRadius="8" ClipToBounds="True"
                      Cursor="Hand"
                      PointerPressed="Cover_OnPointerPressed">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#FF2A3A4A" Offset="0"/>
                    <GradientStop Color="#FF1A242E" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Viewbox Stretch="Uniform">
                  <Panel Width="920" Height="430">
                    <TextBlock x:Name="TileLabelText"
                               Text="{Binding TileLabel}"
                               FontSize="56" FontWeight="Bold" Opacity="0.35"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasCover}"/>
                    <Image x:Name="CoverImage"
                           conv:ImageUrl.Source="{Binding CoverImageUrl}" Stretch="UniformToFill"
                           IsVisible="{Binding HasCover}"/>
                    <Panel x:Name="IntroHost" IsVisible="False" />
                    <Border x:Name="PlayOverlay"
                            Width="56" Height="56" CornerRadius="28" Background="#99000000"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding HasIntro}"
                            Cursor="Hand"
                            PointerPressed="PlayOverlay_OnPointerPressed">
                      <TextBlock Text="▶" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </Panel>
                </Viewbox>
              </Border>

              <ItemsControl ItemsSource="{Binding MediaThumbs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MediaThumbItem">
                    <Border Width="92" Height="56" CornerRadius="4" Background="#334455" ClipToBounds="True"
                            Cursor="Hand"
                            PointerPressed="MediaThumb_OnPointerPressed"
                            Tag="{Binding}">
                      <Panel>
                        <TextBlock Text="{Binding Label}" FontSize="10" Opacity="0.85"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image conv:ImageUrl.Source="{Binding ImageUrl}" Stretch="UniformToFill"
                               IsVisible="{Binding IsImage}"/>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>

          <!-- Tabs -->
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="{loc:Tr Key='Szczegóły'}" Tag="Details" Click="Tab_OnClick" Padding="14,8"
                      FontWeight="SemiBold"/>
              <Button Content="{loc:Tr Key='Recenzje'}" Tag="Reviews" Click="Tab_OnClick" Padding="14,8"/>
              <Button Content="{loc:Tr Key='Osiągnięcia'}" Tag="Achievements" Click="Tab_OnClick" Padding="14,8"/>
              <Button Content="{loc:Tr Key='Więcej'}" Tag="More" Click="Tab_OnClick" Padding="14,8"/>
            </StackPanel>
            <Border Height="1" Background="#33FFFFFF"/>

            <StackPanel Spacing="18" IsVisible="{Binding ShowDetailsTab}">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Key='Opis'}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" Opacity="0.85" TextWrapping="Wrap" LineHeight="22"/>
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding ShowHardware}">
                <TextBlock Text="{loc:Tr Key='Wymagania sprzętowe'}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HardwareRequirements}" Opacity="0.85" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="10" IsVisible="{Binding ShowBuilds}">
                <TextBlock Text="{loc:Tr Key='Właściwości wersji'}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr Key='Wybierz wersję do pobrania. Domyślnie zaznaczona jest najnowsza.'}"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Builds}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BuildRowItem">
                      <Border Margin="0,0,0,10" Padding="14" CornerRadius="8"
                              Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding PlatformText}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding MetaText}" Opacity="0.6" FontSize="12"/>
                            </StackPanel>
                            <Border Grid.Column="1" Padding="8,4" CornerRadius="4" Background="#332E7D32"
                                    IsVisible="{Binding IsPreferred}" VerticalAlignment="Center">
                              <TextBlock Text="{loc:Tr Key='Twoja platforma'}" FontSize="11" Foreground="#A5D6A7"/>
                            </Border>
                          </Grid>
                          <StackPanel Spacing="4" IsVisible="{Binding HasVersionPicker}">
                            <TextBlock Text="{loc:Tr Key='Wersja'}" Opacity="0.7" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding Versions}"
                                      SelectedItem="{Binding SelectedVersion}"
                                      MinWidth="260"
                                      HorizontalAlignment="Left">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VersionOptionItem">
                                  <TextBlock Text="{Binding DisplayText}"/>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding ShowOther}">
                <TextBlock Text="{loc:Tr Key='Dodatkowe informacje'}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OtherInformation}" Opacity="0.85" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12" IsVisible="{Binding ShowReviewsTab}">
              <TextBlock Text="{loc:Tr Key='Recenzje'}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ReviewsSummaryText}" Opacity="0.75" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox Width="200" ItemsSource="{Binding ReviewSortOptions}"
                          SelectedItem="{Binding SelectedReviewSort}"/>
                <ComboBox Width="160" ItemsSource="{Binding ReviewFilterOptions}"
                          SelectedItem="{Binding SelectedReviewFilter}"/>
              </StackPanel>

              <Border IsVisible="{Binding CanWriteReview}" Padding="14" CornerRadius="8"
                      Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="{loc:Tr Key='Twoja recenzja'}" FontWeight="SemiBold"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Tr Key='Polecam'}" Click="RecommendYes_OnClick" Padding="12,6"
                            Classes.accent="{Binding ReviewRecommended}"/>
                    <Button Content="{loc:Tr Key='Nie polecam'}" Click="RecommendNo_OnClick" Padding="12,6"
                            Classes.accent="{Binding !ReviewRecommended}"/>
                  </StackPanel>
                  <TextBox Text="{Binding ReviewDraftText}" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="88" PlaceholderText="{loc:Tr Key='Napisz recenzję (min. 10 znaków)…'}"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Tr Key='Zapisz'}" Classes="accent" Click="SubmitReview_OnClick" Padding="14,8"/>
                    <Button Content="{loc:Tr Key='Usuń'}" Click="DeleteReview_OnClick" IsVisible="{Binding HasMyReview}" Padding="14,8"/>
                  </StackPanel>
                  <TextBlock Text="{Binding ReviewStatusText}" Opacity="0.65" FontSize="12"/>
                </StackPanel>
              </Border>

              <TextBlock Text="{loc:Tr Key='Żeby napisać recenzję, dodaj grę do biblioteki.'}"
                         Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding !CanWriteReview}"/>

              <ItemsControl ItemsSource="{Binding Reviews}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GameReviewItem">
                    <Border Margin="0,0,0,10" Padding="14" CornerRadius="8"
                            Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding VerdictLabel}" FontWeight="SemiBold"
                                   Foreground="#FF7CF5C8"/>
                        <TextBlock Text="{Binding MetaText}" Opacity="0.55" FontSize="12"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Opacity="0.9"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="{Binding HelpfulButtonText}" Padding="10,4"
                                  IsVisible="{Binding CanVote}"
                                  Command="{Binding $parent[UserControl].((vm:GameDetailsViewModel)DataContext).VoteHelpfulCommand}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="{Binding CommentsToggleText}" Padding="10,4"
                                  Command="{Binding $parent[UserControl].((vm:GameDetailsViewModel)DataContext).ToggleCommentsCommand}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding CommentsExpanded}" Margin="0,6,0,0">
                          <ItemsControl ItemsSource="{Binding Comments}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:GameReviewCommentItem">
                                <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="6" Background="#14FFFFFF">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                      <TextBlock Text="{Binding MetaText}" Opacity="0.55" FontSize="11"/>
                                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{loc:Tr Key='Usuń'}" Padding="8,4" FontSize="11"
                                            IsVisible="{Binding IsMine}"
                                            Command="{Binding $parent[UserControl].((vm:GameDetailsViewModel)DataContext).DeleteCommentCommand}"
                                            CommandParameter="{Binding}"/>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding CommentDraft}" PlaceholderText="{loc:Tr Key='Dodaj komentarz…'}"/>
                            <Button Grid.Column="1" Content="{loc:Tr Key='Wyślij'}" Padding="12,6"
                                    Command="{Binding $parent[UserControl].((vm:GameDetailsViewModel)DataContext).AddCommentCommand}"
                                    CommandParameter="{Binding}"/>
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="12" IsVisible="{Binding ShowAchievementsTab}">
              <TextBlock Text="{loc:Tr Key='Osiągnięcia'}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding AchievementsSummaryText}" Opacity="0.75" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding Achievements}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlayerAchievementItem">
                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" Background="#12FFFFFF"
                            BorderBrush="#22FFFFFF" BorderThickness="1">
                      <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                        <Border Width="56" Height="56" CornerRadius="8" Background="#1AFFFFFF" ClipToBounds="True">
                          <Image conv:ImageUrl.Source="{Binding IconUrl}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Description}" Opacity="0.7" TextWrapping="Wrap"/>
                          <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                                       Height="4" IsVisible="{Binding ShowProgress}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                          <TextBlock Text="{Binding MetaText}" FontSize="12" Opacity="0.6" HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding ShowMoreTab}">
              <TextBlock Text="{loc:Tr Key='Więcej'}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding PlatformsText}" Opacity="0.75"/>
              <TextBlock Text="{Binding Symbol}" Opacity="0.55" FontSize="12"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>

    <!-- Fullscreen media preview -->
    <Border IsVisible="{Binding IsMediaPreviewOpen}"
            Background="#E6000000"
            ZIndex="100"
            PointerPressed="MediaPreviewBackdrop_OnPointerPressed">
      <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,16">
          <TextBlock Text="{Binding MediaPreviewLabel}" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding PreviewCounterText}"
                     Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Grid.Column="2" Content="✕" Command="{Binding CloseMediaPreviewCommand}"
                  Padding="12,6" Classes="subtle"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="16,0">
          <Button Content="‹" FontSize="36" Command="{Binding PreviewPreviousCommand}"
                  IsEnabled="{Binding CanPreviewPrevious}"
                  Padding="18,10" VerticalAlignment="Center" Margin="8,0" Classes="subtle"/>
          <Panel Grid.Column="1">
            <Image x:Name="MediaPreviewImage"
                   conv:ImageUrl.Source="{Binding MediaPreviewUrl}" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Cursor="Hand"
                   IsVisible="{Binding !MediaPreviewIsVideo}"
                   PointerPressed="MediaPreviewImage_OnPointerPressed"/>
            <Panel x:Name="MediaPreviewVideoHost" IsVisible="{Binding MediaPreviewIsVideo}"/>
          </Panel>
          <Button Grid.Column="2" Content="›" FontSize="36" Command="{Binding PreviewNextCommand}"
                  IsEnabled="{Binding CanPreviewNext}"
                  Padding="18,10" VerticalAlignment="Center" Margin="8,0" Classes="subtle"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding PreviewHintText}"
                   Margin="20,8,20,20" Opacity="0.65" FontSize="13"
                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
      </Grid>
    </Border>
  </Panel>
</UserControl>
