<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.AdminView"
             x:DataType="vm:AdminViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="BorderBrush" Value="#22FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>
    <Style Selector="Border.thumb">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="#1FFFFFFF"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Margin="28,20,28,12" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="10">
        <TextBlock Text="Admin" FontSize="28" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <RadioButton Content="Katalog" GroupName="AdminTab" IsChecked="{Binding IsGamesTab, Mode=OneWay}"
                       Command="{Binding SelectTabCommand}" CommandParameter="games"/>
          <RadioButton Content="Wyróżnione" GroupName="AdminTab" IsChecked="{Binding IsFeaturedTab, Mode=OneWay}"
                       Command="{Binding SelectTabCommand}" CommandParameter="featured"/>
          <RadioButton Content="Użytkownicy" GroupName="AdminTab" IsChecked="{Binding IsUsersTab, Mode=OneWay}"
                       Command="{Binding SelectTabCommand}" CommandParameter="users"/>
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1" Content="Odśwież" Click="Refresh_OnClick" Padding="12,6" VerticalAlignment="Top"/>
    </Grid>

    <Panel Grid.Row="1" Margin="28,0,28,0">
      <TextBlock Text="{Binding StatusText}"
                 IsVisible="{Binding ShowEmpty}"
                 Opacity="0.6"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="420"/>

      <!-- Katalog: master-detail -->
      <Grid IsVisible="{Binding ShowGames}" ColumnDefinitions="360,*">
        <Border Classes="card" Padding="0" Margin="0,0,16,16">
          <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Margin="12,12,12,8" Spacing="8">
              <TextBox PlaceholderText="Szukaj po nazwie lub symbolu"
                       Text="{Binding SearchText, Mode=TwoWay}"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Wszystkie" Padding="10,4" FontSize="12"
                        Command="{Binding SetFilterCommand}" CommandParameter="all"/>
                <Button Content="Publiczne" Padding="10,4" FontSize="12"
                        Command="{Binding SetFilterCommand}" CommandParameter="published"/>
                <Button Content="Szkice" Padding="10,4" FontSize="12"
                        Command="{Binding SetFilterCommand}" CommandParameter="drafts"/>
                <Button Content="Wyróżnione" Padding="10,4" FontSize="12"
                        Command="{Binding SetFilterCommand}" CommandParameter="featured"/>
              </StackPanel>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding FilteredGames}"
                     SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AdminGameItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Classes="thumb" Width="40" Height="40">
                      <Panel>
                        <TextBlock Text="{Binding TileLabel}" FontSize="10" FontWeight="SemiBold" Opacity="0.7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"
                               IsVisible="{Binding HasCover}"/>
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding MetaText}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Border Classes="badge" Background="#3B82F6" IsVisible="{Binding FeaturedP}">
                        <TextBlock Text="★" FontSize="11" Foreground="White"/>
                      </Border>
                      <Border Classes="badge" Background="#66854D0E" IsVisible="{Binding DraftP}">
                        <TextBlock Text="Szkic" FontSize="11"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Margin="14,8,14,12" Text="{Binding ListSummary}" Classes="caption"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" IsVisible="{Binding HasSelection}">
          <StackPanel Spacing="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <RadioButton Content="Przegląd" GroupName="AdminEditorTab" IsChecked="{Binding IsOverviewTab, Mode=OneWay}"
                           Command="{Binding SelectEditorTabCommand}" CommandParameter="overview"/>
              <RadioButton Content="Strona sklepu" GroupName="AdminEditorTab" IsChecked="{Binding IsStoreTab, Mode=OneWay}"
                           Command="{Binding SelectEditorTabCommand}" CommandParameter="store"/>
              <RadioButton Content="Multimedia" GroupName="AdminEditorTab" IsChecked="{Binding IsMediaTab, Mode=OneWay}"
                           Command="{Binding SelectEditorTabCommand}" CommandParameter="media"/>
              <RadioButton Content="Buildy" GroupName="AdminEditorTab" IsChecked="{Binding IsBuildsTab, Mode=OneWay}"
                           Command="{Binding SelectEditorTabCommand}" CommandParameter="builds"/>
              <RadioButton Content="DLC" GroupName="AdminEditorTab" IsChecked="{Binding IsDlcTab, Mode=OneWay}"
                           Command="{Binding SelectEditorTabCommand}" CommandParameter="dlc"/>
            </StackPanel>

            <StackPanel Spacing="16" IsVisible="{Binding IsOverviewTab}">
              <Border Height="200" CornerRadius="8" ClipToBounds="True" Background="#1AFFFFFF">
                <Panel>
                  <TextBlock Text="{Binding SelectedGame.TileLabel}" FontSize="42" FontWeight="Bold"
                             Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding !SelectedGame.HasHeaderArt}"/>
                  <Image Source="{Binding SelectedGame.HeaderImageUrl}" Stretch="UniformToFill"
                         IsVisible="{Binding SelectedGame.HasHeaderArt}"/>
                  <StackPanel VerticalAlignment="Bottom" Margin="16,12" Spacing="2">
                    <TextBlock Text="{Binding SelectedGame.Title}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedGame.MetaText}" Classes="caption"/>
                    <TextBlock Text="{Binding SelectedGame.OwnerText}" Classes="caption"/>
                  </StackPanel>
                </Panel>
              </Border>
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Classes="card">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Pobrania" Classes="caption"/>
                    <TextBlock Text="{Binding TotalDownloadsText}" FontSize="22" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="2">
                    <TextBlock Text="30 dni" Classes="caption"/>
                    <TextBlock Text="{Binding Last30Text}" FontSize="22" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                  <StackPanel Spacing="2">
                    <TextBlock Text="7 dni" Classes="caption"/>
                    <TextBlock Text="{Binding Last7Text}" FontSize="22" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="card">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Wersja" Classes="caption"/>
                    <TextBlock Text="{Binding SelectedGame.CurrentVersionText}" FontSize="22" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="Widoczność" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="Opublikowana w sklepie"/>
                      <TextBlock Text="Szkic jest ukryty dla graczy." Classes="caption"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" OnContent="W sklepie" OffContent="Szkic"
                                  IsChecked="{Binding SelectedPublished, Mode=TwoWay}"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="Wyróżniona na stronie głównej"/>
                      <TextBlock Text="Trafia na szynę Wyróżnione; pierwsza pozycja to hero." Classes="caption"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" OnContent="Tak" OffContent="Nie"
                                  IsChecked="{Binding SelectedFeatured, Mode=TwoWay}"/>
                  </Grid>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Opublikuj nową wersję" Click="AddVersion_OnClick" Padding="14,8"/>
                <Button Content="Dodaj DLC" Click="AddDlc_OnClick" Padding="14,8"/>
                <Button Content="Usuń grę" Click="Delete_OnClick" Padding="14,8"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12" IsVisible="{Binding IsStoreTab}">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Podstawowe" FontWeight="SemiBold"/>
                  <TextBox PlaceholderText="Tytuł" Text="{Binding SelectedGame.EditTitle, Mode=TwoWay}"/>
                  <TextBox PlaceholderText="Opis" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88"
                           Text="{Binding SelectedGame.EditDescription, Mode=TwoWay}"/>
                  <TextBox PlaceholderText="Wymagania sprzętowe" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                           Text="{Binding SelectedGame.EditHardwareRequirements, Mode=TwoWay}"/>
                  <ComboBox PlaceholderText="Gatunek" ItemsSource="{Binding GenreOptions}"
                            SelectedItem="{Binding SelectedGame.EditGenre, Mode=TwoWay}"/>
                  <ComboBox PlaceholderText="Silnik" ItemsSource="{Binding EngineOptions}"
                            SelectedItem="{Binding SelectedGame.EditEngine, Mode=TwoWay}"/>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Wydanie, studio i funkcje" FontWeight="SemiBold"/>
                  <ComboBox ItemsSource="{Binding ReleaseStatusOptions}"
                            SelectedIndex="{Binding SelectedGame.EditReleaseStatusIndex, Mode=TwoWay}"/>
                  <ComboBox ItemsSource="{Binding AgeRatingOptions}"
                            SelectedIndex="{Binding SelectedGame.EditAgeRatingIndex, Mode=TwoWay}"/>
                  <TextBox PlaceholderText="Nazwa studia" Text="{Binding SelectedGame.EditStudioName, Mode=TwoWay}"/>
                  <TextBox PlaceholderText="Strona www" Text="{Binding SelectedGame.EditWebsiteUrl, Mode=TwoWay}"/>
                  <TextBox PlaceholderText="Discord" Text="{Binding SelectedGame.EditDiscordUrl, Mode=TwoWay}"/>
                  <TextBox PlaceholderText="Wsparcie" Text="{Binding SelectedGame.EditSupportUrl, Mode=TwoWay}"/>
                  <WrapPanel>
                    <CheckBox Content="Singleplayer" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasSinglePlayer, Mode=TwoWay}"/>
                    <CheckBox Content="Multiplayer" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasMultiPlayer, Mode=TwoWay}"/>
                    <CheckBox Content="Kooperacja" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasCoOp, Mode=TwoWay}"/>
                    <CheckBox Content="Pad" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasController, Mode=TwoWay}"/>
                    <CheckBox Content="Chmura" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasCloudSaves, Mode=TwoWay}"/>
                    <CheckBox Content="Osiągnięcia" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasAchievements, Mode=TwoWay}"/>
                    <CheckBox Content="Mody" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasModding, Mode=TwoWay}"/>
                    <CheckBox Content="VR" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasVr, Mode=TwoWay}"/>
                  </WrapPanel>
                  <TextBox PlaceholderText="Języki, np. Polski, English" Text="{Binding SelectedGame.EditLanguages, Mode=TwoWay}"/>
                  <TextBox PlaceholderText="Tagi, np. roguelike, pixel art" Text="{Binding SelectedGame.EditTags, Mode=TwoWay}"/>
                </StackPanel>
              </Border>
              <Button Content="Zapisz stronę sklepu" Classes="accent" Click="SaveStore_OnClick"
                      HorizontalAlignment="Left" Padding="16,8"/>
            </StackPanel>

            <StackPanel Spacing="12" IsVisible="{Binding IsMediaTab}">
              <Border Classes="card">
                <Grid ColumnDefinitions="120,*" ColumnSpacing="16">
                  <Border Height="160" Width="120" CornerRadius="6" Background="#1AFFFFFF">
                    <Image Source="{Binding SelectedGame.OwnCoverImageUrl}" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Miniaturka" FontWeight="SemiBold"/>
                    <TextBlock Text="Pionowa, na listy i w bibliotece (jak kapsuła Steam)."
                               Classes="caption" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Wybierz plik" Click="PickCover_OnClick"/>
                      <Button Content="Usuń" Click="ClearCover_OnClick"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="card">
                <Grid ColumnDefinitions="280,*" ColumnSpacing="16">
                  <Border Height="130" CornerRadius="6" Background="#1AFFFFFF">
                    <Image Source="{Binding SelectedGame.OwnHeaderImageUrl}" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Okładka pozioma" FontWeight="SemiBold"/>
                    <TextBlock Text="Szeroka, jak header na Steam — strona gry i wyróżnienia."
                               Classes="caption" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Wybierz plik" Click="PickHeader_OnClick"/>
                      <Button Content="Usuń" Click="ClearHeader_OnClick"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="card">
                <Grid ColumnDefinitions="140,*" ColumnSpacing="16">
                  <Border Height="140" Width="140" CornerRadius="6" Background="#1AFFFFFF">
                    <Image Source="{Binding SelectedGame.OwnLogoImageUrl}" Stretch="Uniform"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Logo (kwadratowe)" FontWeight="SemiBold"/>
                    <TextBlock Text="Kwadratowe logo na małe kafelki (np. lista zainstalowanych w sidebarze). Zalecane 512×512."
                               Classes="caption" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Wybierz plik" Click="PickLogo_OnClick"/>
                      <Button Content="Usuń" Click="ClearLogo_OnClick"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="Intro" FontWeight="SemiBold"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Wybierz wideo" Click="PickIntro_OnClick"/>
                    <Button Content="Usuń" Click="ClearIntro_OnClick"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Zrzuty ekranu" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="Dodaj" Click="AddScreenshot_OnClick"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding SelectedGame.ScreenshotItems}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="Usuń zrzut" Tag="{Binding}" Click="RemoveScreenshot_OnClick"
                                Margin="0,0,8,8" Padding="10,6"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="12" IsVisible="{Binding IsBuildsTab}">
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Aktualne buildy" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="Nowa wersja" Click="AddVersion_OnClick"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding SelectedGame.Builds}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="card" Margin="0,0,0,8" Padding="12">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="{Binding PlatformText}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding MetaText}" Classes="caption"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Version}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="Historia i opis zmian" FontWeight="SemiBold"/>
                  <ItemsControl ItemsSource="{Binding Versions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StudioVersionItem">
                        <Border Classes="card" Margin="0,0,0,10" Padding="12">
                          <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Version}" FontWeight="SemiBold"/>
                              <TextBlock Grid.Column="1" Text="{Binding MetaText}" Classes="caption"/>
                            </Grid>
                            <TextBox PlaceholderText="Notatki do tej wersji" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="64" Text="{Binding EditNotes, Mode=TwoWay}"/>
                            <Button Content="Zapisz opis zmian" Tag="{Binding}" Click="SaveNotes_OnClick"
                                    HorizontalAlignment="Left" Padding="12,6"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="12" IsVisible="{Binding IsDlcTab}">
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Dodatki" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="Dodaj DLC" Click="AddDlc_OnClick"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding SelectedGame.Dlcs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="card" Margin="0,0,0,8" Padding="12">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding MetaText}" Classes="caption"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Usuń" Tag="{Binding}" Click="DeleteDlc_OnClick"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Column="1" Text="Wybierz pozycję z listy"
                   Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !HasSelection}"/>
      </Grid>

      <!-- Kuracja wyróżnionych -->
      <Grid IsVisible="{Binding ShowFeatured}" ColumnDefinitions="*,420">
        <Border Classes="card" Padding="0" Margin="0,0,16,16">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Margin="16,14,16,8" Spacing="2">
              <TextBlock Text="Kolejność na stronie głównej" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding FeaturedSummary}" Classes="caption"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding FeaturedGames}" Margin="8,0,8,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AdminGameItem">
                    <Grid ColumnDefinitions="48,Auto,*,Auto" ColumnSpacing="12" Margin="6,5">
                      <TextBlock Text="{Binding PositionLabel}" VerticalAlignment="Center"
                                 FontWeight="SemiBold" FontSize="12" Opacity="0.6"/>
                      <Border Grid.Column="1" Classes="thumb" Width="56" Height="40">
                        <Panel>
                          <TextBlock Text="{Binding TileLabel}" FontSize="10" FontWeight="SemiBold" Opacity="0.7"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill" IsVisible="{Binding HasCover}"/>
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StateLabel}" Classes="caption"/>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Content="↑" Padding="10,4" Tag="{Binding}" Click="MoveUp_OnClick"
                                ToolTip.Tip="W górę"/>
                        <Button Content="↓" Padding="10,4" Tag="{Binding}" Click="MoveDown_OnClick"
                                ToolTip.Tip="W dół"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Spacing="12" Margin="0,0,0,16">
          <TextBlock Text="Podgląd hero" FontWeight="SemiBold"/>
          <Border Height="240" CornerRadius="8" ClipToBounds="True"
                  Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                  IsVisible="{Binding HasHeroPreview}">
            <Panel>
              <TextBlock Text="{Binding HeroPreview.TileLabel}" FontSize="56" FontWeight="SemiBold" Opacity="0.16"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Source="{Binding HeroPreview.HeaderImageUrl}" Stretch="UniformToFill"
                     IsVisible="{Binding HeroPreview.HasHeaderArt}"/>
              <Border VerticalAlignment="Bottom">
                <Border.Background>
                  <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#E6000000" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="16,40,16,14" Spacing="6">
                  <Border Classes="badge" Background="#3B82F6" HorizontalAlignment="Left">
                    <TextBlock Text="Wyróżnione" FontSize="11" Foreground="White"/>
                  </Border>
                  <TextBlock Text="{Binding HeroPreview.Title}" FontSize="22" FontWeight="SemiBold"
                             Foreground="White" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>
            </Panel>
          </Border>
          <TextBlock Text="Tak zobaczy to gracz na górze strony głównej."
                     Classes="caption" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <!-- Użytkownicy -->
      <ScrollViewer IsVisible="{Binding ShowUsers}" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Users}" Margin="0,0,0,16">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AdminUserItem">
              <Border Classes="card" Padding="14" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                  <Border Width="40" Height="40" CornerRadius="20" Background="#2AFFFFFF">
                    <TextBlock Text="{Binding Initials}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16"/>
                      <Border Classes="badge" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RoleLabel}" FontSize="11"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding MetaText}" Classes="caption" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding RoleHint}" Classes="caption"
                             MaxWidth="180" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="3" MinWidth="150" VerticalAlignment="Center"
                            ItemsSource="{Binding RoleOptions}"
                            SelectedIndex="{Binding RoleIndex, Mode=TwoWay}"
                            IsEnabled="{Binding CanEditRole}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

    <Border Grid.Row="2" Padding="28,10" BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding StatusText}" Opacity="0.7" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
        <ProgressBar Grid.Column="1" Width="80" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
