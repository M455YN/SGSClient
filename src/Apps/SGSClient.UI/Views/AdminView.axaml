<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.AdminView"
             x:DataType="vm:AdminViewModel">
  <Grid Margin="28,24,28,24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Moderacja katalogu i przegląd użytkowników."
                   Opacity="0.65" TextWrapping="Wrap"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Odśwież" Click="Refresh_OnClick" Padding="12,6" VerticalAlignment="Top"/>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button Content="Gry" Command="{Binding SelectTabCommand}" CommandParameter="games" Padding="14,8"/>
      <Button Content="Użytkownicy" Command="{Binding SelectTabCommand}" CommandParameter="users" Padding="14,8"/>
    </StackPanel>

    <Panel Grid.Row="2">
      <TextBlock Text="{Binding StatusText}"
                 IsVisible="{Binding ShowEmpty}"
                 Opacity="0.6"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="420"/>

      <ScrollViewer IsVisible="{Binding ShowGames}" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Games}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AdminGameItem">
              <Border Padding="14" Margin="0,0,0,10" CornerRadius="10"
                      Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MetaText}" Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" Opacity="0.7" FontSize="12"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                    <Button Content="Edytuj" Padding="10,6" Tag="{Binding}" Click="Edit_OnClick"/>
                    <Button Content="Szkic" Padding="10,6" Tag="{Binding}" Click="ToggleDraft_OnClick"/>
                    <Button Content="Featured" Padding="10,6" Tag="{Binding}" Click="ToggleFeatured_OnClick"/>
                    <Button Content="Usuń" Padding="10,6" Tag="{Binding}" Click="Delete_OnClick"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <ScrollViewer IsVisible="{Binding ShowUsers}" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Users}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AdminUserItem">
              <Border Padding="14" Margin="0,0,0,8" CornerRadius="10"
                      Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16"/>
                  <TextBlock Text="{Binding MetaText}" Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

    <TextBlock Grid.Row="3" Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
