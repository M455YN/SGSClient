<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             xmlns:conv="using:SGSClient.UI.Converters"
             x:Class="SGSClient.UI.Views.AddMediaView"
             x:DataType="vm:AddMediaViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,24,28,32" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding DropHint}" Opacity="0.65" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding AuthHint}" Opacity="0.55" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>

      <Border DragDrop.AllowDrop="True" DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop"
              MinHeight="140" Padding="24" CornerRadius="10" Background="#1AFFFFFF"
              BorderBrush="#55FFFFFF" BorderThickness="2">
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{loc:Tr Key='Przeciągnij pliki tutaj lub'}" Opacity="0.7" HorizontalAlignment="Center"/>
          <Button Content="{Binding AddFilesLabel}" Click="OnAddFiles" Padding="16,8" HorizontalAlignment="Center"
                  IsEnabled="{Binding !IsBusy}"/>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Entries}" IsVisible="{Binding HasEntries}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:UploadEntry">
            <Border Padding="10" CornerRadius="8" Background="#1AFFFFFF">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Panel Grid.Column="0" Width="72" Height="72">
                  <Border CornerRadius="6" Background="#33FFFFFF"/>
                  <TextBlock Text="♪" FontSize="28" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{ReflectionBinding $parent[ItemsControl].DataContext.IsMusic}"/>
                  <Image Source="{Binding Path, Converter={x:Static conv:FileUriToBitmapConverter.Instance}}"
                         Stretch="UniformToFill" Width="72" Height="72"
                         IsVisible="{ReflectionBinding !$parent[ItemsControl].DataContext.IsMusic}"/>
                </Panel>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBox Text="{Binding Title, Mode=TwoWay}" PlaceholderText="{loc:Tr Key='Tytuł'}"/>
                  <TextBlock Text="{Binding FileName}" Opacity="0.55" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding StateText}" Opacity="0.75" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" VerticalAlignment="Center"
                        ToolTip.Tip="{loc:Tr Key='Usuń z listy'}"
                        Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveCommand}"
                        CommandParameter="{Binding}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
              IsVisible="{Binding HasEntries}">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Tagi'}" Opacity="0.55" FontSize="12"/>
            <TextBox Text="{Binding Tags, Mode=TwoWay}" PlaceholderText="{loc:Tr Key='Tagi oddzielone przecinkami'}"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Opis (dla wszystkich)'}" Opacity="0.55" FontSize="12"/>
            <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="88"/>
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding ShowCover}">
            <TextBlock Text="{loc:Tr Key='Okładka'}" Opacity="0.55" FontSize="12"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding CoverPath}" PlaceholderText="{loc:Tr Key='Brak okładki'}"
                       IsReadOnly="True"/>
              <Button Grid.Column="1" Content="{loc:Tr Key='Wybierz okładkę…'}" Click="OnPickCover"
                      Padding="12,8" IsEnabled="{Binding !IsBusy}"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasEntries}">
        <Button Content="{loc:Tr Key='Opublikuj'}" Command="{CompiledBinding PublishAllCommand}"
                IsEnabled="{Binding !IsBusy}" Padding="18,12" Background="#2E7D32" Foreground="White"/>
        <Button Content="{loc:Tr Key='Wyczyść'}" Command="{CompiledBinding ClearCommand}"
                IsEnabled="{Binding !IsBusy}" Padding="14,12"/>
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding IsBusy}">
        <TextBlock Text="{loc:Tr Key='Wysyłanie…'}" Opacity="0.7"/>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="8"/>
      </StackPanel>

      <TextBlock Text="{Binding StatusText}" Opacity="0.75" TextWrapping="Wrap"/>

      <ItemsControl ItemsSource="{Binding Issues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="#EF9A9A" Margin="0,0,0,4" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
