<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.LoginView"
             x:DataType="vm:LoginGateViewModel">
  <Grid ColumnDefinitions="*,440">
    <Panel Grid.Column="0">
      <Image Source="avares://SGSClient/Assets/Login/login-background.jpg"
             Stretch="UniformToFill"/>
      <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0"/>
    </Panel>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="56,48"
          Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Image Source="avares://SGSClient/Assets/Login/sgs-logo.png"
               Width="32" Height="32"/>
        <TextBlock Text="SGSClient" FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="{Binding HeadingText}" FontSize="28" FontWeight="SemiBold"
                   IsVisible="{Binding IsLoginStep}"/>
        <TextBlock Text="{Binding SubheadingText}" FontSize="14" TextWrapping="Wrap"
                   IsVisible="{Binding IsLoginStep}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <StackPanel Spacing="8" IsVisible="{Binding IsFolderStep}">
          <TextBlock Text="{Binding FolderStepTitle}" FontSize="28" FontWeight="SemiBold"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Binding FolderStepHint}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="{Binding GamesFolder}" FontWeight="SemiBold" TextWrapping="Wrap"
                     Margin="0,8,0,0"/>
          <Button Content="{loc:Tr Key='Zmień folder…'}" Click="BrowseGamesFolder_OnClick"
                  IsEnabled="{Binding !IsBusy}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="36"/>
          <Button Content="{loc:Tr Key='Dalej'}" Classes="accent"
                  Command="{Binding ContinueSetupCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="36"
                  Margin="0,8,0,0"/>
        </StackPanel>

        <Button Content="{loc:Tr Key='Zaloguj się'}"
                IsVisible="{Binding IsLoginStep}"
                Classes="accent"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding !IsBusy}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                MinHeight="36"
                Margin="0,24,0,0"/>

        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0"
                    IsVisible="{Binding IsLoginStep}">
          <TextBlock Text="{loc:Tr Key='Nie masz konta?'}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <Button Command="{Binding SignUpCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Background="Transparent" BorderThickness="0"
                  Padding="4,2" Cursor="Hand">
            <TextBlock Text="{loc:Tr Key='Zarejestruj się'}" FontSize="12"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
          </Button>
        </StackPanel>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                     Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                     MaxWidth="240" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <Button Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"
                  Background="Transparent" BorderThickness="0"
                  Padding="4,2" Cursor="Hand" VerticalAlignment="Center">
            <TextBlock Text="{loc:Tr Key='Anuluj'}" FontSize="12"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
          </Button>
        </StackPanel>
      </StackPanel>

      <TextBlock Grid.Row="2" Text="{Binding VersionText}" FontSize="12"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Grid>
  </Grid>
</UserControl>
