<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="PersonRow" x:DataType="vm:SocialPersonItem">
      <Border Margin="0,0,0,10" Padding="14" CornerRadius="8"
              Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Width="44" Height="44" CornerRadius="22" Background="#2A2A2A">
            <TextBlock Text="{Binding Initials}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="12"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Content="Akceptuj" Tag="{Binding}" Click="Accept_OnClick" Padding="10,6"
                    IsVisible="{Binding ShowAccept}"/>
            <Button Content="Dodaj" Tag="{Binding}" Click="AddFriend_OnClick" Padding="10,6"
                    IsVisible="{Binding ShowAddFriend}"/>
            <Button Content="{Binding RemoveFriendLabel}" Tag="{Binding}" Click="RemoveFriend_OnClick" Padding="10,6"
                    IsVisible="{Binding ShowRemoveFriend}"/>
            <Button Content="Obserwuj" Tag="{Binding}" Click="Follow_OnClick" Padding="10,6"
                    IsVisible="{Binding ShowFollow}"/>
            <Button Content="Przestań" Tag="{Binding}" Click="Unfollow_OnClick" Padding="10,6"
                    IsVisible="{Binding ShowUnfollow}"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,24,28,32" Spacing="18" MaxWidth="920" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Text="Znajomi" FontSize="32" FontWeight="Bold"/>
        <TextBlock Text="{Binding StatusText}" Opacity="0.7" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding SearchQuery}" PlaceholderText="Szukaj gracza po nazwie…" MinHeight="36"/>
        <Button Grid.Column="1" Content="Szukaj" Command="{Binding SearchCommand}" Padding="16,8"/>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Content="Znajomi" Tag="Friends" Click="Tab_OnClick" Padding="14,8"/>
        <Button Content="{Binding RequestsTabLabel}" Tag="Requests" Click="Tab_OnClick" Padding="14,8"/>
        <Button Content="Obserwowane" Tag="Following" Click="Tab_OnClick" Padding="14,8"/>
        <Button Content="Obserwujący" Tag="Followers" Click="Tab_OnClick" Padding="14,8"/>
        <Button Content="Szukaj" Tag="Search" Click="Tab_OnClick" Padding="14,8"/>
      </StackPanel>
      <Border Height="1" Background="#33FFFFFF"/>

      <StackPanel Spacing="8" IsVisible="{Binding ShowFriendsTab}">
        <TextBlock Text="Nie masz jeszcze znajomych. Wyszukaj gracza po nazwie."
                   Opacity="0.6" TextWrapping="Wrap" IsVisible="{Binding ShowEmptyFriends}"/>
        <ItemsControl ItemsSource="{Binding Friends}" ItemTemplate="{StaticResource PersonRow}"/>
      </StackPanel>

      <StackPanel Spacing="14" IsVisible="{Binding ShowRequestsTab}">
        <StackPanel Spacing="8">
          <TextBlock Text="Do Ciebie" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Brak nowych zaproszeń." Opacity="0.6" IsVisible="{Binding !HasIncoming}"/>
          <ItemsControl ItemsSource="{Binding Incoming}" ItemTemplate="{StaticResource PersonRow}"/>
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="Wysłane" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Nie czekasz na żadną odpowiedź." Opacity="0.6" IsVisible="{Binding !HasOutgoing}"/>
          <ItemsControl ItemsSource="{Binding Outgoing}" ItemTemplate="{StaticResource PersonRow}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding ShowFollowingTab}">
        <TextBlock Text="Nikogo nie obserwujesz." Opacity="0.6" IsVisible="{Binding ShowEmptyFollowing}"/>
        <ItemsControl ItemsSource="{Binding Following}" ItemTemplate="{StaticResource PersonRow}"/>
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding ShowFollowersTab}">
        <TextBlock Text="Nikt Cię jeszcze nie obserwuje." Opacity="0.6" IsVisible="{Binding ShowEmptyFollowers}"/>
        <ItemsControl ItemsSource="{Binding Followers}" ItemTemplate="{StaticResource PersonRow}"/>
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding ShowSearchTab}">
        <TextBlock Text="Wpisz nazwę i naciśnij Szukaj." Opacity="0.6" IsVisible="{Binding ShowEmptySearch}"/>
        <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource PersonRow}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
