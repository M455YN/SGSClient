<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="SGSClient.UI.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">
  <UserControl.Styles>
    <Style Selector="Button.closeGlyph">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.closeGlyph:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.closeGlyph:pressed">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="PersonRow" x:DataType="vm:SocialPersonItem">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4">
        <Button Background="Transparent" BorderThickness="0" Padding="0" Tag="{Binding}"
                Click="OpenProfile_OnClick" ToolTip.Tip="Otwórz profil">
          <Grid Width="40" Height="40">
            <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
              <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
            <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Fill="{DynamicResource SystemFillColorSuccessBrush}"
                     Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2"
                     IsVisible="{Binding IsOnline}"/>
            <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                     Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="2"
                     IsVisible="{Binding !IsOnline}"/>
          </Grid>
        </Button>
        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Tag="{Binding}" Click="OpenProfile_OnClick">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Content="{loc:Tr Key='Napisz'}" Tag="{Binding}" Click="Message_OnClick" Classes="compact"
                  IsVisible="{Binding ShowMessage}"/>
          <Button Content="{loc:Tr Key='Akceptuj'}" Tag="{Binding}" Click="Accept_OnClick" Classes="accent compact"
                  IsVisible="{Binding ShowAccept}"/>
          <Button Content="{loc:Tr Key='Dodaj'}" Tag="{Binding}" Click="AddFriend_OnClick" Classes="accent compact"
                  IsVisible="{Binding ShowAddFriend}"/>
          <Button Content="{Binding RemoveFriendLabel}" Tag="{Binding}" Click="RemoveFriend_OnClick" Classes="compact"
                  IsVisible="{Binding ShowRemoveFriend}"/>
          <Button Content="{loc:Tr Key='Obserwuj'}" Tag="{Binding}" Click="Follow_OnClick" Classes="compact"
                  IsVisible="{Binding ShowFollow}"/>
          <Button Content="{loc:Tr Key='Przestań'}" Tag="{Binding}" Click="Unfollow_OnClick" Classes="compact"
                  IsVisible="{Binding ShowUnfollow}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16,12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Click="OverlayProfile_OnClick" ToolTip.Tip="Twój profil">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:FASymbolIcon Symbol="Contact" FontSize="16"/>
            <TextBlock Text="{loc:Tr Key='Profil'}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Tag="Friends" Click="Tab_OnClick" ToolTip.Tip="Znajomi"
                Classes.accent="{Binding ShowFriendsTab}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:FASymbolIcon Symbol="People" FontSize="16"/>
            <TextBlock Text="{loc:Tr Key='Znajomi'}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Tag="Chat" Click="Tab_OnClick" ToolTip.Tip="Czat"
                Classes.accent="{Binding ShowChatTab}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:FASymbolIcon Symbol="Message" FontSize="16"/>
            <TextBlock Text="{loc:Tr Key='Czat'}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Tag="Search" Click="Tab_OnClick" ToolTip.Tip="Dodaj znajomego"
                Classes.accent="{Binding ShowSearchTab}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:FASymbolIcon Symbol="AddFriend" FontSize="16"/>
            <TextBlock Text="{loc:Tr Key='Dodaj'}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <Button Grid.Column="1" Classes="closeGlyph" VerticalAlignment="Center"
              Click="Close_OnClick" ToolTip.Tip="Zamknij">
        <ui:FASymbolIcon Symbol="Cancel" FontSize="12"/>
      </Button>
    </Grid>

    <TextBlock Grid.Row="1" Text="{loc:Tr Key='Społeczność'}" FontSize="20" FontWeight="SemiBold" Margin="4,8,4,4"/>

    <TextBox Grid.Row="2" Text="{Binding SearchQuery}" PlaceholderText="{Binding SearchPlaceholder}"
             MinHeight="32" KeyDown="SearchBox_OnKeyDown"
             IsVisible="{Binding ShowMainList}"/>

    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding StatusText}" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding !ShowProfileView}"/>

        <!-- Public profile + wall -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowProfileView}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Tr Key='← Wróć'}" Click="CloseProfile_OnClick" Classes="compact"/>
            <Button Content="{loc:Tr Key='Napisz wiadomość'}" Click="MessageFromProfile_OnClick" Classes="accent compact"
                    IsVisible="{Binding CanMessageProfile}"/>
          </StackPanel>
          <TextBlock Text="{Binding ProfileHeader}" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ProfileSubtitle}" Opacity="0.7" FontSize="13"/>
          <TextBlock Text="{loc:Tr Key='Osiągnięcia'}" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding ProfileAchievementsText}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding ProfileAchievements}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AchievementSummaryItem">
                <Grid Margin="0,0,0,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Opacity="0.75"/>
                  <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="1"
                               Value="{Binding Fraction}" Height="4" Margin="0,4,0,0"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{loc:Tr Key='Ściana'}" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <TextBox Text="{Binding ProfileCommentDraft}" PlaceholderText="{loc:Tr Key='Podpisz się pod profilem…'}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
          <Button Content="{loc:Tr Key='Dodaj podpis'}" Classes="accent compact" Click="PostComment_OnClick"
                  HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding ProfileStatus}" FontSize="12" Opacity="0.65"/>
          <ItemsControl ItemsSource="{Binding ProfileComments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileCommentItem">
                <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                        Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding AuthorLabel}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding WhenText}" FontSize="11" Opacity="0.55"/>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{loc:Tr Key='Usuń'}" Classes="compact"
                            Tag="{Binding}" Click="DeleteComment_OnClick"
                            IsVisible="{Binding CanDelete}" VerticalAlignment="Top"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Chat -->
        <Grid IsVisible="{Binding ShowChatTab}" ColumnDefinitions="140,*" ColumnSpacing="10" MinHeight="320">
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Key='Rozmowy'}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ChatStatus}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Tr Key='Brak rozmów.'}" FontSize="12" Opacity="0.55" IsVisible="{Binding ShowEmptyChat}"/>
            <ItemsControl ItemsSource="{Binding ChatThreads}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatThreadItem">
                  <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="8,6" Margin="0,0,0,4" Tag="{Binding}" Click="OpenThread_OnClick">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding UnreadBadge}" FontSize="11" Opacity="0.7"/>
                      </Grid>
                      <TextBlock Text="{Binding Preview}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="8" IsVisible="{Binding ShowChatConversation}">
            <TextBlock Text="{Binding ChatPeerTitle}" FontWeight="SemiBold" FontSize="16"/>
            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ChatMessages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatMessageItem">
                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8"
                            Background="#22FFFFFF" HorizontalAlignment="Left" MaxWidth="280">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Meta}" FontSize="10" Opacity="0.55"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ChatDraft}" PlaceholderText="{loc:Tr Key='Wiadomość…'}" KeyDown="ChatDraft_OnKeyDown"/>
              <Button Grid.Column="1" Content="{loc:Tr Key='Wyślij'}" Classes="accent" Click="SendChat_OnClick"/>
            </Grid>
          </StackPanel>
        </Grid>

        <StackPanel Spacing="8" IsVisible="{Binding ShowFriendsTab}">
          <TextBlock Text="{loc:Tr Key='Nie masz jeszcze znajomych. Wpisz nazwę lub @tag, żeby kogoś znaleźć.'}"
                     FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" IsVisible="{Binding ShowEmptyFriends}"/>

          <Expander Header="{loc:Tr Key='Zaproszenia'}" IsExpanded="{Binding IncomingExpanded}"
                    IsVisible="{Binding HasIncoming}">
            <ItemsControl ItemsSource="{Binding Incoming}" ItemTemplate="{StaticResource PersonRow}"/>
          </Expander>

          <StackPanel Spacing="8" IsVisible="{Binding ShowFriendsGroups}">
            <Expander IsExpanded="{Binding OnlineExpanded}">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Online" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding OnlineCount}" Opacity="0.55" FontSize="13"/>
                </Grid>
              </Expander.Header>
              <ItemsControl ItemsSource="{Binding OnlineFriends}" ItemTemplate="{StaticResource PersonRow}"/>
            </Expander>
            <Expander IsExpanded="{Binding OfflineExpanded}">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Offline" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding OfflineCount}" Opacity="0.55" FontSize="13"/>
                </Grid>
              </Expander.Header>
              <ItemsControl ItemsSource="{Binding OfflineFriends}" ItemTemplate="{StaticResource PersonRow}"/>
            </Expander>
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowRequestsTab}">
          <TextBlock Text="{loc:Tr Key='Do Ciebie'}" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Tr Key='Brak nowych zaproszeń.'}" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsVisible="{Binding !HasIncoming}"/>
          <ItemsControl ItemsSource="{Binding Incoming}" ItemTemplate="{StaticResource PersonRow}"/>
          <TextBlock Text="{loc:Tr Key='Wysłane'}" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Tr Key='Nie czekasz na żadną odpowiedź.'}" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsVisible="{Binding !HasOutgoing}"/>
          <ItemsControl ItemsSource="{Binding Outgoing}" ItemTemplate="{StaticResource PersonRow}"/>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowFollowingTab}">
          <TextBlock Text="{loc:Tr Key='Obserwowane'}" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Tr Key='Nikogo nie obserwujesz.'}" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsVisible="{Binding ShowEmptyFollowing}"/>
          <ItemsControl ItemsSource="{Binding Following}" ItemTemplate="{StaticResource PersonRow}"/>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowFollowersTab}">
          <TextBlock Text="{loc:Tr Key='Obserwujący'}" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Tr Key='Nikt Cię jeszcze nie obserwuje.'}" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsVisible="{Binding ShowEmptyFollowers}"/>
          <ItemsControl ItemsSource="{Binding Followers}" ItemTemplate="{StaticResource PersonRow}"/>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowSearchTab}">
          <TextBlock Text="{loc:Tr Key='Wpisz nazwę lub @tag i naciśnij Enter.'}" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     IsVisible="{Binding ShowEmptySearch}"/>
          <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource PersonRow}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
