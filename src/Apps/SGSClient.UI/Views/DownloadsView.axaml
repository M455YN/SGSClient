<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">
  <Grid Margin="28,24" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="{loc:Tr Key='Pobrania'}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding StatusText}" Opacity="0.65" FontSize="13"/>
      </StackPanel>
      <Button Grid.Column="1" Content="{loc:Tr Key='Odśwież'}" Padding="12,6"
              Command="{Binding RefreshListCommand}" VerticalAlignment="Top"/>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
      <TextBlock Text="{loc:Tr Key='Limit pasma (KB/s):'}" VerticalAlignment="Center" Opacity="0.75" FontSize="13"/>
      <NumericUpDown Width="120" Minimum="0" Maximum="100000"
                     Value="{Binding DownloadMaxKbps}"
                     FormatString="0"
                     ToolTip.Tip="0 = bez limitu"/>
      <TextBlock Text="{loc:Tr Key='0 = bez limitu'}" VerticalAlignment="Center" Opacity="0.5" FontSize="12"/>
    </StackPanel>

    <Panel Grid.Row="2">
      <TextBlock Text="{loc:Tr Key='Brak aktywnych pobierań.'}" Opacity="0.6"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding IsEmpty}"/>
      <ListBox ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}"
               Background="Transparent" DoubleTapped="Item_OnDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DownloadRowItem">
            <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="16" Margin="4,8">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock FontSize="12" Opacity="0.7"
                           Text="{Binding KindText}"/>
                <TextBlock Text="{Binding StateText}" FontSize="12" Opacity="0.7"/>
                <TextBlock Text="{Binding DetailText}" FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                          IsVisible="{Binding ShowProgress}">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6"/>
                <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.65"
                           HorizontalAlignment="Right"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="↑" Padding="8,6" ToolTip.Tip="Wyżej w kolejce"
                        IsVisible="{Binding CanMoveUp}"
                        Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).MoveUpCommand}"
                        CommandParameter="{Binding}"/>
                <Button Content="↓" Padding="8,6" ToolTip.Tip="Niżej w kolejce"
                        IsVisible="{Binding CanMoveDown}"
                        Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).MoveDownCommand}"
                        CommandParameter="{Binding}"/>
                <Button Content="{loc:Tr Key='Pauza'}" Padding="12,6"
                        IsVisible="{Binding CanPause}"
                        Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).PauseCommand}"
                        CommandParameter="{Binding}"/>
                <Button Content="{loc:Tr Key='Wznów'}" Padding="12,6"
                        IsVisible="{Binding CanResume}"
                        Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).ResumeCommand}"
                        CommandParameter="{Binding}"/>
                <Button Content="{loc:Tr Key='Anuluj'}" Padding="12,6"
                        IsVisible="{Binding CanCancel}"
                        Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).CancelCommand}"
                        CommandParameter="{Binding}"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </Grid>
</UserControl>
