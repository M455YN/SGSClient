<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">
  <Grid Margin="28,24" RowDefinitions="Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="Pobrania" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding StatusText}" Opacity="0.65" FontSize="13"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Odśwież" Padding="12,6"
              Command="{Binding RefreshListCommand}" VerticalAlignment="Top"/>
    </Grid>

    <Panel Grid.Row="1">
      <TextBlock Text="Brak aktywnych pobierań." Opacity="0.6"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding IsEmpty}"/>
      <ListBox ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}"
               Background="Transparent" DoubleTapped="Item_OnDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DownloadRowItem">
            <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="16" Margin="4,8">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock FontSize="12" Opacity="0.7"
                           Text="{Binding KindText}"/>
                <TextBlock Text="{Binding StateText}" FontSize="12" Opacity="0.7"/>
                <TextBlock Text="{Binding DetailText}" FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                          IsVisible="{Binding ShowProgress}">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6"/>
                <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.65"
                           HorizontalAlignment="Right"/>
              </StackPanel>
              <Button Grid.Column="2" Content="Anuluj" Padding="12,6"
                      VerticalAlignment="Center" IsVisible="{Binding CanCancel}"
                      Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).CancelCommand}"
                      CommandParameter="{Binding}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </Grid>
</UserControl>
