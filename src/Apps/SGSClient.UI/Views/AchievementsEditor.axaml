<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:SGSClient.UI.Converters"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.AchievementsEditor"
             x:DataType="vm:AchievementsEditorViewModel">
  <!-- Steamworks-style admin: an achievements table (each one edited in a dialog and saved at once)
       and a stats table edited in place. -->
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="BorderBrush" Value="#22FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="4,8"/>
      <Setter Property="BorderBrush" Value="#22FFFFFF"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
    <Style Selector="Border.icon">
      <Setter Property="Width" Value="64"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Opacity" Value="0.7"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">
    <!-- ===== Achievements ===== -->
    <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{loc:Tr Key='Osiągnięcia'}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Summary}" Classes="caption"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="{loc:Tr Key='Nowe osiągnięcie'}" Classes="accent" Click="New_OnClick"/>
          <Button Classes="icon" Content="⟳" Command="{Binding ReloadCommand}" ToolTip.Tip="{loc:Tr Key='Odśwież'}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="card" Padding="12">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="32,170,*,60,64,64,130,164" ColumnSpacing="10" Margin="4,0,4,6">
          <TextBlock Text="ID" Classes="head"/>
          <TextBlock Grid.Column="1" Text="{loc:Tr Key='API name'}" Classes="head"/>
          <TextBlock Grid.Column="2" Text="{loc:Tr Key='Nazwa / opis'}" Classes="head"/>
          <TextBlock Grid.Column="3" Text="{loc:Tr Key='Ukryte?'}" Classes="head"/>
          <TextBlock Grid.Column="4" Text="{loc:Tr Key='Ikona zdobyta'}" Classes="head"/>
          <TextBlock Grid.Column="5" Text="{loc:Tr Key='Ikona niezdobyta'}" Classes="head"/>
          <TextBlock Grid.Column="6" Text="{loc:Tr Key='Postęp'}" Classes="head"/>
        </Grid>

        <!-- empty state -->
        <StackPanel Spacing="8" Margin="4,16" HorizontalAlignment="Center" IsVisible="{Binding !HasItems}">
          <TextBlock Text="{loc:Tr Key='Ta gra nie ma jeszcze osiągnięć.'}" HorizontalAlignment="Center" Opacity="0.7"/>
          <Button Content="{loc:Tr Key='Dodaj pierwsze osiągnięcie'}" HorizontalAlignment="Center" Click="New_OnClick"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StudioAchievementItem">
              <Border Classes="row">
                <Grid ColumnDefinitions="32,170,*,60,64,64,130,164" ColumnSpacing="10">
                  <TextBlock Text="{Binding RowId}" Opacity="0.7"/>
                  <SelectableTextBlock Grid.Column="1" Text="{Binding EditKey}" FontFamily="Consolas,Menlo,monospace"
                                       FontSize="12" TextWrapping="Wrap"/>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding EditDescription}" Opacity="0.75" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatsText}" Classes="caption"/>
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding HiddenText}"/>
                  <Border Grid.Column="4" Classes="icon">
                    <Image conv:ImageUrl.Source="{Binding IconPreviewUrl}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}"/>
                  </Border>
                  <Border Grid.Column="5" Classes="icon">
                    <Image conv:ImageUrl.Source="{Binding LockedColumnUrl}" Stretch="UniformToFill"
                           Opacity="{Binding LockedColumnOpacity}" IsVisible="{Binding HasLockedColumnIcon}"/>
                  </Border>
                  <TextBlock Grid.Column="6" Text="{Binding ProgressText}" FontSize="12" TextWrapping="Wrap"/>
                  <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Classes="icon" Content="▲" Tag="{Binding}" Click="MoveUp_OnClick" ToolTip.Tip="{loc:Tr Key='Przenieś wyżej'}"/>
                    <Button Classes="icon" Content="▼" Tag="{Binding}" Click="MoveDown_OnClick" ToolTip.Tip="{loc:Tr Key='Przenieś niżej'}"/>
                    <Button Classes="icon" Content="✎" Tag="{Binding}" Click="Edit_OnClick" ToolTip.Tip="{loc:Tr Key='Edytuj'}"/>
                    <Button Classes="icon" Content="🗑" Tag="{Binding}" Click="Delete_OnClick" ToolTip.Tip="{loc:Tr Key='Usuń'}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ===== Stats ===== -->
    <Border Classes="card" Padding="12">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,0,4,8">
          <StackPanel Spacing="2">
            <TextBlock Text="{loc:Tr Key='Statystyki'}" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr Key='Liczby zapisywane przez grę dla każdego gracza. Osiągnięcie z rodzajem „Postęp ze statystyki” pokazuje jej wartość jako postęp i odblokowuje się po osiągnięciu celu.'}"
                       Classes="caption" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Top" Content="{loc:Tr Key='Nowa statystyka'}" Click="NewStat_OnClick"/>
        </Grid>
        <Grid ColumnDefinitions="32,170,64,*,140,80,80,88" ColumnSpacing="10" Margin="4,0,4,6" IsVisible="{Binding HasStats}">
          <TextBlock Text="ID" Classes="head"/>
          <TextBlock Grid.Column="1" Text="{loc:Tr Key='API name'}" Classes="head"/>
          <TextBlock Grid.Column="2" Text="{loc:Tr Key='Typ'}" Classes="head"/>
          <TextBlock Grid.Column="3" Text="{loc:Tr Key='Nazwa wyświetlana'}" Classes="head"/>
          <TextBlock Grid.Column="4" Text="{loc:Tr Key='Zakres'}" Classes="head"/>
          <TextBlock Grid.Column="5" Text="{loc:Tr Key='Domyślna'}" Classes="head"/>
          <TextBlock Grid.Column="6" Text="{loc:Tr Key='Tylko rośnie'}" Classes="head"/>
        </Grid>
        <TextBlock Text="{loc:Tr Key='Ta gra nie ma jeszcze statystyk.'}" Opacity="0.6" Margin="4,8" IsVisible="{Binding !HasStats}"/>

        <ItemsControl ItemsSource="{Binding Stats}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StudioStatItem">
              <Border Classes="row">
                <Grid ColumnDefinitions="32,170,64,*,140,80,80,88" ColumnSpacing="10">
                  <TextBlock Text="{Binding RowId}" Opacity="0.7"/>
                  <SelectableTextBlock Grid.Column="1" Text="{Binding EditKey}" FontFamily="Consolas,Menlo,monospace"
                                       FontSize="12" TextWrapping="Wrap"/>
                  <TextBlock Grid.Column="2" Text="{Binding TypeText}" FontSize="12"/>
                  <TextBlock Grid.Column="3" Text="{Binding EditDisplayName}" TextWrapping="Wrap"/>
                  <TextBlock Grid.Column="4" Text="{Binding RangeText}" FontSize="12"/>
                  <TextBlock Grid.Column="5" Text="{Binding EditDefault}" FontSize="12"/>
                  <TextBlock Grid.Column="6" Text="{Binding IncrementOnlyText}" FontSize="12"/>
                  <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button Classes="icon" Content="✎" Tag="{Binding}" Click="EditStat_OnClick" ToolTip.Tip="{loc:Tr Key='Edytuj'}"/>
                    <Button Classes="icon" Content="🗑" Tag="{Binding}" Click="DeleteStat_OnClick" ToolTip.Tip="{loc:Tr Key='Usuń'}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{loc:Tr Key='Wyzeruj mój postęp'}" Command="{Binding ResetProgressCommand}" Padding="14,8"
              ToolTip.Tip="{loc:Tr Key='Czyści Twoje osiągnięcia i statystyki w tej grze, żeby przetestować je od nowa.'}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
