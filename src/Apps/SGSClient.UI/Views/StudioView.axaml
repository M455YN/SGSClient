<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:views="using:SGSClient.UI.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.StudioView"
             x:DataType="vm:StudioViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="BorderBrush" Value="#22FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Margin="28,20,28,12" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Tr Key='Panel twórcy'}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="{loc:Tr Key='Strona sklepu, multimedia, buildy i DLC.'}" Classes="caption"/>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
          <RadioButton Content="{loc:Tr Key='Gry'}" GroupName="StudioSection" IsChecked="True"
                       Command="{Binding SelectSectionCommand}" CommandParameter="games"/>
          <RadioButton Content="{loc:Tr Key='Grafiki'}" GroupName="StudioSection"
                       Command="{Binding SelectSectionCommand}" CommandParameter="art"/>
          <RadioButton Content="{loc:Tr Key='Muzyka'}" GroupName="StudioSection"
                       Command="{Binding SelectSectionCommand}" CommandParameter="music"/>
          <RadioButton Content="{loc:Tr Key='Opowiadania'}" GroupName="StudioSection"
                       Command="{Binding SelectSectionCommand}" CommandParameter="stories"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Content="{loc:Tr Key='Dodaj'}" Classes="accent" Padding="14,8">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{loc:Tr Key='Dodaj grę'}" Click="AddGame_OnClick"/>
              <MenuItem Header="{loc:Tr Key='Dodaj DLC'}" Click="AddNewDlc_OnClick"/>
              <MenuItem Header="{loc:Tr Key='Dodaj program'}" Click="AddApp_OnClick"/>
              <MenuItem Header="{loc:Tr Key='Dodaj grafikę'}" Click="AddArt_OnClick"/>
              <MenuItem Header="{loc:Tr Key='Dodaj muzykę'}" Click="AddMusic_OnClick"/>
              <MenuItem Header="{loc:Tr Key='Dodaj opowiadanie'}" Click="AddStory_OnClick"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Content="{loc:Tr Key='Odśwież'}" Click="Refresh_OnClick" Padding="12,6"/>
      </StackPanel>
    </Grid>

    <Panel Grid.Row="1" Margin="28,0,28,0" IsVisible="{Binding IsWorksSection}">
      <views:CreativeWorksEditor DataContext="{Binding CurrentWorks}"/>
    </Panel>

    <Grid Grid.Row="1" Margin="28,0,28,0" ColumnDefinitions="360,*" ColumnSpacing="16" IsVisible="{Binding IsGamesSection}">
      <Border Classes="card" Padding="0" Margin="0,0,0,16">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBox Margin="12,12,12,8" PlaceholderText="{loc:Tr Key='Szukaj po tytule lub symbolu'}"
                   Text="{Binding SearchText, Mode=TwoWay}"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding FilteredGames}"
                   SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StudioContentItem">
                <Grid ColumnDefinitions="48,*" ColumnSpacing="10" Margin="4,6">
                  <Border Width="48" Height="48" CornerRadius="4" Background="#1FFFFFFF" ClipToBounds="True">
                    <Panel>
                      <TextBlock Text="{Binding TileLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0.5" FontWeight="SemiBold"
                                 IsVisible="{Binding !HasCover}"/>
                      <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"
                             IsVisible="{Binding HasCover}"/>
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MetaText}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Margin="12,8,12,12" Text="{Binding ListSummary}" Classes="caption"/>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" Margin="0,0,0,16" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <RadioButton Content="{loc:Tr Key='Przegląd'}" GroupName="StudioTab" IsChecked="{Binding IsOverviewTab, Mode=OneWay}"
                         Command="{Binding SelectTabCommand}" CommandParameter="overview"/>
            <RadioButton Content="{loc:Tr Key='Strona sklepu'}" GroupName="StudioTab" IsChecked="{Binding IsStoreTab, Mode=OneWay}"
                         Command="{Binding SelectTabCommand}" CommandParameter="store"/>
            <RadioButton Content="Multimedia" GroupName="StudioTab" IsChecked="{Binding IsMediaTab, Mode=OneWay}"
                         Command="{Binding SelectTabCommand}" CommandParameter="media"/>
            <RadioButton Content="{loc:Tr Key='Buildy'}" GroupName="StudioTab" IsChecked="{Binding IsBuildsTab, Mode=OneWay}"
                         Command="{Binding SelectTabCommand}" CommandParameter="builds"/>
            <RadioButton Content="DLC" GroupName="StudioTab" IsChecked="{Binding IsDlcTab, Mode=OneWay}"
                         Command="{Binding SelectTabCommand}" CommandParameter="dlc"/>
            <RadioButton Content="{loc:Tr Key='Osiągnięcia'}" GroupName="StudioTab" IsChecked="{Binding IsAchievementsTab, Mode=OneWay}"
                         Command="{Binding SelectTabCommand}" CommandParameter="achievements"/>
          </StackPanel>

          <StackPanel Spacing="16" IsVisible="{Binding IsOverviewTab}">
            <Border CornerRadius="8" ClipToBounds="True" Background="#1AFFFFFF" MaxWidth="920" HorizontalAlignment="Left">
              <Viewbox Stretch="Uniform">
                <Panel Width="920" Height="430">
                  <TextBlock Text="{Binding SelectedGame.TileLabel}" FontSize="42" FontWeight="Bold"
                             Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding !SelectedGame.HasHeaderArt}"/>
                  <Image Source="{Binding SelectedGame.HeaderImageUrl}" Stretch="UniformToFill"
                         IsVisible="{Binding SelectedGame.HasHeaderArt}"/>
                  <StackPanel VerticalAlignment="Bottom" Margin="16,12" Spacing="2">
                    <TextBlock Text="{Binding SelectedGame.Title}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedGame.MetaText}" Classes="caption"/>
                  </StackPanel>
                </Panel>
              </Viewbox>
            </Border>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
              <Border Classes="card">
                <StackPanel Spacing="2">
                  <TextBlock Text="{loc:Tr Key='Pobrania'}" Classes="caption"/>
                  <TextBlock Text="{Binding TotalDownloadsText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="2">
                  <TextBlock Text="{loc:Tr Key='30 dni'}" Classes="caption"/>
                  <TextBlock Text="{Binding Last30Text}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="2">
                  <TextBlock Text="{loc:Tr Key='7 dni'}" Classes="caption"/>
                  <TextBlock Text="{Binding Last7Text}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="card">
                <StackPanel Spacing="2">
                  <TextBlock Text="{loc:Tr Key='Wersja'}" Classes="caption"/>
                  <TextBlock Text="{Binding SelectedGame.CurrentVersionText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{loc:Tr Key='Widoczność w sklepie'}" FontWeight="SemiBold"/>
                  <TextBlock Text="{loc:Tr Key='Szkic jest ukryty dla graczy.'}" Classes="caption" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch x:Name="PublishedSwitch" Grid.Column="1" OnContent="{loc:Tr Key='W sklepie'}" OffContent="{loc:Tr Key='Szkic'}"
                              IsChecked="{Binding SelectedGame.IsPublished, Mode=OneWay}"
                              IsCheckedChanged="Published_OnChanged"/>
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Tr Key='Opublikuj nową wersję'}" Click="AddVersion_OnClick" Padding="14,8"/>
              <Button Content="{loc:Tr Key='Dodaj DLC'}" Click="AddDlc_OnClick" Padding="14,8"/>
              <Button Content="{loc:Tr Key='Usuń grę'}" Click="Delete_OnClick" Padding="14,8"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding IsStoreTab}">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{loc:Tr Key='Podstawowe'}" FontWeight="SemiBold"/>
                <TextBox PlaceholderText="{loc:Tr Key='Tytuł'}" Text="{Binding SelectedGame.EditTitle, Mode=TwoWay}"/>
                <TextBox PlaceholderText="{loc:Tr Key='Opis'}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88"
                         Text="{Binding SelectedGame.EditDescription, Mode=TwoWay}"/>
                <TextBox PlaceholderText="{loc:Tr Key='Wymagania sprzętowe'}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                         Text="{Binding SelectedGame.EditHardwareRequirements, Mode=TwoWay}"/>
                <TextBlock Text="{loc:Tr Key='Gatunki'}" Classes="caption"/>
                <Expander Header="{Binding SelectedGame.EditGenres.Summary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <ScrollViewer MaxHeight="220">
                    <ItemsControl ItemsSource="{Binding SelectedGame.EditGenres.Options}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaxonomyOption">
                          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Expander>
                <TextBlock Text="{loc:Tr Key='Silniki'}" Classes="caption"/>
                <Expander Header="{Binding SelectedGame.EditEngines.Summary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <ScrollViewer MaxHeight="220">
                    <ItemsControl ItemsSource="{Binding SelectedGame.EditEngines.Options}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaxonomyOption">
                          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Expander>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{loc:Tr Key='Wydanie, studio i funkcje'}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding ReleaseStatusOptions}"
                          SelectedIndex="{Binding SelectedGame.EditReleaseStatusIndex, Mode=TwoWay}"/>
                <ComboBox ItemsSource="{Binding AgeRatingOptions}"
                          SelectedIndex="{Binding SelectedGame.EditAgeRatingIndex, Mode=TwoWay}"/>
                <TextBox PlaceholderText="{loc:Tr Key='Nazwa studia'}" Text="{Binding SelectedGame.EditStudioName, Mode=TwoWay}"/>
                <TextBox PlaceholderText="{loc:Tr Key='Strona www'}" Text="{Binding SelectedGame.EditWebsiteUrl, Mode=TwoWay}"/>
                <TextBox PlaceholderText="Discord" Text="{Binding SelectedGame.EditDiscordUrl, Mode=TwoWay}"/>
                <TextBox PlaceholderText="{loc:Tr Key='Wsparcie'}" Text="{Binding SelectedGame.EditSupportUrl, Mode=TwoWay}"/>
                <WrapPanel>
                  <CheckBox Content="Singleplayer" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasSinglePlayer, Mode=TwoWay}"/>
                  <CheckBox Content="Multiplayer" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasMultiPlayer, Mode=TwoWay}"/>
                  <CheckBox Content="{loc:Tr Key='Kooperacja'}" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasCoOp, Mode=TwoWay}"/>
                  <CheckBox Content="Pad" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasController, Mode=TwoWay}"/>
                  <CheckBox Content="{loc:Tr Key='Chmura'}" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasCloudSaves, Mode=TwoWay}"/>
                  <CheckBox Content="{loc:Tr Key='Osiągnięcia'}" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasAchievements, Mode=TwoWay}"/>
                  <CheckBox Content="{loc:Tr Key='Mody'}" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasModding, Mode=TwoWay}"/>
                  <CheckBox Content="VR" Margin="0,0,12,6" IsChecked="{Binding SelectedGame.HasVr, Mode=TwoWay}"/>
                </WrapPanel>
                <TextBox PlaceholderText="{loc:Tr Key='Języki, np. Polski, English'}" Text="{Binding SelectedGame.EditLanguages, Mode=TwoWay}"/>
                <TextBox PlaceholderText="{loc:Tr Key='Tagi, np. roguelike, pixel art'}" Text="{Binding SelectedGame.EditTags, Mode=TwoWay}"/>
              </StackPanel>
            </Border>
            <Button Content="{loc:Tr Key='Zapisz stronę sklepu'}" Classes="accent" Click="SaveStore_OnClick"
                    HorizontalAlignment="Left" Padding="16,8"/>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding IsMediaTab}">
            <Border Classes="card">
              <Grid ColumnDefinitions="120,*" ColumnSpacing="16">
                <Border Height="160" Width="120" CornerRadius="6" Background="#1AFFFFFF">
                  <Image Source="{Binding SelectedGame.OwnCoverImageUrl}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Tr Key='Miniaturka'}" FontWeight="SemiBold"/>
                  <TextBlock Text="{loc:Tr Key='Pionowa, używana na listach i w bibliotece. Zalecane 600 × 900.'}"
                             Classes="caption" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Tr Key='Wybierz plik'}" Click="PickCover_OnClick"/>
                    <Button Content="{loc:Tr Key='Usuń'}" Click="ClearCover_OnClick"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="card">
              <Grid ColumnDefinitions="280,*" ColumnSpacing="16">
                <Border Width="240" Height="112" CornerRadius="6" Background="#1AFFFFFF" ClipToBounds="True">
                  <Image Source="{Binding SelectedGame.OwnHeaderImageUrl}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Tr Key='Okładka pozioma'}" FontWeight="SemiBold"/>
                  <TextBlock Text="{loc:Tr Key='920 × 430 — wypełnia nagłówek strony gry w całości.'}"
                             Classes="caption" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Tr Key='Wybierz plik'}" Click="PickHeader_OnClick"/>
                    <Button Content="{loc:Tr Key='Usuń'}" Click="ClearHeader_OnClick"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="card">
              <Grid ColumnDefinitions="140,*" ColumnSpacing="16">
                <Border Height="140" Width="140" CornerRadius="6" Background="#1AFFFFFF">
                  <Image Source="{Binding SelectedGame.OwnLogoImageUrl}" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Tr Key='Logo (kwadratowe)'}" FontWeight="SemiBold"/>
                  <TextBlock Text="{loc:Tr Key='Kwadratowe logo na małe kafelki (np. lista zainstalowanych w sidebarze). Zalecane 512×512.'}"
                             Classes="caption" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Tr Key='Wybierz plik'}" Click="PickLogo_OnClick"/>
                    <Button Content="{loc:Tr Key='Usuń'}" Click="ClearLogo_OnClick"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Intro" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{loc:Tr Key='Wybierz wideo'}" Click="PickIntro_OnClick"/>
                  <Button Content="{loc:Tr Key='Usuń'}" Click="ClearIntro_OnClick"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Tr Key='Zrzuty ekranu'}" FontWeight="SemiBold"/>
                  <Button Grid.Column="1" Content="{loc:Tr Key='Dodaj'}" Click="AddScreenshot_OnClick"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding SelectedGame.ScreenshotItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{loc:Tr Key='Usuń zrzut'}" Tag="{Binding}" Click="RemoveScreenshot_OnClick"
                              Margin="0,0,8,8" Padding="10,6"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding IsBuildsTab}">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Tr Key='Aktualne buildy'}" FontWeight="SemiBold"/>
                  <Button Grid.Column="1" Content="{loc:Tr Key='Nowa wersja'}" Click="AddVersion_OnClick"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding SelectedGame.Builds}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card" Margin="0,0,0,8" Padding="12">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="{Binding PlatformText}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MetaText}" Classes="caption"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Version}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr Key='Historia i opis zmian'}" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Versions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StudioVersionItem">
                      <Border Classes="card" Margin="0,0,0,10" Padding="12">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Version}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding MetaText}" Classes="caption"/>
                          </Grid>
                          <TextBox PlaceholderText="{loc:Tr Key='Notatki do tej wersji'}" AcceptsReturn="True" TextWrapping="Wrap"
                                   MinHeight="64" Text="{Binding EditNotes, Mode=TwoWay}"/>
                          <Button Content="{loc:Tr Key='Zapisz opis zmian'}" Tag="{Binding}" Click="SaveNotes_OnClick"
                                  HorizontalAlignment="Left" Padding="12,6"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding IsDlcTab}">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{loc:Tr Key='Dodatki'}" FontWeight="SemiBold"/>
                  <Button Grid.Column="1" Content="{loc:Tr Key='Dodaj DLC'}" Click="AddDlc_OnClick"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding SelectedGame.Dlcs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card" Margin="0,0,0,8" Padding="12">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MetaText}" Classes="caption"/>
                          </StackPanel>
                          <Button Grid.Column="1" Content="{loc:Tr Key='Usuń'}" Tag="{Binding}" Click="DeleteDlc_OnClick"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsAchievementsTab}">
            <views:AchievementsEditor DataContext="{Binding AchievementsEditor}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="2" Margin="28,8,28,16" ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap"/>
      <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" Height="4"
                   IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</UserControl>
