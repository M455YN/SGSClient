<Window xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SGSClient.UI.ViewModels"
        xmlns:conv="using:SGSClient.UI.Converters"
        x:Class="SGSClient.UI.Views.GamePropertiesWindow"
        x:DataType="vm:GamePropertiesViewModel"
        Title="{loc:Tr Key='Właściwości gry'}"
        Width="1100" Height="720"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterOwner">

  <Grid ColumnDefinitions="240,*">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding GameTitle}" FontWeight="SemiBold"
                   FontSize="13" TextWrapping="Wrap" Margin="8,0,8,12"
                   Foreground="{DynamicResource SystemAccentColor}"/>
        <ListBox ItemsSource="{Binding NavItems}"
                 Background="Transparent"
                 SelectionChanged="NavList_OnSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PropertiesNavItem">
              <TextBlock Text="{Binding Label}" Margin="4,2"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Padding="24,20" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">
        <StackPanel Spacing="12" IsVisible="{Binding ShowBetas}">
          <TextBlock Text="{loc:Tr Key='Wersje i bety gry'}" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Tr Key='Wybrana wersja gry'}" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Tr Key='Wersje są udostępniane przez twórców. Starsze buildy mogą być niestabilne.'}"
                     Opacity="0.65" TextWrapping="Wrap" FontSize="12"/>

          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <TextBlock Text="{loc:Tr Key='Tytuł i opis'}" Opacity="0.55" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="{loc:Tr Key='Ostatnia aktualizacja'}" Opacity="0.55" FontSize="11"/>
          </Grid>

          <ListBox ItemsSource="{Binding Versions}"
                   SelectedItem="{Binding SelectedVersion}"
                   Background="Transparent"
                   MaxHeight="280">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BetaVersionItem">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Description}" Opacity="0.65" FontSize="12"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding UpdatedText}" Opacity="0.65"
                             VerticalAlignment="Center" FontSize="12"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Padding="12" CornerRadius="6" Margin="0,8,0,0"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="6" Opacity="0.75">
              <TextBlock Text="{loc:Tr Key='Wersje prywatne'}" FontWeight="SemiBold"/>
              <TextBlock Text="{loc:Tr Key='Prywatne wersje beta — wkrótce.'}"
                         FontSize="12" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox IsEnabled="False" PlaceholderText="{loc:Tr Key='Kod dostępu'}"/>
                <Button Grid.Column="1" Content="{loc:Tr Key='Sprawdź kod'}" IsEnabled="False" Padding="12,8"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="14" IsVisible="{Binding ShowFiles}">
          <TextBlock Text="{loc:Tr Key='Zainstalowane pliki'}" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Tr Key='Lokalne pliki gry na tym komputerze. Odinstalowanie usuwa pliki, ale gra zostaje w bibliotece.'}"
                     Opacity="0.65" TextWrapping="Wrap" FontSize="12"/>

          <Border Padding="16" CornerRadius="8"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="Status" Opacity="0.6"/>
                <TextBlock Grid.Column="1" Text="{Binding InstallStateText}" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="{loc:Tr Key='Wersja'}" Opacity="0.6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstalledVersionText}"/>
                <TextBlock Grid.Row="2" Text="{loc:Tr Key='Rozmiar'}" Opacity="0.6"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstallSizeText}"/>
                <TextBlock Grid.Row="3" Text="{loc:Tr Key='Pliki'}" Opacity="0.6"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InstallFilesText}"/>
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Key='Folder instalacji'}" Opacity="0.6" FontSize="12"/>
                <TextBlock Text="{Binding InstallPathText}" TextWrapping="Wrap" FontSize="12"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{loc:Tr Key='Przeglądaj pliki lokalne…'}"
                    Click="BrowseLocalFiles_OnClick"
                    IsEnabled="{Binding CanBrowseFiles}"
                    Classes="accent"
                    Padding="14,10"/>
            <Button Content="{loc:Tr Key='Odśwież'}"
                    Click="RefreshInstallInfo_OnClick"
                    Classes="subtle"
                    Padding="14,10"/>
            <Button Content="{loc:Tr Key='Odinstaluj…'}"
                    Click="UninstallFiles_OnClick"
                    IsEnabled="{Binding CanUninstallFiles}"
                    Padding="14,10"/>
          </StackPanel>

          <Border Padding="14" CornerRadius="8" Margin="0,4,0,0"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  IsVisible="{Binding IsInstalled}">
            <StackPanel Spacing="10">
              <TextBlock Text="{loc:Tr Key='Przenieś pliki'}" FontWeight="SemiBold"/>
              <TextBlock Text="{loc:Tr Key='Wybierz inny folder biblioteki (dodajesz je w Ustawieniach).'}"
                         Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
              <ComboBox ItemsSource="{Binding MoveTargets}"
                        SelectedItem="{Binding SelectedMoveTarget}"
                        PlaceholderText="{loc:Tr Key='Brak innych folderów biblioteki'}"
                        HorizontalAlignment="Stretch"
                        MinHeight="36"/>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="{loc:Tr Key='Przenieś pliki…'}"
                        Click="MoveFiles_OnClick"
                        IsEnabled="{Binding CanMoveFiles}"
                        Classes="accent"
                        Padding="14,10"/>
                <TextBlock Text="{Binding MoveProgressText}"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           FontSize="12"
                           IsVisible="{Binding IsMoving}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{loc:Tr Key='Weryfikacja plików — wkrótce.'}"
                     Opacity="0.5" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Spacing="14" IsVisible="{Binding ShowPersonalization}">
          <TextBlock Text="{loc:Tr Key='Personalizacja'}" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Tr Key='Własny obrazek kafla w bibliotece (nadpisuje okładkę ze sklepu).'}"
                     Opacity="0.65" TextWrapping="Wrap" FontSize="12"/>

          <Border Width="168" Height="248" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1">
            <Panel>
              <TextBlock Text="{loc:Tr Key='Podgląd'}" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding !HasCustomCover}"/>
              <Image Source="{Binding CustomCoverPreviewUri, Converter={x:Static conv:FileUriToBitmapConverter.Instance}}" Stretch="UniformToFill"
                     IsVisible="{Binding HasCustomCover}"/>
            </Panel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{loc:Tr Key='Wybierz obrazek…'}" Click="PickCustomCover_OnClick" Classes="accent" Padding="14,10"/>
            <Button Content="{loc:Tr Key='Przywróć domyślny'}"
                    Click="ClearCustomCover_OnClick"
                    IsEnabled="{Binding HasCustomCover}"
                    Classes="subtle"
                    Padding="14,10"/>
          </StackPanel>
          <TextBlock Text="{loc:Tr Key='Obsługiwane: PNG, JPG, WEBP. Plik trafia do lokalnej pamięci klienta.'}"
                     Opacity="0.55" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Spacing="14" IsVisible="{Binding ShowDlc}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="DLC" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{loc:Tr Key='Zobacz więcej w sklepie'}"
                    Command="{Binding ViewMoreInStoreCommand}"
                    Classes="subtle" Padding="12,8"/>
          </Grid>

          <TextBox Text="{Binding DlcSearchText}" PlaceholderText="{loc:Tr Key='Szukaj DLC…'}"/>

          <Grid ColumnDefinitions="56,*,120,100" ColumnSpacing="12" Margin="0,4,0,0">
            <TextBlock Text="{loc:Tr Key='Instaluj'}" Opacity="0.55" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="{loc:Tr Key='Nazwa'}" Opacity="0.55" FontSize="11"/>
            <TextBlock Grid.Column="2" Text="{loc:Tr Key='Dodano'}" Opacity="0.55" FontSize="11"/>
            <TextBlock Grid.Column="3" Text="{loc:Tr Key='Rozmiar'}" Opacity="0.55" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>

          <ItemsControl ItemsSource="{Binding FilteredDlcRows}" MaxHeight="360">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DlcRowItem">
                <Grid ColumnDefinitions="56,*,120,100" ColumnSpacing="12" Margin="0,6">
                  <CheckBox IsChecked="{Binding IsInstalled}"
                            IsEnabled="{Binding !IsBusy}"
                            Click="DlcInstallCheck_OnClick"
                            Tag="{Binding}"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Border Width="40" Height="40" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                      <Image Source="{Binding CoverPreviewUri}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding AddedText}" Opacity="0.65"
                             VerticalAlignment="Center" FontSize="12"/>
                  <TextBlock Grid.Column="3" Text="{Binding SizeText}" Opacity="0.65"
                             VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding DlcStatusText}" Opacity="0.65" FontSize="12"/>
        </StackPanel>

        <StackPanel Spacing="14" IsVisible="{Binding ShowGeneral}">
          <TextBlock Text="{loc:Tr Key='Ogólne'}" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding GeneralSummaryText}" Opacity="0.7" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="16">
            <TextBlock Text="Status" Opacity="0.65"/>
            <TextBlock Grid.Column="1" Text="{Binding InstallStateText}" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="{loc:Tr Key='Wersja'}" Opacity="0.65"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstalledVersionText}"/>
            <TextBlock Grid.Row="2" Text="{loc:Tr Key='Lokalizacja'}" Opacity="0.65"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstallPathText}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Tr Key='Otwórz folder'}" Command="{Binding BrowseLocalFilesCommand}"
                    IsEnabled="{Binding CanBrowseFiles}"/>
            <Button Content="{loc:Tr Key='Zobacz w sklepie'}" Command="{Binding ViewMoreInStoreCommand}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="14" IsVisible="{Binding ShowUpdates}">
          <TextBlock Text="{loc:Tr Key='Aktualizacje'}" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding UpdatesStatusText}" Opacity="0.7" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="16">
            <TextBlock Text="{loc:Tr Key='Zainstalowana'}" Opacity="0.65"/>
            <TextBlock Grid.Column="1" Text="{Binding InstalledVersionText}"/>
            <TextBlock Grid.Row="1" Text="{loc:Tr Key='Dostępna w sklepie'}" Opacity="0.65"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersionText}"/>
          </Grid>
          <CheckBox Content="{loc:Tr Key='Aktualizuj automatycznie'}" IsChecked="{Binding AutoUpdateEnabled}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Tr Key='Sprawdź aktualizacje'}" Command="{Binding CheckForUpdatesCommand}"/>
            <Button Content="{loc:Tr Key='Aktualizuj teraz'}" Classes="accent"
                    Command="{Binding UpdateNowCommand}"
                    IsEnabled="{Binding CanUpdateNow}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowPlaceholder}">
          <TextBlock Text="{Binding PlaceholderText}" Opacity="0.65" FontSize="14"/>
        </StackPanel>

        <TextBlock Text="{Binding StatusText}" Opacity="0.65" FontSize="12"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
