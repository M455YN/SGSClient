<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <DockPanel Margin="28,24">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,18">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/>
        <Button Grid.Column="1" Content="Odśwież" Click="Refresh_OnClick" Padding="12,6"/>
      </Grid>
      <TextBlock Text="{Binding StatusText}" Opacity="0.65" FontSize="13"/>
    </StackPanel>

    <TextBlock Text="{Binding StatusText}"
               IsVisible="{Binding ShowEmpty}"
               Opacity="0.6"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasGames}">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LibraryGameItem">
            <Border Margin="0,0,0,12" Padding="14" CornerRadius="8"
                    Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
              <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14">
                <Border Width="56" Height="56" CornerRadius="8" Background="#333">
                  <TextBlock Text="{Binding TileLabel}" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/>
                  <TextBlock Opacity="0.65" FontSize="12">
                    <Run Text="{Binding PlatformText}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding VersionText}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding StateText}" Opacity="0.7" FontSize="12"/>
                  <TextBlock Text="{Binding LastPlayedText}" Opacity="0.5" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="Graj" Tag="{Binding}" Click="Launch_OnClick"
                          IsEnabled="{Binding CanLaunch}" Padding="12,8"/>
                  <Button Content="Usuń" Tag="{Binding}" Click="Remove_OnClick" Padding="12,8"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
