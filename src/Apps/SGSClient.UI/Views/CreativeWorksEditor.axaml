<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.CreativeWorksEditor"
             x:DataType="vm:CreativeWorksViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="BorderBrush" Value="#22FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="360,*" ColumnSpacing="16">
    <Border Classes="card" Padding="0" Margin="0,0,0,16">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBox Margin="12,12,12,8" PlaceholderText="{loc:Tr Key='Szukaj po tytule lub autorze'}"
                 Text="{Binding SearchText, Mode=TwoWay}" IsVisible="{Binding IsAdmin}"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CreativeWorkRow">
              <Grid ColumnDefinitions="48,*" ColumnSpacing="10" Margin="4,6">
                <Border Width="48" Height="48" CornerRadius="4" Background="#1FFFFFFF" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="{Binding TileLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Opacity="0.5" FontWeight="SemiBold" IsVisible="{Binding !HasThumb}"/>
                    <Image Source="{Binding ThumbUrl}" Stretch="UniformToFill" IsVisible="{Binding HasThumb}"/>
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding MetaText}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Margin="12,8,12,12" Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" Margin="0,0,0,16" IsVisible="{Binding HasSelection}">
      <Border Classes="card" MaxWidth="820" HorizontalAlignment="Left">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Tytuł'}" Classes="caption"/>
            <TextBox Text="{Binding EditTitle, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Opis'}" Classes="caption"/>
            <TextBox Text="{Binding EditDescription, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88"/>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Tagi (oddzielone przecinkami)'}" Classes="caption"/>
            <TextBox Text="{Binding EditTags, Mode=TwoWay}"/>
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding HasCoverEditor}">
            <TextBlock Text="{loc:Tr Key='Okładka'}" Classes="caption"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding CoverPath, Mode=OneWay}" IsReadOnly="True" Watermark="{loc:Tr Key='Bez zmiany okładki'}"/>
              <Button Grid.Column="1" Content="{loc:Tr Key='Zmień okładkę…'}" Command="{Binding PickCoverCommand}" Padding="12,8"/>
            </Grid>
          </StackPanel>

          <Grid ColumnDefinitions="220,*" ColumnSpacing="12" IsVisible="{Binding IsStories}">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Tr Key='Rozdziały'}" FontWeight="SemiBold"/>
              <ListBox ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter, Mode=TwoWay}" MaxHeight="320">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChapterDraft">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="4,6"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="{loc:Tr Key='+ Dodaj rozdział'}" Command="{Binding AddChapterCommand}" HorizontalAlignment="Stretch"/>
              <Button Content="{loc:Tr Key='Usuń rozdział'}" Command="{Binding RemoveChapterCommand}"
                      CommandParameter="{Binding SelectedChapter}" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="{loc:Tr Key='Tytuł rozdziału'}" Classes="caption"/>
              <TextBox Text="{Binding SelectedChapter.Title, Mode=TwoWay}"/>
              <TextBlock Text="{loc:Tr Key='Treść rozdziału'}" Classes="caption"/>
              <TextBox Text="{Binding SelectedChapter.Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260"/>
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Tr Key='Zapisz zmiany'}" Command="{Binding SaveCommand}" Classes="accent" Padding="18,8"/>
            <Button Content="{loc:Tr Key='Usuń'}" Command="{Binding DeleteCommand}" Padding="18,8"/>
            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Foreground="#EF9A9A" TextWrapping="Wrap" Margin="0,0,0,4"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <TextBlock Grid.Column="1" Text="{loc:Tr Key='Wybierz pozycję z listy'}" Opacity="0.6"
               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSelection}"/>
  </Grid>
</UserControl>
