<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.ContentPublishView"
             x:DataType="vm:ContentPublishViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,24,28,32" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="{loc:Tr Key='Wybierz pliki i uzupełnij dane. Paczka i manifest powstaną automatycznie.'}"
                   Opacity="0.65" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding AuthHint}" Opacity="0.55" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Typ treści'}" Opacity="0.55" FontSize="12"/>
            <StackPanel x:Name="KindPanel" Orientation="Horizontal" Spacing="16">
              <RadioButton Tag="book" Content="{loc:Tr Key='Książka'}" GroupName="ContentKind" Click="Kind_OnClick"/>
              <RadioButton Tag="music" Content="{loc:Tr Key='Muzyka'}" GroupName="ContentKind" Click="Kind_OnClick"/>
              <RadioButton Tag="art" Content="{loc:Tr Key='Grafika'}" GroupName="ContentKind" Click="Kind_OnClick"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Nazwa'}" Opacity="0.55" FontSize="12"/>
            <TextBox Text="{Binding ContentTitle}"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Symbol (małe litery i myślniki)'}" Opacity="0.55" FontSize="12"/>
            <TextBox Text="{Binding ContentSymbol}"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Opis'}" Opacity="0.55" FontSize="12"/>
            <TextBox Text="{Binding ContentDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Wersja'}" Opacity="0.55" FontSize="12"/>
            <TextBox Text="{Binding Version}"/>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Key='Pliki'}" Opacity="0.55" FontSize="12"/>
            <TextBlock Text="{Binding FilesSummary}" Opacity="0.8" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Tr Key='Wybierz pliki…'}" Click="PickFiles_OnClick" Padding="14,8"/>
              <Button Content="{loc:Tr Key='Wyczyść'}" Click="ClearFiles_OnClick" Padding="14,8"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Key='Okładka (opcjonalnie)'}" Opacity="0.55" FontSize="12"/>
            <TextBlock Text="{Binding CoverPath}" Opacity="0.8" TextWrapping="Wrap"/>
            <Button Content="{loc:Tr Key='Wybierz okładkę…'}" Click="PickCover_OnClick" Padding="14,8"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Button Content="{loc:Tr Key='Opublikuj w sklepie'}" Command="{Binding PublishCommand}"
              IsEnabled="{Binding !IsBusy}" Padding="18,12" Background="#2E7D32" Foreground="White"/>

      <StackPanel Spacing="8" IsVisible="{Binding ShowProgress}">
        <TextBlock Text="{loc:Tr Key='Wysyłanie…'}" Opacity="0.7"/>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="8"/>
      </StackPanel>

      <TextBlock Text="{Binding StatusText}" Opacity="0.75" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Issues}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
