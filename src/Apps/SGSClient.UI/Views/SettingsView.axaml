<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Margin="24" Spacing="8">
    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding Subtitle}" Opacity="0.7"/>
  </StackPanel>
</UserControl>
