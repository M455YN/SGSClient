<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,24,28,32" Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Dostosuj klienta do siebie." Opacity="0.65" FontSize="13"/>
      </StackPanel>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="Wygląd i język" FontSize="18" FontWeight="SemiBold"/>
          <StackPanel Spacing="4">
            <TextBlock Text="Motyw" Opacity="0.55" FontSize="12"/>
            <TextBlock Text="{Binding AppearanceText}"/>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Język" Opacity="0.55" FontSize="12"/>
            <TextBlock Text="{Binding LanguageText}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="Konto i sklep" FontSize="18" FontWeight="SemiBold"/>
          <StackPanel Spacing="4">
            <TextBlock Text="Konto" Opacity="0.55" FontSize="12"/>
            <TextBlock Text="{Binding AccountStatus}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Sklep" Opacity="0.55" FontSize="12"/>
            <TextBlock Text="{Binding StoreStatus}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="Twoja biblioteka" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding LibrarySummary}" Opacity="0.8" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Otwórz folder z danymi" Click="OpenFolder_OnClick" Padding="14,8"/>
            <Button Content="Wyczyść bibliotekę" Click="ClearLibrary_OnClick"
                    IsEnabled="{Binding !IsBusy}" Padding="14,8"/>
          </StackPanel>
          <TextBlock Text="Wyczyszczenie usuwa listę gier z tego komputera. Nie usuwa konta."
                     Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Padding="18" CornerRadius="10" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="O SGSClient" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding AboutText}" Opacity="0.85"/>
          <TextBlock Text="Klient gier Szyr Game Studio." Opacity="0.55" FontSize="12"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusText}" Opacity="0.7" FontSize="13" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
