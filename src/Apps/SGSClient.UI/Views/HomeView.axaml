<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             x:Class="SGSClient.UI.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Panel>
      <Border Height="520" VerticalAlignment="Top" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#44305A48" Offset="0"/>
            <GradientStop Color="#221E3840" Offset="0.4"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Border Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,-40,-80,0" Opacity="0.35" IsHitTestVisible="False">
        <Border.Background>
          <RadialGradientBrush>
            <GradientStop Color="#662E7D32" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Border.Background>
      </Border>

      <StackPanel Margin="36,40,36,40" Spacing="36" MaxWidth="980" HorizontalAlignment="Left">
        <!-- Hero -->
        <StackPanel Spacing="16" MaxWidth="640">
          <TextBlock Text="{Binding Brand}"
                     FontSize="48" FontWeight="Bold"
                     LetterSpacing="0.5"/>
          <TextBlock Text="{Binding Headline}"
                     FontSize="26" FontWeight="SemiBold"
                     Opacity="0.95" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Tagline}"
                     FontSize="15" Opacity="0.7" TextWrapping="Wrap"
                     MaxWidth="520" LineHeight="22"/>

          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
            <Button Content="Przeglądaj sklep"
                    Click="OpenStore_OnClick"
                    Padding="20,12"
                    MinWidth="180"
                    Background="#2E7D32"
                    Foreground="White"/>
            <Button Content="Biblioteka"
                    Click="OpenLibrary_OnClick"
                    Padding="20,12"
                    MinWidth="140"/>
          </StackPanel>
        </StackPanel>

        <!-- Featured strip -->
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding FeaturedStatus}" FontSize="18" FontWeight="SemiBold" Opacity="0.9"/>
          <ItemsControl ItemsSource="{Binding Featured}" IsVisible="{Binding HasFeatured}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
              <Style Selector="Border.home-tile:pointerover">
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HomeFeaturedItem">
                <Border Classes="home-tile" Width="280" Margin="0,0,16,16" Padding="16" CornerRadius="10"
                        Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                        Cursor="Hand" Tag="{Binding}" PointerPressed="Featured_OnPointerPressed">
                  <StackPanel Spacing="12">
                    <Border Width="64" Height="64" CornerRadius="10" Background="#2A3A32">
                      <TextBlock Text="{Binding TileLabel}" FontWeight="Bold" FontSize="16"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Blurb}" Opacity="0.65" FontSize="12"
                               TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Panel>
  </ScrollViewer>
</UserControl>
