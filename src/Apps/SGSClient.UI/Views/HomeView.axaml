<UserControl xmlns:loc="using:SGSClient.UI.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGSClient.UI.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="SGSClient.UI.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <UserControl.Styles>
    <Style Selector="Border.home-card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    </Style>
    <Style Selector="Border.stat">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="MinWidth" Value="104"/>
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.quick">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.slide">
      <Setter Property="Width" Value="28"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="Button.dot">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="5"/>
      <Setter Property="MinWidth" Value="22"/>
      <Setter Property="MinHeight" Value="5"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="CornerRadius" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
    </Style>
    <Style Selector="Button.dot.active">
      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="PosterTemplate" x:DataType="vm:HomeGameCard">
      <Border Classes="home-card" Width="168" Height="248" CornerRadius="8" ClipToBounds="True"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1" Cursor="Hand" Tag="{Binding}"
              PointerPressed="Card_OnPointerPressed">
        <Panel>
          <TextBlock Text="{Binding TileLabel}" FontSize="28" FontWeight="SemiBold" Opacity="0.28"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !HasCover}"/>
          <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"
                 IsVisible="{Binding HasCover}"/>
          <Border VerticalAlignment="Bottom" Padding="12,10"
                  Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Caption}" Opacity="0.65" FontSize="12"/>
            </StackPanel>
          </Border>
        </Panel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="WideCardTemplate" x:DataType="vm:HomeGameCard">
      <!-- Image slot 240×112 ≈ 920∶430 landscape -->
      <Border Classes="home-card" Width="240" CornerRadius="8" ClipToBounds="True"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1" Cursor="Hand" Tag="{Binding}"
              PointerPressed="Card_OnPointerPressed">
        <Grid RowDefinitions="112,Auto">
          <Panel>
            <TextBlock Text="{Binding TileLabel}" FontSize="28" FontWeight="SemiBold" Opacity="0.28"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !HasCover}"/>
            <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"
                   IsVisible="{Binding HasCover}"/>
          </Panel>
          <Border Grid.Row="1" Padding="12,10"
                  Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Blurb}" Opacity="0.65" FontSize="12"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Panel>
    <Image Source="{Binding Hero.CoverImageUrl}" Stretch="UniformToFill"
           IsVisible="{Binding HasHero}" Opacity="0.55" IsHitTestVisible="False">
      <Image.Effect>
        <BlurEffect Radius="48"/>
      </Image.Effect>
    </Image>
    <Border Background="#C0101014" IsHitTestVisible="False"/>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Background="Transparent">
      <StackPanel Margin="32,24,32,40" Spacing="28">

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding DateText}" FontSize="12" Opacity="0.65"/>
            <TextBlock Text="{Binding Greeting}" FontSize="28" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="stat">
              <StackPanel>
                <TextBlock Text="{Binding LibraryCountText}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr Key='W bibliotece'}" FontSize="12" Opacity="0.65"/>
              </StackPanel>
            </Border>
            <Border Classes="stat">
              <StackPanel>
                <TextBlock Text="{Binding InstalledCountText}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr Key='Zainstalowane'}" FontSize="12" Opacity="0.65"/>
              </StackPanel>
            </Border>
            <Border Classes="stat">
              <StackPanel>
                <TextBlock Text="{Binding CatalogCountText}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr Key='W sklepie'}" FontSize="12" Opacity="0.65"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Border IsVisible="{Binding HasError}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Key='Katalog'}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.75" FontSize="13"/>
          </StackPanel>
        </Border>

        <StackPanel Spacing="10" IsVisible="{Binding HasHero}">
          <TextBlock Text="{loc:Tr Key='WYRÓŻNIONE I POLECANE'}" FontSize="11" FontWeight="SemiBold" Opacity="0.7"
                     LetterSpacing="1"/>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Height="340">
            <Button Classes="slide" Content="‹"
                    Click="PreviousSlide_OnClick"
                    IsVisible="{Binding HasMultipleSlides}"/>
            <Border x:Name="HeroClip" Grid.Column="1" CornerRadius="4" ClipToBounds="True">
            <Border x:Name="HeroCapsule" CornerRadius="4" Cursor="Hand"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    PointerPressed="OpenHero_OnPointerPressed">
              <Border.RenderTransform>
                <TranslateTransform/>
              </Border.RenderTransform>
              <Grid ColumnDefinitions="*,320">
                <Panel>
                  <TextBlock Text="{Binding Hero.TileLabel}" FontSize="72" FontWeight="SemiBold" Opacity="0.16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding !Hero.HasCover}"/>
                  <Image Source="{Binding Hero.CoverImageUrl}" Stretch="UniformToFill"
                         IsVisible="{Binding Hero.HasCover}"/>
                  <Border VerticalAlignment="Bottom" Height="120">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#CC000000" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding Hero.Title}" Margin="24,0,16,18"
                               VerticalAlignment="Bottom" FontSize="28" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                  </Border>
                </Panel>
                <Border Grid.Column="1" Padding="16,14"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <TextBlock Text="{Binding Hero.Title}" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                    <Panel Grid.Row="1" IsVisible="{Binding Hero.HasShots}">
                      <Border CornerRadius="2" ClipToBounds="True"
                              Background="{DynamicResource ControlFillColorDefaultBrush}"
                              IsVisible="{Binding Hero.ShotLayout1}">
                        <Image Source="{Binding Hero.Shot1}" Stretch="UniformToFill"/>
                      </Border>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="6"
                            IsVisible="{Binding Hero.ShotLayout2}">
                        <Border CornerRadius="2" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding Hero.Shot1}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="2" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding Hero.Shot2}" Stretch="UniformToFill"/>
                        </Border>
                      </Grid>
                      <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="6" RowSpacing="6"
                            IsVisible="{Binding Hero.ShotLayout3}">
                        <Border CornerRadius="2" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding Hero.Shot1}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="2" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding Hero.Shot2}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="2" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding Hero.Shot3}" Stretch="UniformToFill"/>
                        </Border>
                      </Grid>
                      <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="6" RowSpacing="6"
                            IsVisible="{Binding Hero.ShotLayout4}">
                        <Border CornerRadius="2" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding Hero.Shot1}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="2" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding Hero.Shot2}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Grid.Row="1" CornerRadius="2" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding Hero.Shot3}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="2" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding Hero.Shot4}" Stretch="UniformToFill"/>
                        </Border>
                      </Grid>
                    </Panel>
                    <StackPanel Grid.Row="2" Spacing="8">
                      <TextBlock Text="{Binding Hero.ReleaseLine}" FontSize="13" Opacity="0.85"
                                 TextTrimming="CharacterEllipsis"/>
                      <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                              BorderThickness="1" CornerRadius="2" Padding="8,3"
                              HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Hero.BadgeText}" FontSize="11" Opacity="0.8"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
            </Border>
            <Button Grid.Column="2" Classes="slide" Content="›"
                    Click="NextSlide_OnClick"
                    IsVisible="{Binding HasMultipleSlides}"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding FeaturedDots}" HorizontalAlignment="Center"
                        IsVisible="{Binding HasMultipleSlides}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FeaturedSlideDot">
                <Button Classes="dot" Classes.active="{Binding IsActive}"
                        Tag="{Binding Index}" Click="Dot_OnClick"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid x:Name="QuickActionsGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="12"
              IsVisible="{Binding !HasHero}">
          <Button Classes="quick" Click="OpenStore_OnClick">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <ui:FASymbolIcon Symbol="Shop" FontSize="20"/>
              <StackPanel>
                <TextBlock Text="{loc:Tr Key='Sklep'}" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr Key='Przeglądaj katalog'}" FontSize="12" Opacity="0.65"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="quick" Click="OpenLibrary_OnClick">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <ui:FASymbolIcon Symbol="Library" FontSize="20"/>
              <StackPanel>
                <TextBlock Text="{loc:Tr Key='Biblioteka'}" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr Key='Twoje gry'}" FontSize="12" Opacity="0.65"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="quick" Click="OpenFriends_OnClick">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <ui:FASymbolIcon Symbol="People" FontSize="20"/>
              <StackPanel>
                <TextBlock Text="{loc:Tr Key='Znajomi'}" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr Key='Panel społecznościowy'}" FontSize="12" Opacity="0.65"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Classes="quick" Click="OpenPublish_OnClick"
                  IsVisible="{Binding CanPublish}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <ui:FASymbolIcon Symbol="Upload" FontSize="20"/>
              <StackPanel>
                <TextBlock Text="{loc:Tr Key='Panel twórcy'}" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr Key='Twoje gry i wydania'}" FontSize="12" Opacity="0.65"/>
              </StackPanel>
            </StackPanel>
          </Button>
        </Grid>

        <StackPanel Spacing="12" IsVisible="{Binding HasContinue}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Tr Key='Kontynuuj'}" FontSize="20" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="{loc:Tr Key='Biblioteka'}" Classes="subtle" Padding="8,4"
                    Click="OpenLibrary_OnClick"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ContinuePlaying}"
                          ItemTemplate="{StaticResource PosterTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="12"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding HasReadyToInstall}">
          <TextBlock Text="{loc:Tr Key='Gotowe do instalacji'}" FontSize="20" FontWeight="SemiBold"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ReadyToInstall}"
                          ItemTemplate="{StaticResource PosterTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="12"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding HasFeatured}">
          <TextBlock Text="{loc:Tr Key='Wyróżnione'}" FontSize="20" FontWeight="SemiBold"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Featured}"
                          ItemTemplate="{StaticResource WideCardTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="12"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding HasCategories}">
          <TextBlock Text="{loc:Tr Key='Kategorie'}" FontSize="20" FontWeight="SemiBold"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="12"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HomeCategoryItem">
                  <Border Classes="home-card" Width="196" Height="88" CornerRadius="8" Padding="16,12"
                          Background="{DynamicResource ControlFillColorDefaultBrush}"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          BorderThickness="1" Cursor="Hand" Tag="{Binding}"
                          PointerPressed="Category_OnPointerPressed">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center"
                              Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CountText}" FontSize="12" Opacity="0.65"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding HasCatalog}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Tr Key='Nowe w sklepie'}" FontSize="20" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="{loc:Tr Key='Sklep'}" Classes="subtle" Padding="8,4"
                    Click="OpenStore_OnClick"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Catalog}"
                          ItemTemplate="{StaticResource WideCardTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="12"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <StackPanel Spacing="12" MaxWidth="480" HorizontalAlignment="Left" IsVisible="{Binding ShowEmpty}">
          <TextBlock Text="{loc:Tr Key='Nic tu jeszcze nie ma'}" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Tr Key='Wyróżnione gry pojawią się tutaj, gdy sklep będzie dostępny.'}"
                     Opacity="0.7" TextWrapping="Wrap"/>
          <Button Content="{loc:Tr Key='Przeglądaj sklep'}" Classes="accent" Padding="16,8"
                  HorizontalAlignment="Left" Click="OpenStore_OnClick"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                 IsVisible="{Binding IsBusy}"/>
  </Panel>
</UserControl>
