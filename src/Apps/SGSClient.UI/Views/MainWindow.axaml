<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SGSClient.UI.ViewModels"
        xmlns:views="using:SGSClient.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="SGSClient.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="700"
        Title="SGSClient">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Grid ColumnDefinitions="Auto,*">
    <views:ShellSidebar x:Name="Sidebar" Grid.Column="0"
                        DataContext="{Binding Sidebar}" />
    <Grid Grid.Column="1">
      <ContentControl Content="{Binding CurrentPage}" Margin="0"/>
      <Border IsVisible="{Binding IsSocialOpen}"
              Width="360"
              HorizontalAlignment="Right"
              Margin="0,12,12,12"
              CornerRadius="8"
              ClipToBounds="True"
              Background="{DynamicResource LayerFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              BoxShadow="0 8 24 0 #40000000">
        <views:FriendsView DataContext="{Binding Friends}"/>
      </Border>
    </Grid>
  </Grid>
</Window>
