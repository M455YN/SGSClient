<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SGSClient.UI.ViewModels"
        xmlns:views="using:SGSClient.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="SGSClient.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="700"
        Title="SGSClient">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Grid ColumnDefinitions="Auto,*">
    <views:ShellSidebar x:Name="Sidebar" Grid.Column="0"
                        DataContext="{Binding Sidebar}" />
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="0"/>
  </Grid>
</Window>
